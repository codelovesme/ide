#!/bin/sh
# ide — the codelovesme IDE.
#
#   ide [folder]      open a folder (default: the one you are in)
#
# Starts the ide program from its own folder, where its organelles sit —
# it links them from there while it runs — and tells it which folder to
# open.
set -e
here=$(dirname "$(readlink -f "$0")")
case "${1:-}" in
  --version|-V) echo "ide $(cat "$here/VERSION" 2>/dev/null || echo dev)"; exit 0 ;;
  --help|-h) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
folder=${1:-.}
[ -d "$folder" ] || { echo "ide: not a folder: $folder" >&2; exit 1; }
IDE_FOLDER=$(cd "$folder" && pwd)
export IDE_FOLDER
cd "$here"
exec ./ide-bin
