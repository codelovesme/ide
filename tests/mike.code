link "../src/chatbox.gene.code"
link "../src/context.gene.code"
link "../src/editor.gene.code"
link "../src/ide.gene.code"
link "../src/keys.gene.code"
link "../src/layout.gene.code"
link "../src/llm.gene.code"
link "../src/menu.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"
link "../src/tabs.gene.code"
link "../src/tree.gene.code"

emit UseOrganelles { from = "organelles" } to this get lib
fs_lib = lib.fs
process_lib = lib.process
strings_lib = lib.strings
prefs_lib = lib.prefs
json_lib = lib.json
emit Config { base_path = ".test-mike" } to fs_lib get area
emit WriteFile { path = "a.code", content = "disk\n" } to fs_lib
emit SettingsAt { dir = ".test-mike-config" } to this
emit OpenFolder { path = area.base_path } to this
emit Run { command = "pwd", args = [] } to process_lib get cwd
emit Trim { value = cwd.stdout } to strings_lib get root
emit StoreSetting { key = "ai.providers", value = { mike = { type = "mike", bridge = root.value + "/tests/fake-mike.py" } } } to this
emit StoreSetting { key = "ai.provider", value = "mike" } to this
emit StoreSetting { key = "ai.agent.mode", value = "edit" } to this
emit OpenFile { path = "a.code" } to this
emit EditorKey { name = "u", text = "u" } to this
emit AskAbout { question = "use my unsaved buffer" } to this get started
assert started ∈ Asked
emit Run { command = "sleep", args = ["0.2"] } to process_lib
emit MikeProgress to this
emit MikeRead { path = "a.code" } to this get unsaved
assert unsaved.state = "read" and unsaved.unsaved
assert unsaved.content = "udisk\n"

| Structured questions use the normal status prompt; Enter is not approval.
emit ReadFile { path = "runs/1-mike-events.jsonl" } to prefs_lib get old_events
emit WriteFile { path = "runs/1-mike-events.jsonl", content = old_events.content + "{\"kind\":\"progress\",\"view\":{\"turn_id\":\"fixture-turn\",\"stage\":\"confirm\",\"steps\":[],\"say\":\"Continue this operation?\",\"confirmation_id\":\"question-version-1\",\"editor_request\":null}}\n" } to prefs_lib
emit AgentProgress to this
emit Run { command = "file.openFolder" } to this
emit RestoreMikeQuestion to this
emit State to this get unrelated_prompt
assert unrelated_prompt.prompt.kind = "open_folder"
emit PromptKey { name = "escape", text = "" } to this
emit RestoreMikeQuestion to this
emit PromptKey { name = "enter", text = "" } to this get no_enter
assert no_enter ∈ Typed
emit PromptKey { name = "y", text = "y" } to this
emit ReadFile { path = "runs/1-mike-reply.json" } to prefs_lib get reply
emit Parse { text = reply.content } to json_lib get decision
assert decision.value.kind = "confirm" and decision.value.id = "question-version-1" and decision.value.yes
emit MikeAnswer { id = "old-question", yes = true, local = false } to this get stale
assert stale ∈ Ignored

| Read again from a hidden file pane; disk must not replace unsaved content.
emit HidePane { kind = "file" } to this
emit MikeRead { path = "a.code" } to this get hidden
assert hidden.content = unsaved.content
emit RestorePane { kind = "file" } to this

| Edit proposal uses current buffer; racing user input invalidates it.
emit MikeEdit { args = { path = "a.code", revision = hidden.revision, content = "changed\n", save = true } } to this get proposed
assert proposed ∈ Waiting
emit OpenFile { path = "a.code" } to this
emit EditorKey { name = "x", text = "x" } to this
emit FindView { groups = [], path = "", store = "" } to this
| Re-show its existing proposal so normal acceptance uses the new buffer.
emit State to this get state
emit FindView { groups = state.groups, path = "a.code ±", store = "ai" } to this get diff
emit Reveal { group = diff.group, tab = diff.tab } to this
emit DecideChange { accepted = true } to this get refused
assert refused ∈ Failed
emit FileLines { path = "a.code" } to this get retained
assert retained.lines[0] = "uxdisk"
emit ReadFile { path = "a.code" } to fs_lib get disk
assert disk.content = "disk\n"

| New revision, accepted buffer-only edit and native undo.
emit MikeRead { path = "a.code" } to this get fresh
emit MikeEdit { args = { path = "a.code", revision = fresh.revision, content = "buffer only\n", save = false } } to this get proposal
assert proposal ∈ Waiting
emit DecideChange { accepted = true } to this get accepted
assert accepted ∈ Accepted
emit FileLines { path = "a.code" } to this get changed
assert changed.lines[0] = "buffer only"
emit ReadFile { path = "a.code" } to fs_lib get still_disk
assert still_disk.content = "disk\n"
emit Undo to this
emit FileLines { path = "a.code" } to this get undone
assert undone.lines[0] = "uxdisk"

| External disk writes while dirty cannot be silently saved over.
emit WriteFile { path = "a.code", content = "external\n" } to fs_lib
emit MikeRead { path = "a.code" } to this get external
assert external.disk_changed_since_open
emit MikeEdit { args = { path = "a.code", revision = external.revision, content = "overwrite\n", save = true } } to this
emit DecideChange { accepted = true } to this get conflict
assert conflict ∈ Failed
emit ReadFile { path = "a.code" } to fs_lib get preserved
assert preserved.content = "external\n"

| Explicitly reconcile as the user, then a saved edit reports actual disk.
emit OpenFile { path = "a.code" } to this
emit SaveFile to this
emit MikeRead { path = "a.code" } to this get save_revision
emit MikeEdit { args = { path = "a.code", revision = save_revision.revision, content = "saved result\n", save = true } } to this
emit DecideChange { accepted = true } to this get saved_edit
assert saved_edit ∈ Accepted
emit ReadFile { path = "a.code" } to fs_lib get saved_disk
assert saved_disk.content = "saved result\n"
emit Undo to this
emit FileLines { path = "a.code" } to this get saved_undone
assert saved_undone.lines[0] = "uxdisk"

| Provider/mode switch cannot apply an old revision or keep capabilities.
emit StoreSetting { key = "ai.agent.mode", value = "ask" } to this
emit MikeProgress to this
emit MikeEdit { args = { path = "a.code", revision = fresh.revision, content = "forbidden", save = false } } to this get readonly
assert readonly.state = "refused"
emit CloseMikeChats to this
emit State to this get closed
assert not closed.chat.busy

| Auto applies the same revision fence; a duplicate edit cannot run twice.
emit StoreSetting { key = "ai.agent.mode", value = "auto" } to this
emit AskAbout { question = "auto buffer edit" } to this
emit Run { command = "sleep", args = ["0.2"] } to process_lib
emit MikeProgress to this
emit MikeRead { path = "a.code" } to this get auto_revision
emit MikeEdit { args = { path = "a.code", revision = auto_revision.revision, content = "auto result\n", save = false } } to this get automatic
assert automatic.state = "buffer_only"
emit MikeEdit { args = { path = "a.code", revision = auto_revision.revision, content = "auto result\n", save = false } } to this get repeated
assert repeated.state = "conflict"
emit ReadFile { path = "a.code" } to fs_lib get auto_disk
assert auto_disk.content = "saved result\n"
| An account-generation error clears the old private conversation immediately.
emit ReadFile { path = "runs/1-mike-events.jsonl" } to prefs_lib get account_events
emit WriteFile { path = "runs/1-mike-events.jsonl", content = account_events.content + "{\"kind\":\"error\",\"text\":\"account changed\",\"reset\":true}\n" } to prefs_lib
emit AgentProgress to this
emit State to this get reset
emit Length { value = reset.chat.turns } to core get reset_turns
assert reset_turns.value = 1
assert reset.chat.turns[0].role = "error" and reset.chat.messages = []
emit CloseMikeChats to this
emit Run { command = "rm", args = ["-rf", root.value + "/.test-mike", root.value + "/.test-mike-config"] } to process_lib
