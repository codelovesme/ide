link "../src/chatbox.gene.code"
link "../src/context.gene.code"
link "../src/editor.gene.code"
link "../src/ide.gene.code"
link "../src/keys.gene.code"
link "../src/layout.gene.code"
link "../src/llm.gene.code"
link "../src/menu.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"
link "../src/tabs.gene.code"
link "../src/tree.gene.code"

emit UseOrganelles { from = "organelles" } to this get lib
fs_lib = lib.fs
process_lib = lib.process
strings_lib = lib.strings
prefs_lib = lib.prefs
json_lib = lib.json
emit Config { base_path = ".test-account" } to fs_lib get area
emit WriteFile { path = "a.code", content = "disk\n" } to fs_lib
emit SettingsAt { dir = ".test-account-config" } to this
emit OpenFolder { path = area.base_path } to this
emit Run { command = "pwd", args = [] } to process_lib get cwd
emit Trim { value = cwd.stdout } to strings_lib get root
emit StoreSetting { key = "ai.providers", value = { mike = { type = "mike", bridge = root.value + "/tests/fake-mike.py" } } } to this
emit StoreSetting { key = "ai.provider", value = "mike" } to this
emit OpenFile { path = "a.code" } to this
emit EditorKey { name = "u", text = "u" } to this

| Signed out: the provider check says so; Claude/Codex/local paths are untouched.
emit ProviderCheck { provider = { name = "mike", type = "mike", runner = "mike", title = "Mike", problem = "" } } to this get before
assert not before.ready and before.note = "Signed out of IDE"

| Sign in: a hidden handoff process; running it again while it waits cancels.
emit Run { command = "account.signIn" } to this
emit State to this get waiting
assert waiting.message = "Finish signing in to codelovesme in your browser (Account: Sign In again cancels)"
emit Run { command = "account.signIn" } to this
emit State to this get cancelled
assert cancelled.message = "Sign-in cancelled; nothing changed"
emit Run { command = "account.signIn" } to this
emit Run { command = "sleep", args = ["0.5"] } to process_lib
emit State to this get signed
assert signed.message = "Signed in as fixture@example.invalid"
emit ReadFile { path = "account.json" } to prefs_lib get stored
emit Parse { text = stored.content } to json_lib get stored_value
assert stored_value.value = { account = "fixture@example.invalid" }
emit ProviderCheck { provider = { name = "mike", type = "mike", runner = "mike", title = "Mike", problem = "" } } to this get after
assert after.ready and after.note = "ready · fixture@example.invalid"

| A Mike turn in flight ends on sign-out; the unsaved buffer stays.
emit AskAbout { question = "hello" } to this get started
assert started ∈ Asked
emit Run { command = "account.signOut" } to this
emit State to this get out
assert out.message = "Signed out of IDE. The shared Mike service and other apps stay signed in."
assert out.chat.agent = null
emit ReadFile { path = "account.json" } to prefs_lib get gone
assert gone ∈ Exception
emit MikeBuffer { path = "a.code" } to this get kept_buffer
assert kept_buffer.buffer.lines = ["udisk", ""] and kept_buffer.buffer.dirty = true

| The explicit shared-service switch is its own command.
emit Run { command = "account.switchService" } to this
emit Run { command = "sleep", args = ["0.5"] } to process_lib
emit State to this get switched
assert switched.message = "Signed in as switched@example.invalid"
emit Run { command = "rm", args = ["-rf", root.value + "/.test-account", root.value + "/.test-account-config"] } to process_lib
