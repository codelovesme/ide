| The chat's pure pieces: the input box, the model's replies read, the
| @ words, text wrapped; and the provider picked from settings.

link "../src/chatbox.gene.code"
link "../src/llm.gene.code"
link "../src/ide.gene.code"
link "../src/editor.gene.code"
link "../src/keys.gene.code"
link "../src/layout.gene.code"
link "../src/menu.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"
link "../src/tabs.gene.code"
link "../src/tree.gene.code"
link "../src/context.gene.code"

emit UseOrganelles { from = "organelles" } to this get lib
assert lib ∈ Linked

| The input box.
emit ChatInput { caret = null, input = "wh", name = "y", text = "y", page = 10 } to this get typed
assert typed.input = "why" and typed.send = null
emit ChatInput { caret = null, input = "why", name = "alt+enter", text = "", page = 10 } to this get two_lines
assert two_lines.input = "why\n"
emit ChatInput { caret = null, input = "  why  ", name = "enter", text = "", page = 10 } to this get sent
assert sent.send = "why" and sent.input = ""
emit ChatInput { caret = null, input = "   ", name = "enter", text = "", page = 10 } to this get empty
assert empty.send = null
emit ChatInput { caret = null, input = "", name = "pageup", text = "", page = 10 } to this get up
assert up.scroll = 10
emit ChatInput { caret = null, input = "", name = "ctrl+up", text = "", page = 10 } to this get line_up
assert line_up.scroll = 1
emit ChatInput { caret = null, input = "", name = "ctrl+down", text = "", page = 10 } to this get line_down
assert line_down.scroll = -1
| The cursor: typed at, deleted before, moved; ↑ on the first line and ↓
| on the last are the history's.
emit ChatInput { input = "ac", caret = 1, name = "b", text = "b", page = 10 } to this get typed_at
assert typed_at.input = "abc" and typed_at.caret = 2
emit ChatInput { input = "abc", caret = 1, name = "backspace", text = "", page = 10 } to this get deleted_at
assert deleted_at.input = "bc" and deleted_at.caret = 0
emit ChatInput { input = "abc", caret = 1, name = "delete", text = "", page = 10 } to this get deleted_after
assert deleted_after.input = "ac" and deleted_after.caret = 1
emit ChatInput { input = "abc", caret = null, name = "left", text = "", page = 10 } to this get went_left
assert went_left.caret = 2
emit ChatInput { input = "ab\ncdef", caret = 6, name = "up", text = "", page = 10 } to this get went_up
assert went_up.caret = 2 and not went_up.edge
emit ChatInput { input = "ab\ncdef", caret = 1, name = "down", text = "", page = 10 } to this get went_down
assert went_down.caret = 4
emit ChatInput { input = "ab\ncdef", caret = 1, name = "up", text = "", page = 10 } to this get top_edge
assert top_edge.edge
emit ChatInput { input = "ab\ncdef", caret = 5, name = "home", text = "", page = 10 } to this get went_home
assert went_home.caret = 3
emit InputLines { text = "abcde\nf", caret = 4, width = 3 } to this get shaped
assert shaped.lines = ["abc", "de", "f"] and shaped.caret_line = 1 and shaped.caret_col = 1
| ↑/↓: back through what was asked, then forward to the draft.
emit Recall { history = ["one", "two"], at = 2, input = "thr", draft = "", step = -1 } to this get recall_two
assert recall_two.input = "two" and recall_two.at = 1 and recall_two.draft = "thr"
emit Recall { history = ["one", "two"], at = 1, input = "two", draft = "thr", step = -1 } to this get recall_one
assert recall_one.input = "one" and recall_one.at = 0
emit Recall { history = ["one", "two"], at = 0, input = "one", draft = "thr", step = -1 } to this get recall_first
assert recall_first.input = "one" and recall_first.at = 0
emit Recall { history = ["one", "two"], at = 1, input = "two", draft = "thr", step = 1 } to this get recall_draft
assert recall_draft.input = "thr" and recall_draft.at = 2
emit Recall { history = ["one", "two"], at = 2, input = "thr", draft = "", step = 1 } to this get recall_past
assert recall_past.input = "thr" and recall_past.at = 2
emit Recall { history = [], at = 0, input = "", draft = "", step = -1 } to this get recall_none
assert recall_none.input = ""

| Replies: a tool, an answer, JSON in a fence, and plain words.
emit ReadReply { content = "{\"tool\": \"read_file\", \"args\": {\"path\": \"a.code\", \"from\": 1, \"to\": 20}}" } to this get tool
assert tool.tool = "read_file" and tool.args.path = "a.code"
emit ReadReply { content = "Sure.\n```json\n{\"answer\": \"It moves the tab.\"}\n```" } to this get fenced
assert fenced.tool = null and fenced.answer = "It moves the tab."
emit ReadReply { content = "  It moves {the} tab.  " } to this get plain
assert plain.answer = "It moves {the} tab."
emit ToolLine { tool = "read_file", args = tool.args } to this get line
assert line.text = "read a.code 1–20"

| @ words.
emit Mentions { input = "why does @terminal fail? see @src/a.code, and @git." } to this get mentioned
assert mentioned.mentions = ["terminal", "src/a.code", "git"]

| Wrapping.
emit Wrap { text = "one two three four", width = 9 } to this get wrapped
assert wrapped.lines = ["one two", "three", "four"]
emit Wrap { text = "abcdefghij\nx", width = 4 } to this get cut
assert cut.lines = ["abcd", "efgh", "ij", "x"]

| The provider: none set up, then a local one.
emit ProviderFor { settings = { "ai.provider" = "local", "ai.providers" = { local = { type = "openai-compatible", endpoint = "" } } } } to this get unset
assert unset.problem ≠ ""
emit ProviderFor { settings = { "ai.provider" = "local", "ai.providers" = { local = { endpoint = "http://localhost:8080", model = "qwen", apiKeyEnv = "KEY" } } } } to this get local
assert local.problem = "" and local.organelle = "localai" and local.model = "qwen" and local.context_tokens = 32768
assert local.runner = "api" and local.update_url = null
emit ProviderFor { settings = { "ai.provider" = "claude", "ai.providers" = { claude = { type = "claude-code" } } } } to this get claude_cli
assert claude_cli.update_url = "https://registry.npmjs.org/%40anthropic-ai%2Fclaude-code/latest" and claude_cli.version_word = 0
emit ProviderFor { settings = { "ai.provider" = "codex", "ai.providers" = { codex = { type = "codex" } } } } to this get codex_cli
assert codex_cli.update_url = "https://registry.npmjs.org/%40openai%2Fcodex/latest" and codex_cli.version_word = 1
emit VersionNewer { installed = "0.156.1", latest = "0.157.1" } to this get codex_update
emit VersionNewer { installed = "2.1.283", latest = "2.1.283" } to this get same_claude
emit VersionNewer { installed = "2.1.283", latest = "2.1.282" } to this get older_release
assert codex_update ∈ Yes and same_claude ∈ No and older_release ∈ No
emit ProviderFor { settings = { "ai.provider" = "cloud", "ai.providers" = { cloud = { type = "carrier-pigeon", endpoint = "x" } } } } to this get unknown
assert unknown.problem ≠ ""
emit ProviderConfig { provider = local, api_key = "k" } to this get config
assert config.particle ∈ Config and config.particle.api_key = "k" and config.particle.model = "qwen"

| The project map: files, each with the names it defines.
emit RepoMap { files = "a.code\nb.md", outline = "a.code:2:Greet { who } =>\na.code:9:Part =>", chars = 1000 } to this get map
assert map.text = "a.code\n    2: Greet { who } =>\n    9: Part =>\nb.md"

| Edits: the text found once, and the lines that changed.
emit Occurrences { text = "a b a", part = "a" } to this get twice
assert twice.count = 2 and twice.at = 0
emit Occurrences { text = "Greet { who } =>", part = "{ who }" } to this get once
assert once.count = 1 and once.at = 6
emit Occurrences { text = "abc", part = "x" } to this get none
assert none.count = 0
emit DiffLines { old = ["a", "b", "c", "d"], new = ["a", "B", "B2", "c", "d"], around = 1 } to this get diff
assert diff.removed = 1 and diff.added = 2
assert diff.lines = [
    { sign = " ", text = "a", line = 1 }
    { sign = "-", text = "b", line = 2 }
    { sign = "+", text = "B", line = 2 }
    { sign = "+", text = "B2", line = 3 }
    { sign = " ", text = "c", line = 4 }
]
emit LastLines { text = "1\n2\n3", count = 2 } to this get tail_lines
assert tail_lines.text = "(1 lines before)…\n2\n3"
