| The ide gene driven the way keys drive it, without a terminal of its
| own: a folder opened, the explorer as a tab, the tree walked, files
| opened in tabs, edited, undone, saved; tabs moved anywhere; a terminal;
| the menu, the prompts, settings and keybindings; frames drawn from it all.

link "../src/chatbox.gene.code"
link "../src/context.gene.code"
link "../src/editor.gene.code"
link "../src/ide.gene.code"
link "../src/keys.gene.code"
link "../src/layout.gene.code"
link "../src/llm.gene.code"
link "../src/menu.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"
link "../src/tabs.gene.code"
link "../src/tree.gene.code"

| A frame, the way Render makes one.
Framed {} =>
    emit State to this get state
    emit Placement { state = state } to this get placement
    emit Frame { state = state, placement = placement, screens = {} } to this get screen
    return screen

| The texts of every overlay on screen row `row`, left to right as drawn.
RowTexts { screen, row } =>
    texts = []
    loop o over screen.overlays
        if o.row = row
            loop span over o.spans
                if span.text ≠ "", texts += span.text
    return Texts { texts = texts }

| Whether `part` is somewhere in `text`.
Contains { text, part } =>
    emit Length { value = text } to core get { value as size }
    emit Length { value = part } to core get { value as want }
    i = 0
    loop
        if i + want > size, break
        if text[i, i + want) = part, return Is { yes = true }
        i += 1
    return Is { yes = false }

| The slot each group is in, and the kind of its active tab.
WhereNow {} =>
    emit State to this get state
    out = []
    loop group over state.groups
        out += group.slot + ":" + group.tabs[group.active].kind
    return Where { groups = out }

| The organelles, linked the way the ide links them (tools/organelles.sh
| lays them out first).
emit UseOrganelles { from = "organelles" } to this get lib
assert lib ∈ Linked
files = lib.fs
prefs_fs = lib.prefs
json_lib = lib.json
shells = lib.pty
strings_lib = lib.strings
procs_lib = lib.process

| Settings kept where the tests run, starting from none.
emit Config { base_path = ".test-config" } to prefs_fs
emit DeleteFile { path = "settings.json" } to prefs_fs
emit DeleteFile { path = "keybindings.json" } to prefs_fs
emit SettingsAt { dir = ".test-config" } to this get first_settings
assert first_settings.values["workbench.layout.left"] = 30
assert first_settings.values["workbench.layout.bottom"] = 12
assert first_settings.values["workbench.sideBar.visible"]

| A folder to open: a code file, a folder with a file in it, and .git.
emit Config { base_path = ".test-folder" } to files get made
root = made.base_path
emit RemoveDir { path = "src" } to files
emit WriteFile { path = "hello.code", content = "| hi\nGreet { who } =>\n    return Hi\n" } to files
emit WriteFile { path = "src/notes.md", content = "notes" } to files
emit WriteFile { path = ".git/HEAD", content = "ref" } to files

emit OpenFolder { path = root } to this get opened
assert opened ∈ Opened
emit ShowExplorer { focused = true } to this
emit State to this get s
assert s.folder = root
assert s.tree = [
    { path = "src", name = "src", depth = 0, is_dir = true, open = false }
    { path = "hello.code", name = "hello.code", depth = 0, is_dir = false, open = false }
]
assert s.focus = "tree"
emit WhereNow to this get start
assert start.groups = ["l:explorer"]

| A folder that is not there is refused, and the one open stays open.
emit OpenFolder { path = root + "/nope" } to this get missing
assert missing ∈ Failed

| Enter on a folder opens it; left closes it again.
emit HandleKey { name = "enter", text = "" } to this
emit State to this get expanded
assert expanded.tree[0].open
emit HandleKey { name = "left", text = "" } to this

| Down to the code file, enter: it opens in the center, and has the keys.
emit HandleKey { name = "down", text = "" } to this
emit HandleKey { name = "enter", text = "" } to this
emit State to this get editing
assert editing.focus = "editor"
assert editing.file.path = "hello.code"
emit WhereNow to this get with_file
assert with_file.groups = ["l:explorer", "c:file"]

| Typing, undo, redo.
emit HandleKey { name = "x", text = "x" } to this
emit HandleKey { name = "y", text = "y" } to this
emit HandleKey { name = "ctrl+z", text = "" } to this
emit State to this get undone
assert undone.file.lines[0] = "| hi"
emit HandleKey { name = "ctrl+y", text = "" } to this
emit State to this get redone
assert redone.file.lines[0] = "xy| hi"

| Ctrl+E moves the keys to the explorer, where the arrows move the
| selection, not the cursor; F6 goes on to the file.
emit HandleKey { name = "ctrl+e", text = "" } to this
emit State to this get in_tree
assert in_tree.focus = "tree"
emit HandleKey { name = "up", text = "" } to this
emit State to this get moved_up
assert moved_up.tree_sel = 0
emit HandleKey { name = "f6", text = "" } to this
emit State to this get back
assert back.focus = "editor"
assert back.file.row = redone.file.row

| Save.
emit HandleKey { name = "ctrl+s", text = "" } to this
emit ReadFile { path = "hello.code" } to files get on_disk
assert on_disk.content = "xy| hi\nGreet { who } =>\n    return Hi\n"

| The frame at 80 columns: the explorer group 30 wide on the left, the
| file's group in the center with a line down its left edge; each has a
| tab strip; the cursor is in the file.
emit Framed to this get screen
emit RowTexts { screen = screen, row = 1 } to this get strips
assert strips.texts = [" Explorer ", "│", " hello.code "]
emit RowTexts { screen = screen, row = 2 } to this get second_row
assert second_row.texts[0] = " .TEST-FOLDER"
assert screen.cursor_row = 2
assert screen.cursor_col = 31 + 5 + 2
kinds = []
loop o over screen.overlays
    if o.row = 3 and o.col = 31
        loop span over o.spans
            kinds += span.style
assert kinds = ["line_number", "plain", "class", "plain", "variable", "plain", "operator", "plain"]

| Tabs: a second file opens beside the first; Ctrl+PgUp / PgDn switch;
| edits stay with their tab.
emit OpenFile { path = "src/notes.md" } to this
emit HandleKey { name = "q", text = "q" } to this
emit HandleKey { name = "ctrl+pageup", text = "" } to this
emit State to this get first_tab
assert first_tab.file.path = "hello.code"
emit HandleKey { name = "ctrl+pagedown", text = "" } to this
emit State to this get second_tab
assert second_tab.file.lines[0] = "qnotes"
emit Framed to this get tabbed
emit RowTexts { screen = tabbed, row = 1 } to this get tab_strip
assert tab_strip.texts = [" Explorer ", "│", " hello.code ", " notes.md ● "]

| Move Tab: the file to the right — its own group there — then the
| explorer into the center as a tab beside the other file.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "m", text = "m" } to this
emit State to this get asking_where
assert asking_where.prompt.kind = "move"
emit HandleKey { name = "r", text = "r" } to this
emit HandleKey { name = "enter", text = "" } to this
emit WhereNow to this get moved_right
assert moved_right.groups = ["l:explorer", "c:file", "r:file"]
emit State to this get after_move
assert after_move.file.path = "src/notes.md"
emit HandleKey { name = "ctrl+e", text = "" } to this
emit Run { command = "view.moveTab.c" } to this
emit WhereNow to this get explorer_center
assert explorer_center.groups = ["c:explorer", "r:file"]
emit State to this get as_tab
emit Length { value = as_tab.groups[0].tabs } to core get { value as center_tabs }
assert center_tabs = 2
assert as_tab.focus = "tree"
| And back to the left.
emit Run { command = "view.explorerLeft" } to this
emit WhereNow to this get explorer_left
assert explorer_left.groups = ["c:file", "r:file", "l:explorer"]
| A place that is not one is refused.
emit MoveCurrent { into = "middle" } to this get nowhere
assert nowhere ∈ Failed

| Resizing: with the explorer focused, Ctrl+K → widens the left.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "right", text = "" } to this
emit State to this get wider
assert wider.sizes.left = 32
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "left", text = "" } to this
emit State to this get narrower
assert narrower.sizes.left = 30

| Ctrl+B hides the explorer (settings.json says so) and shows it again.
emit HandleKey { name = "ctrl+b", text = "" } to this
emit WhereNow to this get hidden
assert hidden.groups = ["c:file", "r:file"]
emit ReadFile { path = "settings.json" } to prefs_fs get stored
emit Parse { text = stored.content } to json_lib get stored_values
assert stored_values.value["workbench.sideBar.visible"] = false
emit HandleKey { name = "ctrl+b", text = "" } to this
emit WhereNow to this get shown_again
assert shown_again.groups = ["c:file", "r:file", "l:explorer"]

| A terminal: Ctrl+` opens one at the bottom, with the keys. Keys go to
| the shell — except the few commands that skip it (F6 here).
emit HandleKey { name = "ctrl+`", text = "" } to this
emit WhereNow to this get with_terminal
assert with_terminal.groups = ["c:file", "r:file", "l:explorer", "b:terminal"]
emit State to this get in_terminal
assert in_terminal.focus = "terminal"
terminal_id = in_terminal.groups[3].tabs[0].id
emit HandleKey { name = "ctrl+e", text = "" } to this
emit State to this get still_terminal
assert still_terminal.focus = "terminal"
emit HandleKey { name = "f6", text = "" } to this
emit State to this get left_terminal
assert left_terminal.focus ≠ "terminal"
| Ctrl+` again gives the keys back to the terminal.
emit HandleKey { name = "ctrl+`", text = "" } to this
emit State to this get back_in_terminal
assert back_in_terminal.focus = "terminal"
| Moved into the center, as a tab beside the files.
emit Run { command = "view.moveTab.c" } to this
emit WhereNow to this get terminal_center
assert terminal_center.groups = ["c:terminal", "r:file", "l:explorer"]
| A terminal whose shell ended closes its tab.
emit TerminalExited { id = terminal_id, code = 0 } to this
emit WhereNow to this get terminal_gone
assert terminal_gone.groups = ["c:file", "r:file", "l:explorer"]
emit Close { id = terminal_id } to shells

| Closing: an edited file asks; n closes it unsaved.
emit FocusSlot { slot = "r" } to this
emit HandleKey { name = "ctrl+w", text = "" } to this
emit State to this get asked
assert asked.prompt.kind = "close"
emit HandleKey { name = "n", text = "n" } to this
emit WhereNow to this get right_closed
assert right_closed.groups = ["c:file", "l:explorer"]

| Quitting with an unsaved file asks; Escape keeps it.
emit FocusSlot { slot = "c" } to this
emit HandleKey { name = "z", text = "z" } to this
emit HandleKey { name = "ctrl+q", text = "" } to this
emit State to this get quitting
assert quitting.prompt.label = "Save changes to hello.code before exit? (y / n / Escape) "
emit HandleKey { name = "escape", text = "" } to this
emit HandleKey { name = "ctrl+z", text = "" } to this

| The shortcuts open read-only, in the files' place.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get help
assert help.file.readonly
assert help.file.lines[0] = "Keyboard Shortcuts"
emit HandleKey { name = "q", text = "q" } to this
emit State to this get refused
assert refused.message = "This file is read-only."
emit HandleKey { name = "ctrl+w", text = "" } to this

| Ctrl+K Ctrl+O asks for a folder; Escape drops it.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "ctrl+o", text = "" } to this
emit State to this get asking
assert asking.prompt.text = root + "/"
emit HandleKey { name = "escape", text = "" } to this

| The menus: File, View, Settings, Help. Alt+S opens Settings; Enter on
| its first item opens settings.json; arrows wrap round all four.
emit Framed to this get bar
emit RowTexts { screen = bar, row = 0 } to this get bar_texts
assert bar_texts.texts[1] = " File " and bar_texts.texts[3] = " Settings " and bar_texts.texts[4] = " Help "
emit HandleKey { name = "alt+s", text = "" } to this
emit State to this get settings_menu
assert settings_menu.menu.index = 2
emit HandleKey { name = "right", text = "" } to this
emit HandleKey { name = "right", text = "" } to this
emit State to this get wrapped
assert wrapped.menu.index = 0
emit HandleKey { name = "left", text = "" } to this
emit HandleKey { name = "left", text = "" } to this
emit HandleKey { name = "enter", text = "" } to this
emit State to this get from_menu
assert from_menu.menu = null
assert from_menu.file.path = "settings.json"
emit HandleKey { name = "ctrl+w", text = "" } to this

| Ctrl+, opens settings.json; saving an edit to it applies it.
emit HandleKey { name = "ctrl+,", text = "" } to this
emit State to this get editing_settings
assert editing_settings.file.path = "settings.json"
emit SetLines { lines = ["{", "  \"workbench.layout.left\": 40,", "  \"workbench.sideBar.width\": 99", "}", ""] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get applied
assert applied.sizes.left = 40
assert applied.message = "Settings saved and applied"
| The name before 0.6 is still read when the new one is absent.
emit SetLines { lines = ["{ \"workbench.sideBar.width\": 44 }"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get old_name
assert old_name.sizes.left = 44
emit SetLines { lines = ["{ \"workbench.layout.left\": \"wide\" }"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get fell_back
assert fell_back.sizes.left = 30
assert fell_back.message = "Error: settings.json: using the default for workbench.layout.left (10 or more)"

| keybindings.json: an entry's key runs its command once saved.
emit Run { command = "keybindings.open" } to this
emit State to this get bindings_open
assert bindings_open.file.path = "keybindings.json"
emit SetLines { lines = ["[", "  { \"key\": \"ctrl+g\", \"command\": \"view.explorer\" }", "]"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get bindings_saved
assert bindings_saved.message = "Keyboard shortcuts saved and applied"
emit WhereNow to this get before_g
emit HandleKey { name = "ctrl+g", text = "" } to this
emit WhereNow to this get after_g
assert after_g.groups ≠ before_g.groups

| The AI chat: Ctrl+L opens it on the right, with the keys.
emit HandleKey { name = "ctrl+g", text = "" } to this
emit OpenFile { path = "hello.code" } to this
emit HandleKey { name = "down", text = "" } to this
emit HandleKey { name = "ctrl+l", text = "" } to this
emit WhereNow to this get with_chat
emit State to this get chatting
assert chatting.focus = "chat"
assert with_chat.groups[chatting.current] = "r:chat"
| With no model set up, asking says how to set one up.
emit HandleKey { name = "h", text = "h" } to this
emit HandleKey { name = "i", text = "i" } to this
emit State to this get typed_hi
assert typed_hi.chat.input = "hi"
emit HandleKey { name = "enter", text = "" } to this
emit State to this get unset
assert unset.chat.turns[0].text = "hi"
assert unset.chat.turns[1].role = "error"
assert unset.chat.input = ""
emit Framed to this get unset_frame
assert unset_frame ∈ Screen

| A model set up (settings.json), and the project's own instructions.
emit WriteFile { path = "AGENTS.md", content = "Indent with four spaces." } to files
| The model: a port that takes the request and never answers, so the
| replies below are the only ones that come.
emit Spawn { id = "silent-model", command = "python3", args = ["-c", "import socket, time\ns = socket.socket()\ns.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\ns.bind(('127.0.0.1', 47811))\ns.listen(8)\ntime.sleep(120)"] } to procs_lib
emit Run { command = "sleep", args = ["0.5"] } to procs_lib
emit StoreSetting { key = "ai.providers", value = { local = { endpoint = "http://127.0.0.1:47811", model = "test-model" } } } to this
emit Run { command = "ai.newChat" } to this
emit State to this get new_chat
assert new_chat.chat.turns = []
emit AskAbout { question = "what does this do? see @hello.code" } to this
emit State to this get question_state
assert question_state.chat.busy
first_request = question_state.chat.request
first_content = question_state.chat.messages[0].content
assert question_state.chat.system ≠ ""
| The system message has the instructions and the map; the question what
| was on screen, and the file it mentions.
emit Contains { text = question_state.chat.system, part = "Indent with four spaces." } to this get by_instructions
assert by_instructions.yes
emit Contains { text = question_state.chat.system, part = "Greet { who } =>" } to this get by_map
assert by_map.yes
emit Contains { text = first_content, part = "Open file: hello.code" } to this get by_file
assert by_file.yes
emit Contains { text = first_content, part = "# Attached: @hello.code" } to this get by_mention
assert by_mention.yes

| The model asks to search; the search runs and goes back to it.
emit ChatResult { content = "{\"tool\": \"grep\", \"args\": {\"pattern\": \"Greet\"}}", _request_id = first_request } to this
emit State to this get stepped
assert stepped.chat.turns[1].role = "tool"
assert stepped.chat.turns[1].text = "searched for \"Greet\""
assert stepped.chat.busy and stepped.chat.request ≠ first_request
emit Length { value = stepped.chat.messages } to core get { value as sent_count }
result_note = stepped.chat.messages[sent_count - 1].content
emit Contains { text = result_note, part = "hello.code:2:Greet" } to this get by_match
assert by_match.yes
| A reply to an old question is ignored; the answer ends the turn.
emit ChatResult { content = "{\"answer\": \"stale\"}", _request_id = first_request } to this
emit ChatResult { content = "{\"answer\": \"It greets.\"}", _request_id = stepped.chat.request } to this
emit State to this get answered
assert not answered.chat.busy
assert answered.chat.turns[2].text = "It greets."
emit Length { value = answered.chat.turns } to core get { value as shown_turns }
assert shown_turns = 3
emit Framed to this get answered_frame
assert answered_frame ∈ Screen

| Tools stay inside the folder.
emit RunTool { tool = "read_file", args = { path = "../etc/passwd" } } to this get outside
assert outside.text = "Not allowed: paths stay inside the project folder."
emit RunTool { tool = "read_file", args = { path = "hello.code", from = 2, "to" = 2 } } to this get one_line
assert one_line.text = "hello.code (4 lines), lines 2–2:\n2| Greet { who } =>"

| Moved, the chat remembers where; Escape gives the keys back.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "m", text = "m" } to this
emit HandleKey { name = "b", text = "b" } to this
emit HandleKey { name = "enter", text = "" } to this
emit State to this get chat_settings
assert chat_settings.settings["ai.chat.location"] = "b"
emit HandleKey { name = "escape", text = "" } to this
emit State to this get back_to_files
assert back_to_files.focus ≠ "chat"
emit DeleteFile { path = "AGENTS.md" } to files
emit Kill { id = "silent-model" } to procs_lib

emit RemoveDir { path = "." } to prefs_fs
emit RemoveDir { path = "." } to files
