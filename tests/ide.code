| The ide gene driven the way keys drive it, without a terminal: a folder
| opened, the tree walked, a file opened, edited, undone, saved; the menu
| and a prompt; and a frame drawn from all of it.

link "../src/editor.gene.code"
link "../src/ide.gene.code"
link "../src/keys.gene.code"
link "../src/layout.gene.code"
link "../src/menu.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"
link "../src/tabs.gene.code"
link "../src/tree.gene.code"

| The organelles, linked the way the ide links them (tools/organelles.sh
| lays them out first).
emit UseOrganelles { from = "organelles" } to this get lib
assert lib ∈ Linked
files = lib.fs
prefs_fs = lib.prefs
json_lib = lib.json

| Settings kept where the tests run, starting from none.
emit Config { base_path = ".test-config" } to prefs_fs
emit DeleteFile { path = "settings.json" } to prefs_fs
emit DeleteFile { path = "keybindings.json" } to prefs_fs
emit SettingsAt { dir = ".test-config" } to this get first_settings
assert first_settings.values = {
    "workbench.sideBar.visible" = true
    "workbench.sideBar.location" = "left"
    "workbench.sideBar.width" = 30
    "workbench.panel.height" = 10
}

| A folder to open: a code file, a folder with a file in it, and .git.
| Made where the tests run; fs answers where that is, absolutely.
emit Config { base_path = ".test-folder" } to files get made
root = made.base_path
emit RemoveDir { path = "src" } to files
emit WriteFile { path = "hello.code", content = "| hi\nGreet { who } =>\n    return Hi\n" } to files
emit WriteFile { path = "src/notes.md", content = "notes" } to files
emit WriteFile { path = ".git/HEAD", content = "ref" } to files

emit OpenFolder { path = root } to this get opened
assert opened ∈ Opened
emit State to this get s
assert s.folder = root
assert s.tree = [
    { path = "src", name = "src", depth = 0, is_dir = true, open = false }
    { path = "hello.code", name = "hello.code", depth = 0, is_dir = false, open = false }
]
assert s.focus = "tree"

| A folder that is not there is refused, and the one open stays open.
emit OpenFolder { path = root + "/nope" } to this get missing
assert missing ∈ Failed
emit State to this get still
assert still.folder = root

| Enter on a folder opens it; left closes it again.
emit HandleKey { name = "enter", text = "" } to this
emit State to this get expanded
assert expanded.tree[0].open
assert expanded.tree[1] = { path = "src/notes.md", name = "notes.md", depth = 1, is_dir = false, open = false }
emit HandleKey { name = "left", text = "" } to this
emit State to this get collapsed
emit Length { value = collapsed.tree } to core get { value as rows_left }
assert rows_left = 2

| Down to the code file, enter: it opens, and the editor has the focus.
emit HandleKey { name = "down", text = "" } to this
emit HandleKey { name = "enter", text = "" } to this
emit State to this get editing
assert editing.focus = "editor"
assert editing.file.path = "hello.code"
assert editing.file.lines = ["| hi", "Greet { who } =>", "    return Hi", ""]

| Typing, then undo takes the whole word back; redo puts it back.
emit HandleKey { name = "x", text = "x" } to this
emit HandleKey { name = "y", text = "y" } to this
emit State to this get typed
assert typed.file.lines[0] = "xy| hi"
assert typed.file.dirty
emit HandleKey { name = "ctrl+z", text = "" } to this
emit State to this get undone
assert undone.file.lines[0] = "| hi"
emit HandleKey { name = "ctrl+y", text = "" } to this
emit State to this get redone
assert redone.file.lines[0] = "xy| hi"

| Ctrl+E — what most terminals send for Ctrl+Shift+E — moves the focus to
| the explorer, where the arrows move the selection, not the cursor; F6
| goes back.
emit HandleKey { name = "ctrl+e", text = "" } to this
emit State to this get in_tree
assert in_tree.focus = "tree"
emit HandleKey { name = "up", text = "" } to this
emit State to this get moved_up
assert moved_up.tree_sel = 0
assert moved_up.file.row = redone.file.row
emit HandleKey { name = "f6", text = "" } to this
emit State to this get back
assert back.focus = "editor"

| Save writes it; the file is clean again.
emit HandleKey { name = "ctrl+s", text = "" } to this
emit ReadFile { path = "hello.code" } to files get on_disk
assert on_disk.content = "xy| hi\nGreet { who } =>\n    return Hi\n"
emit State to this get saved
assert not saved.file.dirty
assert saved.message = "Saved hello.code"

| The frame at the default 80 columns: menu bar, the explorer 30 wide on
| the left (the default width), the file in the center.
emit State to this get now
emit Frame { state = now } to this get screen
assert screen ∈ Screen
assert screen.overlays[1].spans[1].text = " File "
assert screen.cursor_row = 2
assert screen.cursor_col = 30 + 5 + 2
| The explorer's title row, and the editor's first line, coloured.
titles = []
loop o over screen.overlays
    if o.row = 1, titles += o.spans[0].text
assert titles = [" EXPLORER: .TEST-FOLDER", "", " hello.code "]
kinds = []
loop o over screen.overlays
    if o.row = 3 and o.col = 30
        loop span over o.spans
            kinds += span.style
assert kinds = ["line_number", "plain", "class", "plain", "variable", "plain", "operator", "plain"]

| Alt+F opens File; down, down, enter runs Close File.
emit HandleKey { name = "alt+f", text = "" } to this
emit State to this get menu_open
assert menu_open.menu = { index = 0, item = 0 }
emit HandleKey { name = "down", text = "" } to this
emit HandleKey { name = "down", text = "" } to this
emit HandleKey { name = "enter", text = "" } to this
emit State to this get closed
assert closed.menu = null
assert closed.file = null
assert closed.focus = "tree"

| Ctrl+B hides the explorer; with no file, the welcome pane shows.
emit HandleKey { name = "ctrl+b", text = "" } to this
emit State to this get bare
assert not bare.explorer
emit Frame { state = bare } to this get welcome
found = false
loop o over welcome.overlays
    if o.spans[0].text = "  codelovesme ide", found = true
assert found
emit HandleKey { name = "ctrl+b", text = "" } to this

| Ctrl+K Ctrl+O asks for a folder in the status bar; Escape drops it.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "ctrl+o", text = "" } to this
emit State to this get asking
assert asking.prompt.kind = "open_folder"
assert asking.prompt.text = root + "/"
emit HandleKey { name = "s", text = "s" } to this
emit State to this get typing
assert typing.prompt.text = root + "/s"
emit HandleKey { name = "escape", text = "" } to this
emit State to this get dropped
assert dropped.prompt = null

| An edited file asks before closing; n closes it unsaved.
emit HandleKey { name = "down", text = "" } to this
emit HandleKey { name = "enter", text = "" } to this
emit HandleKey { name = "z", text = "z" } to this
emit HandleKey { name = "ctrl+w", text = "" } to this
emit State to this get asked
assert asked.prompt.kind = "close"
emit HandleKey { name = "n", text = "n" } to this
emit State to this get unsaved
assert unsaved.file = null
emit ReadFile { path = "hello.code" } to files get untouched
assert untouched.content = on_disk.content

| The shortcuts open read-only; typing is refused.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get help
assert help.file.readonly
assert help.file.lines[0] = "Keyboard Shortcuts"
emit HandleKey { name = "q", text = "q" } to this
emit State to this get refused
assert refused.file.lines[0] = "Keyboard Shortcuts"
assert refused.message = "This file is read-only."

emit HandleKey { name = "ctrl+w", text = "" } to this
emit State to this get help_closed
assert help_closed.groups = []

| Tabs. Two files open: two tabs, the second showing. Edits stay with
| their tab while another is shown.
emit OpenFile { path = "src/notes.md" } to this
emit OpenFile { path = "hello.code" } to this
emit FocusGroup { index = 0 } to this
emit HandleKey { name = "q", text = "q" } to this
emit HandleKey { name = "ctrl+pageup", text = "" } to this
emit State to this get two_tabs
assert two_tabs.file.path = "src/notes.md"
emit Length { value = two_tabs.groups[0].tabs } to core get { value as tab_count }
assert tab_count = 2
emit HandleKey { name = "ctrl+pagedown", text = "" } to this
emit State to this get kept
assert kept.file.path = "hello.code"
assert kept.file.lines[0] = "qxy| hi"
assert kept.file.dirty
| Opening an open file brings its tab back, edits and all.
emit OpenFile { path = "src/notes.md" } to this
emit OpenFile { path = "hello.code" } to this
emit State to this get same_tab
assert same_tab.file.lines[0] = "qxy| hi"
emit Frame { state = same_tab } to this get tabbed
strip = []
loop o over tabbed.overlays
    if o.row = 1 and o.col = 30
        loop span over o.spans
            if span.text ≠ "", strip += span.text
assert strip = [" notes.md ", " hello.code ● "]

| Split Editor: the file again in a group on the right, focused; the two
| share the editor area half and half, with a line between them.
emit HandleKey { name = "ctrl+\\", text = "" } to this
emit State to this get split_state
emit Length { value = split_state.groups } to core get { value as group_count }
assert group_count = 2
assert split_state.current = 1
emit Frame { state = split_state } to this get split_screen
lefts = []
loop o over split_screen.overlays
    if o.row = 1 and o.col ≥ 30, lefts += o.col
assert lefts = [30, 30, 55, 56, 56]
assert split_screen.cursor_col = 56 + 5 + 1
| F6 goes round: explorer, left group, right group.
emit HandleKey { name = "f6", text = "" } to this
emit State to this get round_tree
assert round_tree.focus = "tree"
emit HandleKey { name = "f6", text = "" } to this
emit State to this get round_left
assert round_left.focus = "editor"
assert round_left.current = 0
| Quitting asks about both unsaved files at once; Escape keeps them.
emit HandleKey { name = "ctrl+q", text = "" } to this
emit State to this get quitting
assert quitting.prompt.label = "2 files have unsaved changes. Save them all before exit? (y / n / Escape) "
emit HandleKey { name = "escape", text = "" } to this
| Closing the right group's only tab leaves the left one.
emit FocusGroup { index = 1 } to this
emit HandleKey { name = "ctrl+w", text = "" } to this
emit HandleKey { name = "n", text = "n" } to this
emit State to this get one_group
emit Length { value = one_group.groups } to core get { value as groups_left }
assert groups_left = 1
assert one_group.file.path = "hello.code"
emit HandleKey { name = "ctrl+w", text = "" } to this
emit HandleKey { name = "n", text = "n" } to this
emit HandleKey { name = "ctrl+w", text = "" } to this
emit State to this get all_closed
assert all_closed.groups = []

| Settings. Ctrl+B hides the explorer and says so in settings.json.
emit HandleKey { name = "ctrl+b", text = "" } to this
emit ReadFile { path = "settings.json" } to prefs_fs get stored
emit Parse { text = stored.content } to json_lib get stored_values
assert stored_values.value["workbench.sideBar.visible"] = false
emit HandleKey { name = "ctrl+b", text = "" } to this

| Ctrl+K → makes it two columns wider; Ctrl+K ← narrower again.
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "right", text = "" } to this
emit State to this get wider
assert wider.side_width = 32
emit HandleKey { name = "ctrl+k", text = "" } to this
emit HandleKey { name = "left", text = "" } to this
emit State to this get narrower
assert narrower.side_width = 30

| Ctrl+, opens settings.json; saving an edit to it applies it.
emit HandleKey { name = "ctrl+,", text = "" } to this
emit State to this get editing_settings
assert editing_settings.file.path = "settings.json"
assert editing_settings.file.lines[0] = "{"
assert editing_settings.focus = "editor"
emit SetLines { lines = ["{", "  \"workbench.sideBar.location\": \"right\",", "  \"workbench.sideBar.width\": 40", "}", ""] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get applied
assert applied.explorer_slot = "r"
assert applied.side_width = 40
assert applied.explorer
assert applied.message = "Settings saved and applied"

| A setting that is not what it should be falls back, and says so.
emit SetLines { lines = ["{ \"workbench.sideBar.width\": \"wide\" }"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get fell_back
assert fell_back.side_width = 30
assert fell_back.message = "Error: settings.json: using the default for workbench.sideBar.width (10 or more)"
emit SetLines { lines = ["not json"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get broken
assert broken.message = "Error: settings.json is not valid JSON — using the defaults"
assert broken.explorer_slot = "l"

| keybindings.json: opened from the File menu, made empty the first time;
| saving an entry makes its key run the command.
emit Run { command = "keybindings.open" } to this
emit State to this get bindings_open
assert bindings_open.file.path = "keybindings.json"
assert bindings_open.file.lines = ["[", "]", ""]
emit SetLines { lines = ["[", "  { \"key\": \"ctrl+j\", \"command\": \"view.explorer\" }", "]"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get bindings_saved
assert bindings_saved.message = "Keyboard shortcuts saved and applied"
assert bindings_saved.keytable.labels["view.explorer"] = "Ctrl+B"
was_visible = bindings_saved.explorer
emit HandleKey { name = "ctrl+j", text = "" } to this
emit State to this get toggled
assert toggled.explorer ≠ was_visible
emit HandleKey { name = "ctrl+j", text = "" } to this
emit SetLines { lines = ["[{ \"key\": \"ctrl+g\", \"command\": \"no.such\" }]"] } to this
emit HandleKey { name = "ctrl+s", text = "" } to this
emit State to this get bindings_bad
assert bindings_bad.message = "Error: keybindings.json: entry 1: no command \"no.such\""

emit RemoveDir { path = "." } to prefs_fs
emit RemoveDir { path = "." } to files
