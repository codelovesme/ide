| Voice input: which engine hears, the lines that record and hear (no key
| on a command line), the answers read, the words put at the cursor; and
| the ide recording with a stand-in recorder (tests/fake-recorder.sh),
| stopped by the same key, heard by a stand-in whisper-cli
| (tests/fake-whisper.sh), the words in the chat's box and nothing sent;
| Escape throwing a recording away; the model offered before anything is
| recorded; a recorder that is not there.

link "../src/agents.gene.code"
link "../src/chatbox.gene.code"
link "../src/context.gene.code"
link "../src/editor.gene.code"
link "../src/ide.gene.code"
link "../src/keys.gene.code"
link "../src/layout.gene.code"
link "../src/llm.gene.code"
link "../src/menu.gene.code"
link "../src/render.gene.code"
link "../src/settings.gene.code"
link "../src/tabs.gene.code"
link "../src/tree.gene.code"
link "../src/voice.gene.code"

| Whether `part` is somewhere in `text`.
Contains { text, part } =>
    emit Length { value = text } to core get { value as size }
    emit Length { value = part } to core get { value as want }
    i = 0
    loop
        if i + want > size, break
        if text[i, i + want) = part, return Is { yes = true }
        i += 1
    return Is { yes = false }

emit UseOrganelles { from = "organelles" } to this get lib
assert lib ∈ Linked
procs_lib = lib.process
emit Run { command = "rm", args = ["-rf", ".test-voice", ".test-voice-models", ".test-voice-config"] } to procs_lib
strings_lib = lib.strings
folder_fs = lib.fs
emit Config { base_path = ".test-voice" } to folder_fs get area
emit WriteFile { path = "readme.md", content = "hello\n" } to folder_fs
emit SettingsAt { dir = ".test-voice-config" } to this
emit OpenFolder { path = area.base_path } to this
emit Run { command = "pwd", args = [], cwd = "tests" } to procs_lib get tests_dir
emit Trim { value = tests_dir.stdout } to strings_lib get tests_at
emit State to this get start
defaults = start.settings

| The defaults: auto, the base model, pw-record, a minute.
assert defaults["ai.voice.provider"] = "auto" and defaults["ai.voice.offlineModel"] = "base"
assert defaults["ai.voice.recordCommand"] = ["pw-record", "--rate", "16000", "--channels", "1"]
assert defaults["ai.voice.maxSeconds"] = 60

| Which engine hears: auto is offline for nobody signed in and nothing
| set, the speech server once one is set, Mike when signed in; a named
| one is that one.
emit VoiceEngine { settings = defaults, signed_in = false } to this get alone
assert alone.name = "offline" and alone.title = "offline"
emit VoiceEngine { settings = defaults + { "ai.voice.endpoint" = "http://localhost:8080" }, signed_in = false } to this get served
assert served.name = "openai-compatible"
emit VoiceEngine { settings = defaults + { "ai.voice.endpoint" = "http://localhost:8080" }, signed_in = true } to this get with_mike
assert with_mike.name = "mike" and with_mike.title = "Mike"
emit VoiceEngine { settings = defaults + { "ai.voice.provider" = "offline" }, signed_in = true } to this get named
assert named.name = "offline"

| The offline models: ours (fetchable, sha256 known) or the user's own file.
emit OfflineModelAt { name = "base", dir = "/m" } to this get base_model
assert base_model.path = "/m/ggml-base.bin" and base_model.ours and base_model.size = "142 MB"
assert base_model.url = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin"
emit OfflineModelAt { name = "/data/ggml-medium.bin", dir = "/m" } to this get own
assert own.path = "/data/ggml-medium.bin" and not own.ours

| The recorder: stopped by INT after the most seconds, every word quoted.
emit RecordLine { settings = defaults, wav = "/r/voice.wav", err = "/r/err.txt" } to this get recorder
assert recorder.command = "/bin/sh"
assert recorder.args = ["-c", "exec timeout -s INT 60 'pw-record' '--rate' '16000' '--channels' '1' '/r/voice.wav' 2> '/r/err.txt'"]

| Offline: whisper-cli, the language auto unless one is set, JSON out.
emit TranscribeLine { engine = "offline", settings = defaults, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "/m/ggml-base.bin", whisper = "/b/whisper-cli", bridge = "", account_file = "" } to this get offline_line
assert offline_line.args[1] = "exec '/b/whisper-cli' -m '/m/ggml-base.bin' -f '/r/voice.wav' -l 'auto' -nt -np -oj -of '/r/voice' > /dev/null 2> '/r/err.txt'"
emit TranscribeLine { engine = "offline", settings = defaults + { "ai.voice.language" = "tr" }, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "/m/ggml-base.bin", whisper = "/b/whisper-cli", bridge = "", account_file = "" } to this get turkish
emit Contains { text = turkish.args[1], part = " -l 'tr' " } to this get pinned
assert pinned.yes

| A speech server: the key's variable read by the shell into curl's input
| (-H @-) — its name only on the line, never its value; a name that is not
| a variable's is refused; the endpoint's / and /v1 handled.
server = defaults + { "ai.voice.endpoint" = "http://localhost:8080/", "ai.voice.model" = "whisper-large", "ai.voice.apiKeyEnv" = "LOCALAI_API_KEY" }
emit TranscribeLine { engine = "openai-compatible", settings = server, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "", whisper = "", bridge = "", account_file = "" } to this get curl_line
assert curl_line.args[1] = "printf 'Authorization: Bearer %s' \"\$LOCALAI_API_KEY\" | exec curl -sS -m 60 -F 'file=@/r/voice.wav;type=audio/wav' -F 'model=whisper-large' -H @- 'http://localhost:8080/v1/audio/transcriptions' -o '/r/voice.json' 2> '/r/err.txt'"
emit TranscribeLine { engine = "openai-compatible", settings = server + { "ai.voice.endpoint" = "https://api.example/v1", "ai.voice.apiKeyEnv" = "" }, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "", whisper = "", bridge = "", account_file = "" } to this get keyless
assert keyless.args[1] = "exec curl -sS -m 60 -F 'file=@/r/voice.wav;type=audio/wav' -F 'model=whisper-large' 'https://api.example/v1/audio/transcriptions' -o '/r/voice.json' 2> '/r/err.txt'"
emit TranscribeLine { engine = "openai-compatible", settings = server + { "ai.voice.apiKeyEnv" = "KEY; rm -rf ~" }, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "", whisper = "", bridge = "", account_file = "" } to this get bad_key
assert bad_key ∈ Problem
emit TranscribeLine { engine = "openai-compatible", settings = defaults, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "", whisper = "", bridge = "", account_file = "" } to this get no_server
assert no_server ∈ Problem
emit VariableName { name = "OPENAI_API_KEY" } to this get good_name
emit VariableName { name = "1KEY" } to this get digit_first
assert good_name.yes and not digit_first.yes

| Mike: the bridge, its account checked there.
emit TranscribeLine { engine = "mike", settings = defaults, wav = "/r/voice.wav", out = "/r/voice.json", err = "/r/err.txt", model = "", whisper = "", bridge = "/b/mike_bridge.py", account_file = "/c/account.json" } to this get mike_line
assert mike_line.command = "/usr/bin/python3"
assert mike_line.args = ["-I", "/b/mike_bridge.py", "--hear", "/r/voice.wav", "--result", "/r/voice.json", "--account-file", "/c/account.json"]

| The model's download: to .part, kept only when its sha256 matches.
emit DownloadLine { model = base_model, err = "/r/err.txt" } to this get fetch
assert fetch.args[1] = "{ mkdir -p '/m' && curl -fL --retry 2 -sS -o '/m/ggml-base.bin.part' 'https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin' && echo '60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe  /m/ggml-base.bin.part' | sha256sum -c --quiet - && mv '/m/ggml-base.bin.part' '/m/ggml-base.bin'; } 2> '/r/err.txt'; status=\$?; rm -f '/m/ggml-base.bin.part'; exit \$status"

| The answers: whisper-cli's pieces joined; a server's text or its error;
| Mike's words or its note; nothing heard; junk.
emit VoiceReply { engine = "offline", content = "{\"transcription\":[{\"text\":\" Open the\"},{\"text\":\" readme. \"}]}" } to this get whispered
assert whispered ∈ Heard and whispered.text = "Open the readme."
emit VoiceReply { engine = "openai-compatible", content = "{\"text\":\"Bu dosyayı aç\",\"language\":\"tr\"}" } to this get served_words
assert served_words.text = "Bu dosyayı aç"
emit VoiceReply { engine = "openai-compatible", content = "{\"error\":{\"message\":\"Incorrect API key\"}}" } to this get refused
assert refused ∈ NotHeard and refused.reason = "Incorrect API key"
emit VoiceReply { engine = "mike", content = "{\"text\":\"run the tests\"}" } to this get mike_words
assert mike_words.text = "run the tests"
emit VoiceReply { engine = "mike", content = "{\"error\":\"unknown_route\",\"note\":\"The shared Mike service is too old to hear\"}" } to this get too_old
assert too_old.reason = "The shared Mike service is too old to hear"
emit VoiceReply { engine = "offline", content = "{\"transcription\":[{\"text\":\"  \"}]}" } to this get silence
assert silence ∈ NotHeard and silence.reason = "no words were heard"
emit VoiceReply { engine = "openai-compatible", content = "<html>" } to this get junk
assert junk ∈ NotHeard

| The words at the cursor, a space either side only where needed.
emit InsertSpoken { input = "", caret = null, text = "open it" } to this get empty_box
assert empty_box.input = "open it" and empty_box.caret = 7
emit InsertSpoken { input = "please", caret = null, text = "open it" } to this get after_word
assert after_word.input = "please open it" and after_word.caret = 14
emit InsertSpoken { input = "please now", caret = 6, text = "open it" } to this get between
assert between.input = "please open it now" and between.caret = 14
emit InsertSpoken { input = "x ", caret = 2, text = "y" } to this get after_space
assert after_space.input = "x y"

| Settings: a wrong value falls back to its default, and says so.
emit StoreSetting { key = "ai.voice.provider", value = "siri" } to this
emit StoreSetting { key = "ai.voice.offlineModel", value = "huge" } to this
emit StoreSetting { key = "ai.voice.maxSeconds", value = 0 } to this
emit State to this get wrong
assert wrong.settings["ai.voice.provider"] = "auto" and wrong.settings["ai.voice.offlineModel"] = "base" and wrong.settings["ai.voice.maxSeconds"] = 60
emit Contains { text = wrong.message, part = "ai.voice.maxSeconds (1 to 600)" } to this get said
assert said.yes

| The key: Ctrl+Shift+Space runs ai.voice, and it is in the View menu.
emit Keymap { name = "ctrl+shift+space", pending = "", table = start.keytable } to this get bound
assert bound.command = "ai.voice"
assert start.keytable.labels["ai.voice"] = "Ctrl+Shift+Space"

| The ide, offline, with stand-ins: a model file there, the recorder and
| whisper-cli the tests' own. Each hidden terminal's end is handed in
| between two statements, so the recorder's end and whisper-cli's each get
| a wait of their own.
emit Run { command = "sh", args = ["-c", "mkdir -p .test-voice-models && echo not really a model > .test-voice-models/ggml-base.bin && cd .test-voice-models && pwd"] } to procs_lib get made_models
emit Trim { value = made_models.stdout } to strings_lib get models_at
models_area = { base_path = models_at.value }
emit StoreSetting { key = "ai.voice.provider", value = "offline" } to this
emit StoreSetting { key = "ai.voice.modelDir", value = models_area.base_path } to this
emit StoreSetting { key = "ai.voice.recordCommand", value = [tests_at.value + "/fake-recorder.sh"] } to this
emit StoreSetting { key = "ai.voice.whisperCommand", value = tests_at.value + "/fake-whisper.sh" } to this
emit StoreSetting { key = "ai.voice.maxSeconds", value = 20 } to this
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit State to this get recording
assert recording.voice = "recording"
assert recording.message = "● Recording — Ctrl+Shift+Space stops, Escape throws it away"
emit Run { command = "sleep", args = ["0.5"] } to procs_lib
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit Run { command = "sleep", args = ["1"] } to procs_lib
emit Run { command = "sleep", args = ["1"] } to procs_lib
emit State to this get heard
assert heard.voice = ""
assert heard.message = "Heard you — Enter sends it to the AI, or change it first"
assert heard.chat.input = "open the readme" and heard.focus = "chat"
assert heard.chat.turns = [] and not heard.chat.busy

| Again, said into what is already typed: the words go at the cursor.
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit Run { command = "sleep", args = ["0.5"] } to procs_lib
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit Run { command = "sleep", args = ["1"] } to procs_lib
emit Run { command = "sleep", args = ["1"] } to procs_lib
emit State to this get twice
assert twice.chat.input = "open the readme open the readme"

| Escape throws a recording away; nothing reaches the box.
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit State to this get again
assert again.voice = "recording"
emit HandleKey { name = "escape", text = "" } to this
emit Run { command = "sleep", args = ["0.5"] } to procs_lib
emit State to this get thrown
assert thrown.voice = "" and thrown.message = "Voice input cancelled"
assert thrown.chat.input = "open the readme open the readme"

| No model yet: offered before anything is recorded; n fetches nothing.
emit StoreSetting { key = "ai.voice.modelDir", value = models_area.base_path + "/empty" } to this
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit State to this get offered
assert offered.voice = "" and offered.prompt.kind = "voice_download"
assert offered.prompt.label = "Offline voice needs the speech model ggml-base.bin (142 MB, once) — download it now? (y / n) "
emit HandleKey { name = "n", text = "n" } to this
emit State to this get declined
assert declined.prompt = null and declined.voice = ""

| A recorder that is not there: said, and the ide carries on.
emit StoreSetting { key = "ai.voice.modelDir", value = models_area.base_path } to this
emit StoreSetting { key = "ai.voice.recordCommand", value = ["/nowhere/recorder"] } to this
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit Run { command = "sleep", args = ["1"] } to procs_lib
emit State to this get no_recorder
assert no_recorder.voice = ""
emit Contains { text = no_recorder.message, part = "Error: Voice: nothing was recorded" } to this get unrecorded
assert unrecorded.yes

| A frame while recording: ● REC in the status bar.
emit StoreSetting { key = "ai.voice.recordCommand", value = [tests_at.value + "/fake-recorder.sh"] } to this
emit HandleKey { name = "ctrl+shift+space", text = "" } to this
emit State to this get drawing
emit Placement { state = drawing } to this get placement
emit Frame { state = drawing, placement = placement, screens = {} } to this get frame
rec_shown = false
loop o over frame.overlays
    loop span over o.spans
        emit Contains { text = span.text, part = "● REC" } to this get has_rec
        if has_rec.yes, rec_shown = true
assert rec_shown
emit Run { command = "ai.voice.cancel" } to this

emit Run { command = "rm", args = ["-rf", ".test-voice", ".test-voice-models", ".test-voice-config"] } to procs_lib
