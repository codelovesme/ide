| Views in groups, groups in slots: opening finds a view's own tab, a group
| is made where there is none, closing the last tab of a group closes it,
| moving a tab carries it to another slot, and any kind of view is a tab.

link "../src/tabs.gene.code"

a = { kind = "file", path = "a.code", store = "workspace", dirty = false }
b = { kind = "file", path = "b.code", store = "workspace", dirty = true }
explorer = { kind = "explorer", path = "Explorer", store = "view" }
shell = { kind = "terminal", path = "Terminal 1", store = "terminal", id = 7 }

| The explorer on the left, files in the center.
emit OpenIn { groups = [], slot = "l", buffer = explorer } to this get left
assert left.groups = [{ slot = "l", tabs = [explorer], active = 0 }]
assert left.current = 0
emit OpenIn { groups = left.groups, slot = "c", buffer = a } to this get one
emit OpenIn { groups = one.groups, slot = "c", buffer = b } to this get two
assert two.groups[1] = { slot = "c", tabs = [a, b], active = 1 }
assert two.current = 1
| An open view gets its tab back.
emit OpenIn { groups = two.groups, slot = "c", buffer = a + { dirty = true } } to this get again
assert again.groups[1] = { slot = "c", tabs = [a, b], active = 0 }
emit GroupAt { groups = again.groups, slot = "l" } to this get where
assert where.index = 0
emit FindView { groups = again.groups, path = "Explorer", store = "view" } to this get found
assert found = { _class = "Place", group = 0, tab = 0 }

| A terminal at the bottom, then moved into the center as a tab.
emit OpenIn { groups = again.groups, slot = "b", buffer = shell } to this get with_shell
assert with_shell.groups[2] = { slot = "b", tabs = [shell], active = 0 }
emit MoveTab { groups = with_shell.groups, current = 2, into = "c" } to this get moved
emit Length { value = moved.groups } to core get { value as after_move }
assert after_move = 2
assert moved.groups[1] = { slot = "c", tabs = [a, shell, b], active = 1 }
assert moved.current = 1
| The explorer moved into the center too: the left closes.
emit MoveTab { groups = moved.groups, current = 0, into = "c" } to this get all_center
assert all_center.groups = [{ slot = "c", tabs = [a, shell, explorer, b], active = 2 }]
assert all_center.current = 0
| Moving to where it is does nothing.
emit MoveTab { groups = all_center.groups, current = 0, into = "c" } to this get stay
assert stay.groups = all_center.groups

| Stepping goes round.
emit StepTab { groups = all_center.groups, current = 0, step = 1 } to this get stepped
assert stepped.groups[0].active = 3
emit StepTab { groups = stepped.groups, current = 0, step = 1 } to this get round
assert round.groups[0].active = 0

| Closing: the active tab, then the last tab closes the group and the
| center's group takes the focus.
emit CloseTab { groups = [{ slot = "l", tabs = [explorer], active = 0 }, { slot = "c", tabs = [a, b], active = 1 }], current = 0 } to this get no_left
assert no_left.groups = [{ slot = "c", tabs = [a, b], active = 1 }]
assert no_left.current = 0
emit CloseTab { groups = no_left.groups, current = 0 } to this get one_left
assert one_left.groups = [{ slot = "c", tabs = [a], active = 0 }]
| Closing a tab somewhere else — a terminal that ended — keeps the focus.
groups3 = [{ slot = "l", tabs = [explorer], active = 0 }, { slot = "c", tabs = [a, b], active = 1 }, { slot = "b", tabs = [shell], active = 0 }]
emit CloseAt { groups = groups3, current = 1, group = 2, tab = 0 } to this get shell_gone
assert shell_gone.groups = [{ slot = "l", tabs = [explorer], active = 0 }, { slot = "c", tabs = [a, b], active = 1 }]
assert shell_gone.current = 1
emit CloseAt { groups = groups3, current = 2, group = 1, tab = 0 } to this get a_gone
assert a_gone.groups[1] = { slot = "c", tabs = [b], active = 0 }
assert a_gone.current = 2
emit CloseAt { groups = groups3, current = 2, group = 0, tab = 0 } to this get left_gone
assert left_gone.current = 1

| Split Editor opens the file again on the right.
emit SplitGroups { groups = [{ slot = "c", tabs = [a], active = 0 }], current = 0, buffer = a } to this get split
assert split.groups = [{ slot = "c", tabs = [a], active = 0 }, { slot = "r", tabs = [a], active = 0 }]
assert split.current = 1

| What is unsaved counts files only; the terminals, by id.
emit Unsaved { groups = all_center.groups } to this get unsaved
assert unsaved.count = 1
assert unsaved.first = "b.code"
emit Terminals { groups = all_center.groups } to this get terminals
assert terminals.ids = [7]
