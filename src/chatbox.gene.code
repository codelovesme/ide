| Chat — the AI chat's pieces that need no state. Pure.
|
| The chat is a tab like any other (kind `chat`), on the right until it is
| moved. Its state lives in the ide gene as
|
|     { turns, messages, input, busy, request, steps, scroll }
|
| `turns` is what is shown — `{ role, text }`, role "user", "assistant",
| "tool" (a step the model took: "read src/a.code") or "error";
| `messages` is what the model is sent, `{ role, content }`. The model is
| asked for one JSON object per reply — a tool to run, or the answer
| (context.gene.code tells it how); `ReadReply` reads that, forgiving a
| model that answers in plain words.

parser = null
texts = null

ChatUses { json, strings } =>
    parser = json
    texts = strings
    return Using

| A key in the chat's input box, whose cursor is at `caret` (a character
| of `input`; null is its end). `send` is the text to ask about when Enter
| sent it (else null); `scroll` moves the conversation (lines, up is
| more): PgUp/PgDn a page, Ctrl+↑/↓ a line. ←/→, Home/End and ↑/↓ move
| the cursor; ↑ on the first line or ↓ on the last is `edge` — `Recall`'s.
ChatInput { input, caret, name, text, page } =>
    emit Length { value = input } to core get { value as size }
    at = caret
    if at = null or at > size, at = size
    if at < 0, at = 0
    before = input[0, at)
    after = input[at, size)
    result = ChatInputResult { input = input, caret = at, send = null, scroll = 0, edge = false }
    if name = "enter"
        emit Trim { value = input } to texts get trimmed
        if trimmed.value = "", return result
        return result + { input = "", caret = 0, send = trimmed.value }
    if name = "alt+enter" or name = "shift+enter" or name = "ctrl+enter"
        return result + { input = before + "\n" + after, caret = at + 1 }
    if name = "backspace"
        if at = 0, return result
        return result + { input = input[0, at - 1) + after, caret = at - 1 }
    if name = "delete"
        if at = size, return result
        return result + { input = before + input[at + 1, size), caret = at }
    if name = "ctrl+u", return result + { input = "", caret = 0 }
    if name = "left"
        if at > 0, return result + { caret = at - 1 }
        return result
    if name = "right"
        if at < size, return result + { caret = at + 1 }
        return result
    emit LineSpan { text = input, at = at } to this get here
    if name = "home", return result + { caret = here.start }
    if name = "end", return result + { caret = here.stop }
    if name = "up"
        if here.start = 0, return result + { edge = true }
        emit LineSpan { text = input, at = here.start - 1 } to this get above
        reach = above.start + at - here.start
        if reach > above.stop, reach = above.stop
        return result + { caret = reach }
    if name = "down"
        if here.stop = size, return result + { edge = true }
        emit LineSpan { text = input, at = here.stop + 1 } to this get below
        reach = below.start + at - here.start
        if reach > below.stop, reach = below.stop
        return result + { caret = reach }
    if name = "pageup", return result + { scroll = page }
    if name = "pagedown", return result + { scroll = 0 - page }
    if name = "ctrl+up", return result + { scroll = 1 }
    if name = "ctrl+down", return result + { scroll = -1 }
    if text ≠ ""
        emit Length { value = text } to core get { value as added }
        return result + { input = before + text + after, caret = at + added }
    return result

| The line of `text` that character `at` is on: where it starts, and where
| it stops (its "\n", or the end).
LineSpan { text, at } =>
    emit Length { value = text } to core get { value as size }
    start = at
    loop
        if start = 0 or text[start - 1] = "\n", break
        start = start - 1
    stop = at
    loop
        if stop ≥ size or text[stop] = "\n", break
        stop += 1
    return Span { start = start, stop = stop }

| The input box's lines: `text` cut every `width` characters (and at its
| own line breaks), and the line and column the cursor (`caret`) is on.
| A line has room for the cursor after its last character.
InputLines { text, caret, width } =>
    if width < 1, width = 1
    out = []
    caret_line = 0
    caret_col = 0
    offset = 0
    emit Split { value = text, separator = "\n" } to texts get paragraphs
    loop paragraph over paragraphs.value
        emit Length { value = paragraph } to core get { value as size }
        i = 0
        loop
            last_piece = i + width > size
            if caret ≥ offset + i and (caret < offset + i + width or (last_piece and caret ≤ offset + size))
                emit Length { value = out } to core get { value as lines_before }
                caret_line = lines_before
                caret_col = caret - offset - i
            piece_end = i + width
            if piece_end > size, piece_end = size
            out += paragraph[i, piece_end)
            i += width
            if last_piece, break
        offset += size + 1
    return InputShape { lines = out, caret_line = caret_line, caret_col = caret_col }

| ↑ (`step` -1) and ↓ (1) in the input box: back through the questions
| asked (`history`, oldest first) and forward again to what was being
| written (`draft`). `at` is where it is: the history's length on the
| draft.
Recall { history, at, input, draft, step } =>
    emit Length { value = history } to core get { value as size }
    if at ≥ size
        at = size
        draft = input
    next = at + step
    if next < 0 or next > size, return Recalled { input = input, at = at, draft = draft }
    if next = size, return Recalled { input = draft, at = size, draft = draft }
    return Recalled { input = history[next], at = next, draft = draft }

| The first `{` … the last `}` of `text`, or "" when it has none.
Braced { text } =>
    emit Length { value = text } to core get { value as size }
    first = -1
    i = 0
    loop
        if i ≥ size, break
        if text[i] = "{"
            first = i
            break
        i += 1
    if first < 0, return Text { text = "" }
    last = -1
    i = size - 1
    loop
        if i ≤ first, break
        if text[i] = "}"
            last = i
            break
        i = i - 1
    if last < 0, return Text { text = "" }
    return Text { text = text[first, last] }

| A reply from the model: a tool to run (`tool`, `args`), or the answer.
| A reply that is not the JSON asked for is taken as the answer, whole.
ReadReply { content } =>
    emit Braced { text = content } to this get braced
    if braced.text ≠ ""
        emit Parse { text = braced.text } to parser get parsed
        if parsed ∉ Exception and parsed.value ∈ Object
            reply = parsed.value
            if reply["tool"] ∈ String and reply["tool"] ≠ ""
                args = reply["args"]
                if args ∉ Object, args = {}
                return Reply { tool = reply["tool"], args = args, answer = null }
            if reply["answer"] ∈ String, return Reply { tool = null, args = null, answer = reply["answer"] }
    emit Trim { value = content } to texts get trimmed
    return Reply { tool = null, args = null, answer = trimmed.value }

| A tool step, as the chat shows it.
ToolLine { tool, args } =>
    path = args["path"]
    if path ∉ String or path = "", path = "."
    if tool = "read_file"
        range = ""
        if args["from"] ∈ Number, range = " " + args["from"] + "–"
        if args["to"] ∈ Number, range = range + args["to"]
        return Text { text = "read " + path + range }
    if tool = "list_dir", return Text { text = "listed " + path }
    if tool = "grep", return Text { text = "searched for \"" + args["pattern"] + "\"" }
    if tool = "find_files", return Text { text = "looked for files named \"" + args["name"] + "\"" }
    if tool = "git_diff", return Text { text = "looked at the git diff" }
    return Text { text = tool }

| The `@` words of a question: `@terminal`, `@git`, `@file`, `@folder`,
| or a path (`@src/a.code`).
Mentions { input } =>
    emit Split { value = input, separator = "\n" } to texts get lines
    found = []
    loop line over lines.value
        emit Split { value = line, separator = " " } to texts get words
        loop word over words.value
            if word[0] = "@"
                emit Length { value = word } to core get { value as size }
                if size > 1
                    name = word[1, length)
                    last = name[size - 2]
                    if last = "," or last = "." or last = "?" or last = "!" or last = ":", name = name[0, length - 1)
                    if name ≠ "", found += name
    return Found { mentions = found }

| `text` as lines of at most `width` — broken between words where it can,
| its own line breaks kept.
Wrap { text, width } =>
    out = []
    if width < 1, return Lines { lines = out }
    emit Split { value = text, separator = "\n" } to texts get paragraphs
    loop paragraph over paragraphs.value
        emit Split { value = paragraph, separator = " " } to texts get words
        line = ""
        used = 0
        loop word over words.value
            emit Length { value = word } to core get { value as size }
            if used > 0 and used + 1 + size > width
                out += line
                line = ""
                used = 0
            if used > 0
                line = line + " "
                used += 1
            | A word longer than the line is cut into lines of its own.
            rest = word
            loop
                if used + size ≤ width, break
                room = width - used
                out += line + rest[0, room)
                rest = rest[room, length)
                size = size - room
                line = ""
                used = 0
            line = line + rest
            used += size
        out += line
    return Lines { lines = out }
