| ide — the state, and what each key does to it.
|
| This is the one gene that holds state: a gene's top level is its
| handlers' whole world, so everything that changes lives here and every
| other gene answers particles (layout, editor, tree, tabs, keys, menu,
| settings, render).
|
| A key arrives from `tty` as `Key { name, text }`. It goes, first match:
| to the prompt if one is open, to the menu if one is open, to a command if
| it is bound (keys.gene.code), else to what the focused tab shows — the
| explorer's rows, a file, the AI chat's input, or a terminal's shell
| (which gets most keys, see `HandleKey`). Then the screen is drawn again.
| Anything that fails lands in the status bar, not silence.

folder = ""
cols = 80
rows = 24
running = false

| The explorer: the visible rows (see tree.gene.code), the selected one,
| and the first one showing.
tree = []
tree_sel = 0
tree_top = 0
tree_page = 20
| Whether the user has picked a row in the explorer since the folder was
| opened: until then, a new file goes to the root.
tree_picked = false

| Everything open, as tabs in groups, each group in a slot (see
| tabs.gene.code), and the group with the focus.
groups = []
current = 0

| The explorer's tab, and the slot it goes back to when shown again.
explorer_view = { kind = "explorer", path = "Explorer", store = "view" }

| The file the focused group shows, taken out of its tab while it is worked
| on: `{ path, store, lines, row, col, want, top, left, dirty, readonly }`.
| `Stash` puts it back, `Unstash` takes the next one out.
file = null
editor_page = 20
undo = []
redo = []
last_edit = ""

| What has the keys: the focused tab's kind — "tree" (the explorer),
| "editor" (a file), "terminal", "chat", "diff" (a change the AI
| proposes), or "none" when nothing is open.
focus = "none"
menu = null
prompt = null
| The model picker, when it is open (see OpenModelPicker).
picker = null
message = ""
chord = ""
explorer_slot = "l"

max_undo = 200

| Where the cursor has been, for Alt+← / Alt+→ (VS Code's Go Back /
| Forward): `{ path, row, col }` spots, `spot_at` the one in use. A spot is
| kept when the cursor goes to another file or 10 or more lines away; a
| smaller move just moves the spot. `navigating` while going to one.
spots = []
spot_at = -1
navigating = false
max_spots = 50

| Panes put away by their key (Ctrl+J, Ctrl+E): terminals and files, each
| `{ slot, view, active }`, kept whole — shells still running, edits and
| undo kept — until the key brings them back. (The explorer and the chat
| need no keeping: they are drawn from state that stays.)
hidden_panes = { terminal = [], file = [] }
| The pane keys run from inside a terminal too, whatever
| terminal.integrated.commandsToSkipShell says.
pane_commands = { "view.explorer" = true, "terminal.toggle" = true, "ai.toggle" = true, "editor.toggle" = true, "terminal.scrollUp" = true, "terminal.scrollDown" = true, "tab.newHere" = true, "window.new" = true }
| How far back each terminal is scrolled (Shift+PgUp), by its id.
terminal_scrolls = {}

| The organelles. They are linked while the program runs, not when it is
| built — a built program would otherwise carry the full path each one had
| on the machine that built it. See `Organelles`.
term = null
files = null
texts = null
vars = null
| A second `fs`, based in the settings folder rather than the open one.
prefs = null
| The desktop's clipboard: the `window` organelle's Copy / Paste (no window
| is opened). Null when it could not be linked — then `copied`, the ide's
| own, is all there is.
clipboard = null
copied = ""

| The user's settings (see settings.gene.code), and where they are kept.
settings = null
settings_dir = ""
| The side tracks' sizes (see layout.gene.code), from settings.
sizes = { left = 30, right = 40, top = 10, bottom = 12 }
| The key table (see keys.gene.code): the defaults and keybindings.json.
keytable = null

| The AI chat (see chatbox.gene.code): its tab, and the conversation. The
| model it talks to is whichever settings.json names (llm.gene.code);
| `models` holds the organelle each provider type uses, `model_key` the
| setup sent last, so it is sent again only when it changes.
chat_view = { kind = "chat", path = "AI Chat", store = "view", chat_id = "1" }
empty_chat = { turns = [], messages = [], input = "", caret = null, queue = [], busy = false, request = -1, steps = 0, scroll = 0, system = "", budget = null, pending = null, checkpoints = [], agent = null, session = "", session_for = "", snapshot = null, changed = null }
chat = empty_chat
| More than one AI tab (Ctrl+T in the chat): `chat` is the conversation
| with the keys (`chat_id`, its tab's `chat_id`); the others wait in
| `chats`, by id, and are brought in for a moment when their replies
| come (InChat).
chat_id = "1"
chats = {}
chats_opened = 1
chat_page = 10
| How many questions may wait (`chat.queue`) while the AI is working.
queue_most = 10
| The questions asked (oldest first) for ↑/↓ in the input box — kept
| through New AI Chat — where ↑/↓ are in them (their count: on the
| draft), and the question being written before ↑ was pressed.
questions = []
recall_at = 0
recall_draft = ""
models = {}
model_key = ""
procs = null
| http_client: a model server's /v1/models, for the picker.
web = null
jsons = null
| What the chat says before anything is asked when no model is set up,
| and the model (and, for an agent, the mode) on the rule over its input.
chat_notice = ""
chat_label = ""
| The same, short, for the status bar.
ai_status = ""
| What "this" means to the chat: the file and the terminal shown last, and
| the places just edited (`path:line`, latest last).
last_file = null
last_terminal = -1
recent = []

| Terminals: the pty organelle, how many have been opened (for their
| names), the size each was last told, and which commands still run while
| one has the keys (settings: terminal.integrated.commandsToSkipShell).
shells = null
terminals_opened = 0
terminal_sizes = {}

| Links the ten organelles from the folder `from`, relative to where the program
| was started: `.` in a release bundle (bin/ide starts it there), and
| `organelles` in a checkout (tools/organelles.sh puts them there).
Organelles { from } =>
    link from + "/env.so" as env_at
    link from + "/fs.so" as fs_at
    link from + "/strings.so" as strings_at
    link from + "/syntax.so" as syntax_at
    link from + "/tty.so" as tty_at
    link from + "/json.so" as json_at
    link from + "/fs.so" as prefs_at
    link from + "/pty.so" as pty_at
    link from + "/localai.so" as localai_at
    link from + "/process.so" as process_at
    link from + "/http_client.so" as http_at
    return Linked { http = http_at, env = env_at, fs = fs_at, strings = strings_at, syntax = syntax_at, tty = tty_at, json = json_at, prefs = prefs_at, pty = pty_at, localai = localai_at, process = process_at }

| Links them, and hands each gene the ones it uses.
UseOrganelles { from } =>
    emit Organelles { from = from } to this get linked
    if linked ∈ Exception, return linked
    vars = linked.env
    files = linked.fs
    texts = linked.strings
    term = linked.tty
    prefs = linked.prefs
    shells = linked.pty
    procs = linked.process
    web = linked.http
    jsons = linked.json
    models = { localai = linked.localai }
    emit ChatUses { json = linked.json, strings = linked.strings } to this
    emit ContextUses { strings = linked.strings } to this
    emit AgentsUses { json = linked.json, strings = linked.strings } to this
    emit SettingsUses { json = linked.json } to this
    emit KeysUses { json = linked.json, strings = linked.strings } to this
    emit EditorUses { texts = linked.strings } to this
    emit RenderUses { texts = linked.strings, colours = linked.syntax } to this
    emit LinkClipboard { from = from } to this
    return linked

| The clipboard's organelle, on its own: an ide without it still starts.
LinkClipboard { from } =>
    link from + "/window.so" as window_at
    clipboard = window_at
    return Linked

| `text` onto the clipboard (and kept, for a desktop without one).
CopyText { text } =>
    copied = text
    if clipboard = null, return Copied
    emit Copy { text = text } to clipboard get put
    if put ∈ Exception, message = "Copied here only — the desktop's clipboard said: " + put.message
    return Copied

| What is on the clipboard.
PasteText =>
    if clipboard = null, return Text { text = copied }
    emit Paste {} to clipboard get got
    if got ∈ Exception, return Text { text = copied }
    return Text { text = got.text }

EuglenaHasBeenBorn { cell_name } =>
    emit UseOrganelles { from = "." } to this get bundled
    if bundled ∈ Exception
        emit UseOrganelles { from = "organelles" } to this get checkout
        if checkout ∈ Exception, return Failed { reason = "the organelles could not be linked: " + checkout.message }
    emit Get { name = "IDE_FOLDER", default = "" } to vars get chosen
    start_in = chosen.value
    | Otherwise the folder it was started in — as fs resolves `.`, since
    | `PWD` is only what a shell says.
    if start_in = ""
        emit Config { base_path = "." } to files get here
        start_in = here.base_path
    | Settings live where VS Code's would on this system: the config folder.
    emit Get { name = "XDG_CONFIG_HOME", default = "" } to vars get xdg
    emit Get { name = "HOME", default = "/" } to vars get home
    config = xdg.value
    if config = "", config = home.value + "/.config"
    emit SettingsAt { dir = config + "/codelovesme-ide" } to this
    emit OpenFolder { path = start_in } to this get opened
    if opened ∈ Failed, return opened
    if settings["workbench.sideBar.visible"], emit ShowExplorer { focused = true } to this
    emit Start {} to term get started
    if started ∈ Exception, return Failed { reason = started.message }
    cols = started.cols
    rows = started.rows
    running = true
    emit Render to this
    return Alive { cell_name = cell_name }

Resize { cols as width, rows as height } =>
    cols = width
    rows = height
    emit Render to this
    return Resized

Key { name, text } =>
    if not running, return Ignored
    message = ""
    emit HandleKey { name = name, text = text } to this get handled
    if handled ∈ Exception, message = "Error: " + handled.message
    emit SendQueued to this
    emit Render to this
    return handled

| A terminal's screen changed (pushed by the pty organelle): draw again.
TerminalOutput { id } =>
    emit ChatOwner { request = null, pty = id } to this get owner
    if owner.id ≠ "", emit InChat { id = owner.id, particle = AgentProgress } to this
    if running, emit Render to this
    return Drawn

| A terminal's shell ended: its tab closes, as in VS Code.
TerminalExited { id, code } =>
    still_hidden = []
    loop kept over hidden_panes.terminal
        if kept.view.id ≠ id, still_hidden += kept
    hidden_panes = hidden_panes + { terminal = still_hidden }
    emit ChatOwner { request = null, pty = id } to this get owner
    if owner.id ≠ ""
        emit InChat { id = owner.id, particle = AgentFinished } to this
        if running, emit Render to this
        return Finished
    emit FindTerminal { id = id } to this get where
    if where.group ≥ 0
        emit Stash to this
        emit CloseAt { groups = groups, current = current, group = where.group, tab = where.tab } to this get closed
        groups = closed.groups
        current = closed.current
        emit Unstash to this
    if running, emit Render to this
    return Closed

| Where the terminal `id` is: its group and tab, or -1s.
FindTerminal { id } =>
    loop gi, group over groups
        loop ti, tab over group.tabs
            if tab.kind = "terminal" and tab.id = id, return Place { group = gi, tab = ti }
    return Place { group = -1, tab = -1 }

HandleKey { name, text } =>
    emit NoteSpot to this
    if prompt ≠ null
        emit PromptKey { name = name, text = text } to this
        return Handled
    if picker ≠ null
        emit PickerKey { name = name } to this
        return Handled
    if menu ≠ null
        emit MenuKey { open = menu, name = name } to this get chosen
        menu = chosen.open
        if chosen.command ≠ null, emit Run { command = chosen.command } to this
        return Handled
    | A terminal gets every key but the few commands that skip the shell,
    | so Ctrl+C, Ctrl+E, Ctrl+W… are the shell's, as in VS Code.
    if focus = "terminal"
        emit Keymap { name = name, pending = "", table = keytable } to this get for_shell
        skip = settings["terminal.integrated.commandsToSkipShell"]
        runs = false
        if for_shell.command ≠ null and pane_commands[for_shell.command] = true, runs = true
        if for_shell.command ≠ null
            loop allowed over skip
                if allowed = for_shell.command, runs = true
        if runs
            emit Run { command = for_shell.command } to this
            return Handled
        emit Active { groups = groups, current = current } to this get shown
        | A key typed brings the terminal back to its live screen.
        live_id = shown.buffer.id
        terminal_scrolls = terminal_scrolls + { "$live_id" = 0 }
        emit Type { id = shown.buffer.id, name = name, text = text } to shells
        return Typed
    emit Keymap { name = name, pending = chord, table = keytable } to this get bound
    chord = bound.pending
    if chord ≠ ""
        emit KeyLabel { key = chord } to this get pressed
        message = "(" + pressed.text + ") was pressed. Waiting for the second key of the chord…"
        return Handled
    if bound.command ≠ null
        emit Run { command = bound.command } to this
        return Handled
    if bound.chord ≠ ""
        message = "The key combination (" + bound.chord + ") is not a command."
        return Handled
    if focus = "tree"
        emit TreeKey { name = name } to this
        return Handled
    if focus = "chat"
        emit ChatKey { name = name, text = text } to this
        return Handled
    if focus = "diff"
        emit DiffKey { name = name } to this
        return Handled
    if focus = "editor" and file ≠ null
        emit EditorKey { name = name, text = text } to this
    return Handled

slot_names = ["tl", "t", "tr", "l", "c", "r", "bl", "b", "br"]
slot_known = { tl = true, t = true, tr = true, l = true, c = true, r = true, bl = true, b = true, br = true }

| A command, from a key or a menu item.
Run { command } =>
    if command = "file.save", emit SaveFile to this
    if command = "file.close", emit RequestClose to this
    if command = "app.quit", emit RequestQuit to this
    if command = "tab.next" or command = "tab.previous"
        step = 1
        if command = "tab.previous", step = -1
        emit Stash to this
        emit StepTab { groups = groups, current = current, step = step } to this get stepped
        groups = stepped.groups
        emit Unstash to this
    if command = "editor.split" and file ≠ null
        emit Stash to this
        emit SplitGroups { groups = groups, current = current, buffer = file } to this get split_up
        groups = split_up.groups
        current = split_up.current
        emit Unstash to this
    if command = "view.moveTab"
        prompt = { kind = "move", label = "Move the tab to (l r t b c tl tr bl br): ", text = "" }
    if command[0, 13) = "view.moveTab."
        emit MoveCurrent { into = command[13, length) } to this
    if command[0, 10) = "view.edge."
        emit ResizeEdge { direction = command[10, length) } to this
    if command = "file.new", emit NewFile to this
    if command = "file.openFolder"
        prompt = { kind = "open_folder", label = "Open folder: ", text = folder + "/" }
    if command = "view.explorer", emit TogglePane { kind = "explorer" } to this
    if command = "view.explorerLeft", emit PlaceExplorer { slot = "l" } to this
    if command = "view.explorerRight", emit PlaceExplorer { slot = "r" } to this
    if command = "settings.open", emit OpenPrefsFile { name = "settings.json" } to this
    if command = "keybindings.open", emit OpenPrefsFile { name = "keybindings.json" } to this
    if command = "focus.explorer", emit ShowExplorer { focused = true } to this
    if command = "focus.editor", emit FocusSlot { slot = "c" } to this
    if command = "focus.group2", emit FocusSlot { slot = "r" } to this
    if command = "focus.next", emit FocusNext to this
    if command = "terminal.toggle", emit TogglePane { kind = "terminal" } to this
    if command = "editor.toggle", emit TogglePane { kind = "file" } to this
    if command = "terminal.new", emit NewTerminal { slot = "" } to this
    if command = "tab.newHere", emit NewHere to this
    if command = "ai.newTab", emit NewChatTab to this
    if command = "window.new", emit NewWindow to this
    if command = "menu.file", menu = { index = 0, item = 0 }
    if command = "menu.view", menu = { index = 1, item = 0 }
    if command = "menu.settings", menu = { index = 2, item = 0 }
    if command = "menu.help", menu = { index = 3, item = 0 }
    if command = "edit.outdent" and focus = "editor" and file ≠ null, emit EditorKey { name = "shift+tab", text = "" } to this
    if command = "edit.undo" and focus = "editor", emit Undo to this
    if command = "edit.redo" and focus = "editor", emit Redo to this
    if command = "ai.toggle", emit TogglePane { kind = "chat" } to this
    if command = "ai.configure", emit ConfigureAi to this
    if command = "ai.newChat"
        emit DropProposal to this
        if chat.agent ≠ null, emit Close { id = chat.agent.pty } to shells
        chat = chat + { turns = [], messages = [], input = "", queue = [], busy = false, request = -1, steps = 0, scroll = 0, checkpoints = [], agent = null, session = "", snapshot = null, changed = null }
        emit ShowChat to this
    if command = "ai.cancel", emit Unqueue to this
    if command = "ai.cancel" and chat.agent ≠ null
        emit Close { id = chat.agent.pty } to shells
        emit AgentFinished to this
        chat = chat + { turns = chat.turns + [{ role = "error", text = "Stopped." }] }
        return Ran
    if command = "ai.cancel" and chat.busy
        emit DropProposal to this
        chat = chat + { busy = false, request = -1, turns = chat.turns + [{ role = "error", text = "Stopped." }] }
    if command = "ai.undoTurn", emit UndoAiChanges to this
    if command = "ai.showChanges", emit ShowAiChanges to this
    if command[0, 8) = "ai.mode.", emit SetAgentMode { mode = command[8, length) } to this
    if command = "ai.goAhead", emit GoAhead to this
    if command = "ai.toggleMode", emit ToggleAgentMode to this
    if command = "ai.switchModel", emit OpenModelPicker to this
    if command = "terminal.scrollUp" or command = "terminal.scrollDown"
        emit Active { groups = groups, current = current } to this get scrolling
        if scrolling.buffer ≠ null and scrolling.buffer.kind = "terminal"
            scroll_id = scrolling.buffer.id
            back = terminal_scrolls["$scroll_id"]
            if back = null, back = 0
            page = rows - 4
            if page < 1, page = 1
            if command = "terminal.scrollUp", back += page
            if command = "terminal.scrollDown", back = back - page
            if back < 0, back = 0
            terminal_scrolls = terminal_scrolls + { "$scroll_id" = back }
    if command = "nav.back", emit GoSpot { step = -1 } to this
    if command = "nav.forward", emit GoSpot { step = 1 } to this
    if command = "help.keys", emit ShowShortcuts to this
    if command = "help.about", message = "codelovesme ide — a terminal IDE for code, built on euglena"
    return Ran

| The focused tab moved to the group in `into`. The explorer remembers a
| side it is moved to.
MoveCurrent { into } =>
    if slot_known[into] ≠ true
        message = "Error: no place called \"" + into + "\" — l r t b c tl tr bl br"
        return Failed
    emit Active { groups = groups, current = current } to this get moving
    emit Stash to this
    emit MoveTab { groups = groups, current = current, into = into } to this get moved
    groups = moved.groups
    current = moved.current
    emit Unstash to this
    if moving.buffer ≠ null and moving.buffer.kind = "explorer"
        explorer_slot = into
        if into = "l", emit StoreSetting { key = "workbench.sideBar.location", value = "left" } to this
        if into = "r", emit StoreSetting { key = "workbench.sideBar.location", value = "right" } to this
    if moving.buffer ≠ null and moving.buffer.kind = "chat", emit StoreSetting { key = "ai.chat.location", value = into } to this
    return Moved

| The explorer shown — its tab again if it is open, else a new one in the
| slot it was last in — and, when `focused`, given the keys.
ShowExplorer { focused } =>
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get where
    if where.group ≥ 0
        if focused, emit Reveal { group = where.group, tab = where.tab } to this
        return Shown
    keep = current
    emit Show { buffer = explorer_view, slot = explorer_slot } to this
    if not focused, emit FocusGroupAt { index = keep } to this
    if settings["workbench.sideBar.visible"] ≠ true, emit StoreSetting { key = "workbench.sideBar.visible", value = true } to this
    return Shown

HideExplorer =>
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get where
    if where.group < 0, return Nothing
    emit Stash to this
    emit CloseAt { groups = groups, current = current, group = where.group, tab = where.tab } to this get closed
    groups = closed.groups
    current = closed.current
    emit Unstash to this
    emit StoreSetting { key = "workbench.sideBar.visible", value = false } to this
    return Hidden

| View > Explorer on the Left / Right: moved there, and remembered.
PlaceExplorer { slot } =>
    explorer_slot = slot
    location = "left"
    if slot = "r", location = "right"
    emit StoreSetting { key = "workbench.sideBar.location", value = location } to this
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get where
    if where.group < 0, return Placed
    emit Reveal { group = where.group, tab = where.tab } to this
    emit MoveCurrent { into = slot } to this
    return Placed

| The tab at (`group`, `tab`) shown and focused.
Reveal { group, tab } =>
    emit Stash to this
    held = groups[group] + { active = tab }
    groups = groups[0, group) + [held] + groups(group, length)
    current = group
    emit Unstash to this
    return Revealed

FocusGroupAt { index } =>
    emit Length { value = groups } to core get { value as open_groups }
    if index < 0 or index ≥ open_groups, return Nothing
    emit Stash to this
    current = index
    emit Unstash to this
    return Focused

| The group in `slot` focused, if there is one.
FocusSlot { slot } =>
    emit GroupAt { groups = groups, slot = slot } to this get at
    if at.index < 0, return Nothing
    emit FocusGroupAt { index = at.index } to this
    return Focused

| F6: every group in slot order — top row, middle row, bottom — round again.
FocusNext =>
    order = []
    loop slot over slot_names
        emit GroupAt { groups = groups, slot = slot } to this get at
        if at.index ≥ 0, order += at.index
    emit Length { value = order } to core get { value as count }
    if count = 0, return Nothing
    next = order[0]
    loop i, index over order
        if index = current and i + 1 < count, next = order[i + 1]
    emit FocusGroupAt { index = next } to this
    return Focused

| Ctrl+K and an arrow: the edge of the focused group's side track moved
| that way — a group on the left grows with →, one at the bottom with ↑.
ResizeEdge { direction } =>
    group = groups[current]
    if group = null, return Nothing
    slot = group.slot
    left_side = slot = "l" or slot = "tl" or slot = "bl"
    right_side = slot = "r" or slot = "tr" or slot = "br"
    top_side = slot = "t" or slot = "tl" or slot = "tr"
    bottom_side = slot = "b" or slot = "bl" or slot = "br"
    | Which side track it is, and whether the arrow widens it (1) or not (-1).
    key = ""
    if left_side, key = "left"
    if right_side, key = "right"
    if (direction = "up" or direction = "down") and top_side, key = "top"
    if (direction = "up" or direction = "down") and bottom_side, key = "bottom"
    if (direction = "left" or direction = "right") and not left_side and not right_side, key = ""
    if (direction = "up" or direction = "down") and not top_side and not bottom_side, key = ""
    grows = { left = "right", right = "left", top = "down", bottom = "up" }
    change = -2
    if key ≠ "" and grows[key] = direction, change = 2
    if key = ""
        message = "The center grows as the sides shrink — resize a side instead"
        return Nothing
    size = sizes[key] + change
    if size < 3, size = 3
    emit StoreSetting { key = "workbench.layout." + key, value = size } to this
    return Resized

| Ctrl+`: a terminal — the first one if there is none (at the bottom); the
| keys back to the files if a terminal has them; else to the terminal.
ToggleTerminal =>
    emit Terminals { groups = groups } to this get open_terminals
    emit Length { value = open_terminals.ids } to core get { value as count }
    if count = 0
        emit NewTerminal { slot = "b" } to this
        return Toggled
    if focus = "terminal"
        emit FocusSlot { slot = "c" } to this get back
        if back ∉ Focused, emit FocusNext to this
        return Toggled
    emit FindTerminal { id = open_terminals.ids[0] } to this get where
    emit Reveal { group = where.group, tab = where.tab } to this
    return Toggled

| A new terminal: the shell in the open folder, as a tab in `slot` — or,
| with `slot` empty, beside the terminal that has the keys, else at the
| bottom.
NewTerminal { slot } =>
    emit RestorePane { kind = "terminal" } to this
    target = slot
    if target = ""
        target = "b"
        if focus = "terminal", target = groups[current].slot
    open_request = Open { cols = 80, rows = 12, cwd = folder }
    shell = settings["terminal.integrated.shell"]
    if shell ≠ "", open_request = open_request + { command = shell }
    emit open_request to shells get opened
    if opened ∈ Exception
        message = "Error: a terminal could not be opened: " + opened.message
        return Failed
    terminals_opened += 1
    view = { kind = "terminal", path = "Terminal " + terminals_opened, store = "terminal", id = opened.id }
    emit Show { buffer = view, slot = target } to this
    return Opened

| A key while the status bar is asking something.
PromptKey { name, text } =>
    asked = prompt
    | A command the AI wants to run: y runs it, n or Escape does not.
    if asked.kind = "ai_run"
        if name ≠ "y" and name ≠ "n" and name ≠ "escape", return Typed
        prompt = null
        emit InChat { id = asked.chat_id, particle = AnswerRun { yes = name = "y" } } to this
        return Answered
    if name = "escape"
        prompt = null
        return Cancelled
    if asked.kind = "open_folder" or asked.kind = "move" or asked.kind = "new_file"
        if name = "enter"
            prompt = null
            if asked.kind = "open_folder", emit OpenFolder { path = asked.text } to this
            if asked.kind = "new_file", emit CreateNewFile { dir = asked.dir, name = asked.text } to this
            if asked.kind = "move", emit MoveCurrent { into = asked.text } to this
            return Answered
        if name = "backspace"
            prompt = asked + { text = asked.text[0, length - 1) }
            return Typed
        if text ≠ "", prompt = asked + { text = asked.text + text }
        return Typed
    | The rest are "save first?" — y, n, or escape.
    if name ≠ "y" and name ≠ "n", return Typed
    prompt = null
    if name = "y" and asked.kind = "close"
        emit SaveFile to this get saved
        if saved ∉ Saved, return Cancelled
    if name = "y" and asked.kind = "quit"
        emit SaveAll to this get all_saved
        if all_saved ∉ Saved, return Cancelled
    if asked.kind = "close", emit CloseFile to this
    if asked.kind = "quit", emit Quit to this
    return Answered

| `path` absolute, or relative to the folder open now, or under `~`.
OpenFolder { path } =>
    target = path
    emit Get { name = "HOME", default = "/" } to vars get home
    if target = "~" or target[0, 2) = "~/", target = home.value + target[1, length)
    if target[0] ≠ "/", target = folder + "/" + target
    | fs only sees inside its base, so the check is made from the root —
    | Config would create a folder that is not there.
    emit Config { base_path = "/" } to files
    emit Exists { path = target } to files get there
    if not there.is_dir
        if folder ≠ "", emit Config { base_path = folder } to files
        message = "Error: not a folder: " + path
        return Failed { reason = message }
    emit Config { base_path = target } to files get configured
    if configured ∈ Exception
        message = "Error: " + configured.message
        return Failed { reason = message }
    emit ListDir { path = "." } to files get listing
    if listing ∈ Exception
        message = "Error: " + listing.message
        return Failed { reason = message }
    emit Children { entries = listing.entries, parent = "", depth = 0 } to this get kids
    folder = configured.base_path
    tree = kids.nodes
    tree_sel = 0
    tree_top = 0
    tree_picked = false
    | The files go; the explorer and the terminals stay where they are.
    emit Stash to this
    kept = []
    loop group over groups
        tabs = []
        loop tab over group.tabs
            if tab.kind ≠ "file", tabs += tab
        emit Length { value = tabs } to core get { value as left }
        if left > 0, kept += group + { tabs = tabs, active = 0 }
    groups = kept
    current = 0
    emit Unstash to this
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get explorer_at
    if explorer_at.group ≥ 0, emit Reveal { group = explorer_at.group, tab = explorer_at.tab } to this
    return Opened { folder = folder }

TreeKey { name } =>
    emit Length { value = tree } to core get { value as count }
    if count = 0, return Handled
    tree_picked = true
    if name = "down" and tree_sel < count - 1, tree_sel += 1
    if name = "up" and tree_sel > 0, tree_sel = tree_sel - 1
    if name = "home", tree_sel = 0
    if name = "end", tree_sel = count - 1
    if name = "pagedown"
        tree_sel = tree_sel + tree_page
        if tree_sel > count - 1, tree_sel = count - 1
    if name = "pageup"
        tree_sel = tree_sel - tree_page
        if tree_sel < 0, tree_sel = 0
    node = tree[tree_sel]
    wants_open = name = "enter" or name = "right" or name = "space"
    if node.is_dir and wants_open and not node.open
        emit ListDir { path = node.path } to files get listing
        if listing ∈ Exception
            message = "Error: " + listing.message
            return Handled
        emit Children { entries = listing.entries, parent = node.path, depth = node.depth + 1 } to this get kids
        emit Expand { nodes = tree, index = tree_sel, children = kids.nodes } to this get grown
        tree = grown.nodes
        return Handled
    if node.is_dir and node.open and (name = "enter" or name = "left")
        emit Collapse { nodes = tree, index = tree_sel } to this get shrunk
        tree = shrunk.nodes
        return Handled
    if name = "left"
        emit Parent { nodes = tree, index = tree_sel } to this get up
        tree_sel = up.index
        return Handled
    if not node.is_dir and (name = "enter" or name = "space")
        keep = current
        emit OpenFile { path = node.path } to this get opened
        | Space shows the file and leaves the keys in the explorer.
        if opened ∈ Opened and name = "space", emit FocusGroupAt { index = keep } to this
    return Handled

| Where a file opens: the focused group when it shows a file, else the
| center.
EditorSlot =>
    emit Active { groups = groups, current = current } to this get shown
    if shown.buffer ≠ null and shown.buffer.kind = "file", return Slot { slot = groups[current].slot }
    return Slot { slot = "c" }

| A file from the open folder, in its own tab — or its tab again, wherever
| it is, as it was left.
OpenFile { path } =>
    emit RestorePane { kind = "file" } to this
    emit Stash to this
    emit FindView { groups = groups, path = path, store = "workspace" } to this get found
    if found.group ≥ 0
        emit Reveal { group = found.group, tab = found.tab } to this
        return Opened
    emit ReadFile { path = path } to files get read
    if read ∈ Exception
        message = "Error: " + read.message
        return Failed
    emit Split { value = read.content, separator = "\n" } to texts get split
    emit EditorSlot to this get into
    emit Show { buffer = { kind = "file", path = path, store = "workspace", lines = split.value, row = 0, col = 0, want = 0, top = 0, left = 0, dirty = false, readonly = false }, slot = into.slot } to this
    return Opened

| `buffer` shown in the group in `slot`, in its tab, and focused.
Show { buffer, slot } =>
    emit Stash to this
    emit OpenIn { groups = groups, slot = slot, buffer = buffer } to this get opened_tab
    groups = opened_tab.groups
    current = opened_tab.current
    emit Unstash to this
    return Shown

| `file`, with its undo history, put back into its tab.
Stash =>
    if file = null, return Nothing
    emit NoteSpot to this
    emit PutActive { groups = groups, current = current, buffer = file + { undo = undo, redo = redo } } to this get put
    groups = put.groups
    return Stashed

| What the focused group shows decides what has the keys; a file is taken
| out of its tab to be worked on.
Unstash =>
    emit Active { groups = groups, current = current } to this get shown
    view = shown.buffer
    file = null
    undo = []
    redo = []
    last_edit = ""
    focus = "none"
    if view = null, return Unstashed
    if view.kind = "explorer", focus = "tree"
    if view.kind = "chat"
        focus = "chat"
        shown_chat = view.chat_id
        if shown_chat = null, shown_chat = "1"
        emit SwapChat { id = shown_chat } to this
    if view.kind = "diff", focus = "diff"
    if view.kind = "terminal"
        focus = "terminal"
        last_terminal = view.id
    if view.kind = "file"
        focus = "editor"
        file = view
        last_file = { path = view.path, store = view.store }
        if file.undo ≠ null, undo = file.undo
        if file.redo ≠ null, redo = file.redo
    return Unstashed

ShowShortcuts =>
    emit Shortcuts { table = keytable } to this get help
    emit EditorSlot to this get into
    emit Show { buffer = { kind = "file", path = "Keyboard Shortcuts", store = "help", lines = help.lines, row = 0, col = 0, want = 0, top = 0, left = 0, dirty = false, readonly = true }, slot = into.slot } to this
    return Shown

EditorKey { name, text } =>
    emit Edit { buffer = file, name = name, text = text, page = editor_page } to this get edited
    if edited ∈ Exception
        message = "Error: " + edited.message
        return Failed
    if not edited.changed
        last_edit = ""
        file = edited.buffer
        return Moved
    if file.readonly
        message = "This file is read-only."
        return Refused
    | Typing runs together into one undo step; every other edit is its own.
    kind = name
    if text ≠ "" and text ≠ " ", kind = "type"
    if not (kind = "type" and last_edit = "type")
        undo += { lines = file.lines, row = file.row, col = file.col }
        emit Length { value = undo } to core get { value as kept }
        if kept > max_undo, undo = undo[1, length)
    redo = []
    last_edit = kind
    file = edited.buffer + { dirty = true }
    emit NoteEdit to this
    return Changed

| Where the file was just edited, for the chat: `path:line`, the latest
| last, one entry a file.
NoteEdit =>
    if file.store ≠ "workspace", return Nothing
    kept = []
    loop place over recent
        emit Split { value = place, separator = ":" } to texts get parts
        if parts.value[0] ≠ file.path, kept += place
    kept += file.path + ":" + (file.row + 1)
    emit Length { value = kept } to core get { value as count }
    if count > 6, kept = kept[count - 6, count)
    recent = kept
    return Noted

| The open file's text replaced whole, as one edit (what a paste of
| everything would be).
SetLines { lines } =>
    if file = null or file.readonly, return Nothing
    undo += { lines = file.lines, row = file.row, col = file.col }
    file = file + { lines = lines, row = 0, col = 0, want = 0, dirty = true }
    last_edit = ""
    return Changed

Undo =>
    emit Length { value = undo } to core get { value as count }
    if file = null or count = 0, return Nothing
    redo += { lines = file.lines, row = file.row, col = file.col }
    file = file + undo[count - 1] + { dirty = true }
    file = file + { want = file.col }
    undo = undo[0, count - 1)
    last_edit = ""
    return Undone

Redo =>
    emit Length { value = redo } to core get { value as count }
    if file = null or count = 0, return Nothing
    undo += { lines = file.lines, row = file.row, col = file.col }
    file = file + redo[count - 1] + { dirty = true }
    file = file + { want = file.col }
    redo = redo[0, count - 1)
    last_edit = ""
    return Redone

| `buffer` written where it came from.
WriteBuffer { buffer } =>
    emit Join { value = buffer.lines, separator = "\n" } to texts get joined
    store = files
    if buffer.store = "prefs", store = prefs
    emit WriteFile { path = buffer.path, content = joined.value } to store get written
    if written ∈ Exception, return Failed { reason = written.message }
    return Written

SaveFile =>
    if file = null, return Nothing
    if file.readonly, return Nothing
    emit WriteBuffer { buffer = file } to this get written
    if written ∈ Failed
        message = "Error: " + written.reason
        return Failed
    file = file + { dirty = false }
    message = "Saved " + file.path
    | Saving settings.json is how an edit to it takes effect.
    if file.store = "prefs" and file.path = "settings.json"
        emit LoadSettings to this get loaded
        if loaded.problem = "", message = "Settings saved and applied"
    if file.store = "prefs" and file.path = "keybindings.json"
        emit LoadKeybindings to this get bindings
        if bindings.problem = "", message = "Keyboard shortcuts saved and applied"
    return Saved

| Every file with unsaved changes written — before exit, when asked.
SaveAll =>
    emit Stash to this
    emit WithHidden to this get everything
    loop group over everything.groups
        loop tab over group.tabs
            if tab.kind = "file" and tab.dirty
                emit WriteBuffer { buffer = tab } to this get written
                if written ∈ Failed
                    message = "Error: " + tab.path + ": " + written.reason
                    return Failed
    return Saved

RequestClose =>
    emit Active { groups = groups, current = current } to this get shown
    if shown.buffer = null, return Nothing
    if shown.buffer.kind = "terminal", emit Close { id = shown.buffer.id } to shells
    if shown.buffer.kind = "explorer"
        emit HideExplorer to this
        return Closed
    if file ≠ null and file.dirty
        prompt = { kind = "close", label = "Save changes to " + file.path + "? (y / n / Escape) ", text = "" }
        return Asked
    emit CloseFile to this
    return Closed

| The focused tab closed; its group goes when it was the last one there.
CloseFile =>
    emit Stash to this
    emit CloseTab { groups = groups, current = current } to this get closed
    groups = closed.groups
    current = closed.current
    emit Unstash to this
    return Closed

RequestQuit =>
    emit Stash to this
    emit WithHidden to this get everything
    emit Unsaved { groups = everything.groups } to this get unsaved
    if unsaved.count = 1
        prompt = { kind = "quit", label = "Save changes to " + unsaved.first + " before exit? (y / n / Escape) ", text = "" }
        return Asked
    if unsaved.count > 1
        prompt = { kind = "quit", label = "" + unsaved.count + " files have unsaved changes. Save them all before exit? (y / n / Escape) ", text = "" }
        return Asked
    emit Quit to this
    return Quitting

Quit =>
    running = false
    emit WithHidden to this get everything
    emit Terminals { groups = everything.groups } to this get open_terminals
    loop id over open_terminals.ids
        emit Close { id = id } to shells
    emit Stop {} to term
    return Quitting

| Where the settings are kept: `dir`/settings.json. Loads them.
SettingsAt { dir } =>
    emit Config { base_path = dir } to prefs get configured
    if configured ∈ Exception
        message = "Error: settings: " + configured.message
        return Failed
    settings_dir = configured.base_path
    emit LoadKeybindings to this
    emit LoadSettings to this get loaded
    return loaded

| keybindings.json read and turned into the key table. A missing file is
| the defaults; a bad entry is left out, and the status bar says why.
LoadKeybindings =>
    emit Exists { path = "keybindings.json" } to prefs get there
    text = null
    if there.is_file
        emit ReadFile { path = "keybindings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadBindings { text = text } to this get table
    keytable = table
    if table.problem ≠ "", message = "Error: " + table.problem
    return table

| settings.json read, checked and applied. A missing file is the defaults.
LoadSettings =>
    emit Exists { path = "settings.json" } to prefs get there
    text = null
    if there.is_file
        emit ReadFile { path = "settings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadSettings { text = text } to this get read_back
    settings = read_back.values
    if settings["workbench.sideBar.location"] = "right" and explorer_slot = "l", explorer_slot = "r"
    if settings["workbench.sideBar.location"] = "left" and explorer_slot = "r", explorer_slot = "l"
    sizes = {
        left = settings["workbench.layout.left"]
        right = settings["workbench.layout.right"]
        top = settings["workbench.layout.top"]
        bottom = settings["workbench.layout.bottom"]
    }
    if read_back.problem ≠ "", message = "Error: " + read_back.problem
    return read_back

| One setting changed from inside the ide (Ctrl+B, moving or resizing the
| explorer): applied, and written to settings.json — which, if it is open
| and unedited, shows the change too.
StoreSetting { key, value } =>
    settings = settings + { "$key" = value }
    emit WriteSettings { values = settings } to this get written_text
    emit WriteFile { path = "settings.json", content = written_text.text } to prefs get written
    if written ∈ Exception
        message = "Error: settings could not be saved: " + written.message
    emit LoadSettings to this
    if file ≠ null and file.store = "prefs" and file.path = "settings.json" and not file.dirty
        emit Split { value = written_text.text, separator = "\n" } to texts get fresh
        file = file + { lines = fresh.value }
    return Stored

| settings.json (Ctrl+,) or keybindings.json in the editor, made first if
| there is none yet.
OpenPrefsFile { name } =>
    emit Exists { path = name } to prefs get there
    if not there.is_file
        first_text = "[\n]\n"
        if name = "settings.json"
            emit WriteSettings { values = settings } to this get written_settings
            first_text = written_settings.text
        emit WriteFile { path = name, content = first_text } to prefs
    emit ReadFile { path = name } to prefs get read
    if read ∈ Exception
        message = "Error: " + read.message
        return Failed
    emit Split { value = read.content, separator = "\n" } to texts get split
    emit EditorSlot to this get into
    emit Show { buffer = { kind = "file", path = name, store = "prefs", lines = split.value, row = 0, col = 0, want = 0, top = 0, left = 0, dirty = false, readonly = false }, slot = into.slot } to this
    return Opened

| Everything the screen is drawn from, in one particle.
State =>
    emit Stash to this
    picker_rows = null
    if picker ≠ null
        emit PickerRows to this get rows_now
        picker_rows = rows_now
    return IdeState {
        groups = groups
        current = current
        cols = cols
        rows = rows
        folder = folder
        tree = tree
        tree_sel = tree_sel
        tree_top = tree_top
        file = file
        focus = focus
        menu = menu
        picker = picker
        picker_rows = picker_rows
        terminal_scrolls = terminal_scrolls
        prompt = prompt
        message = message
        sizes = sizes
        keytable = keytable
        chat = chat
        chat_id = chat_id
        chats = chats
        chat_notice = chat_notice
        chat_label = chat_label
        ai_status = ai_status
        settings = settings
    }

| The screen of every terminal a group shows, each told first how big it
| is when that changed.
TerminalScreens { placed } =>
    screens = {}
    loop pane over placed
        group = groups[pane.id]
        view = group.tabs[group.active]
        if view.kind = "terminal"
            wide = pane.width - 1
            if pane.x = 0, wide = pane.width
            high = pane.height - 1
            size = "" + wide + "x" + high
            if terminal_sizes["$view.id"] ≠ size and wide > 0 and high > 0
                emit Resize { id = view.id, cols = wide, rows = high } to shells
                terminal_sizes = terminal_sizes + { "$view.id" = size }
            back = terminal_scrolls["$view.id"]
            if back = null, back = 0
            emit Screen { id = view.id, scroll = back } to shells get screen
            | Scrolled no further than there was.
            if screen ∉ Exception, terminal_scrolls = terminal_scrolls + { "$view.id" = screen.scrolled }
            if screen ∉ Exception, screens = screens + { "$view.id" = screen }
    return Screens { screens = screens }

Render =>
    if not running, return Skipped
    emit ChatNotice to this
    emit State to this get state
    emit Placement { state = state } to this get placement
    emit TerminalScreens { placed = placement.placed } to this get terminal_screens
    emit Frame { state = state, placement = placement, screens = terminal_screens.screens } to this get screen
    if screen ∈ Exception
        emit Draw { rows = [[{ text = " Error: the screen could not be drawn: " + screen.message, style = "status_warn" }]] } to term
        return Failed
    tree_top = screen.tree_top
    tree_page = screen.tree_page
    editor_page = screen.page
    if screen.chat ≠ null
        chat_page = screen.chat.page
        chat = chat + { scroll = screen.chat.scroll }
    | Each group keeps how far its file was scrolled.
    loop scrolled_view over screen.views
        i = scrolled_view.group
        if i = current and file ≠ null, file = file + { top = scrolled_view.top, left = scrolled_view.left }
        if i ≠ current
            shown = groups[i].tabs[groups[i].active]
            emit PutActive { groups = groups, current = i, buffer = shown + { top = scrolled_view.top, left = scrolled_view.left } } to this get scrolled
            groups = scrolled.groups
    emit Draw { overlays = screen.overlays, cursor_row = screen.cursor_row, cursor_col = screen.cursor_col } to term
    return Rendered


| ── The AI chat ────────────────────────────────────────────────────────

| Ctrl+L: the chat — opened where it was last (settings: ai.chat.location)
| if it is not; the keys back to the files if it has them; else to it.
ToggleChat =>
    emit ChatTab { id = chat_id } to this get this_chat
    emit FindView { groups = groups, path = this_chat.path, store = this_chat.store } to this get where
    if where.group ≥ 0 and focus = "chat"
        emit FocusSlot { slot = "c" } to this get back
        if back ∉ Focused, emit FocusNext to this
        return Toggled
    emit ShowChat to this
    return Toggled

| The chat shown and given the keys.
ShowChat =>
    emit ChatTab { id = chat_id } to this get this_chat
    emit FindView { groups = groups, path = this_chat.path, store = this_chat.store } to this get where
    if where.group ≥ 0
        emit Reveal { group = where.group, tab = where.tab } to this
        return Shown
    emit Show { buffer = this_chat, slot = settings["ai.chat.location"] } to this
    return Shown

| Settings > AI Model…: settings.json, with the `ai.*` settings written
| into it if they are not there yet.
ConfigureAi =>
    emit StoreSetting { key = "ai.providers", value = settings["ai.providers"] } to this
    emit OpenPrefsFile { name = "settings.json" } to this
    message = "ai.providers.local is LocalAI at http://localhost:8080; change its endpoint and model if yours differ, then save"
    return Opened

ChatNotice =>
    emit ProviderFor { settings = settings } to this get provider
    chat_notice = provider.problem
    chat_label = ""
    ai_status = ""
    shown_model = provider.model
    if provider.models ≠ null
        loop one over provider.models
            if one ∈ Object and one["id"] = provider.model and one["name"] ∈ String, shown_model = one["name"]
    shown_modes = { ask = "Ask", plan = "Plan", edit = "Edit", auto = "Auto" }
    mode = shown_modes[settings["ai.agent.mode"]]
    if provider.problem = "" and provider.runner = "cli"
        ai_status = provider.title
        if provider.model ≠ "", ai_status = ai_status + " · " + shown_model
        if provider.effort ≠ "", ai_status = ai_status + " · " + provider.effort
        chat_label = ai_status + " · " + mode + " (Alt+E) · Alt+M: switch"
        ai_status = ai_status + " · " + mode
    if provider.problem = "" and provider.runner = "api"
        ai_status = provider.name
        if provider.model ≠ "", ai_status = ai_status + " · " + provider.model
        chat_label = ai_status + " · " + mode + " (Alt+E) · Alt+M: switch"
        ai_status = ai_status + " · " + mode
    return Noted

| A key in the chat: Escape gives the keys back to the files, Ctrl+C stops
| the model; the rest are the input box's (chatbox.gene.code).
ChatKey { name, text } =>
    if name = "escape"
        emit FocusSlot { slot = "c" } to this get back
        if back ∉ Focused, emit FocusNext to this
        return Handled
    if name = "ctrl+c"
        emit Run { command = "ai.cancel" } to this
        return Handled
    emit ChatInput { input = chat.input, caret = chat.caret, name = name, text = text, page = chat_page } to this get typed
    | ↑ on the first line, ↓ on the last: the questions asked before.
    if typed.edge
        step = -1
        if name = "down", step = 1
        emit Recall { history = questions, at = recall_at, input = chat.input, draft = recall_draft, step = step } to this get recalled
        recall_at = recalled.at
        recall_draft = recalled.draft
        chat = chat + { input = recalled.input, caret = null }
        return Handled
    scroll = chat.scroll + typed.scroll
    if scroll < 0, scroll = 0
    chat = chat + { input = typed.input, caret = typed.caret, scroll = scroll }
    if typed.send ≠ null
        emit Length { value = questions } to core get { value as asked_count }
        if asked_count = 0 or questions[asked_count - 1] ≠ typed.send
            questions += typed.send
            asked_count += 1
        recall_at = asked_count
        recall_draft = ""
    if typed.send ≠ null, emit AskAbout { question = typed.send } to this
    return Handled

| A question: what the user is looking at and what they @-mention go with
| it, and the project's instructions and map go in the system message.
AskAbout { question } =>
    if chat.busy
        emit Length { value = chat.queue } to core get { value as queued_count }
        if queued_count ≥ queue_most
            message = "" + queue_most + " questions are waiting already — this one stays in the box until the AI takes the next"
            chat = chat + { input = question, caret = null }
            return Busy
        chat = chat + { queue = chat.queue + [question] }
        message = "Queued (" + (queued_count + 1) + " of " + queue_most + ") — asked when the AI is done; Ctrl+C puts them back in the box"
        return Queued
    chat = chat + { turns = chat.turns + [{ role = "user", text = question }], scroll = 0 }
    emit ProviderFor { settings = settings } to this get provider
    if provider.problem ≠ ""
        chat = chat + { turns = chat.turns + [{ role = "error", text = provider.problem }] }
        return Failed
    emit Budget { context_tokens = provider.context_tokens, max_tokens = provider.max_tokens } to this get budget
    emit ShownFile to this get shown
    emit GatherContext { question = question, shown = shown.file, budget = budget } to this get gathered
    if provider.runner = "cli"
        emit AskAgent { provider = provider, question = question, context = gathered.text } to this get started
        return started
    emit ProjectKnowledge { shown = shown.file, budget = budget } to this get system
    | Earlier questions keep only their words: what was on screen then is
    | old news, and the room is the conversation's.
    earlier = []
    loop m over chat.messages
        if m.short ≠ null, earlier += { role = m.role, content = m.short }
        if m.short = null, earlier += m
    emit ModeNote { mode = settings["ai.agent.mode"] } to this get mode_note
    asked = { role = "user", content = gathered.text + "\n# The question\n" + question + "\n\n" + mode_note.text, short = question }
    chat = chat + { messages = earlier + [asked], steps = 0, system = system.text, budget = budget, checkpoints = [] }
    emit AskModel to this
    return Asked

| The file the user looks at: the focused one, else the one shown last,
| as its tab has it now.
ShownFile =>
    if file ≠ null and file.store = "workspace", return ShownFileIs { file = file }
    if last_file = null or last_file.store ≠ "workspace", return ShownFileIs { file = null }
    emit FindView { groups = groups, path = last_file.path, store = last_file.store } to this get at
    if at.group < 0, return ShownFileIs { file = null }
    return ShownFileIs { file = groups[at.group].tabs[at.tab] }

| Part 1 of the context (context.gene.code), and what `question` mentions
| with `@` attached.
GatherContext { question, shown, budget } =>
    names = []
    loop group over groups
        loop tab over group.tabs
            names += tab.path
    emit TerminalText { lines = 40 } to this get terminal
    emit RunQuiet { command = "git", args = ["status", "--short", "--branch"] } to this get git
    emit Clip { text = git.text, chars = 3000 } to this get git_short
    emit Ambient { file = shown, focus = focus, tabs = names, recent = recent, terminal = terminal.text, git = git_short.text } to this get ambient
    emit Clip { text = ambient.text, chars = budget.ambient } to this get out
    text = out.text
    emit Mentions { input = question } to this get mentioned
    loop name over mentioned.mentions
        emit Attachment { name = name, shown = shown } to this get attached
        emit Clip { text = attached.text, chars = budget.tool } to this get cut
        if cut.text ≠ "", text = text + "\n# Attached: @" + name + "\n" + cut.text + "\n"
    return Text { text = text }

| What `@name` brings: the terminal, git's diff, the open file, the
| folder, or a file or folder by its path.
Attachment { name, shown } =>
    if name = "terminal"
        emit TerminalText { lines = 200 } to this get more
        return Text { text = "```\n" + more.text + "\n```" }
    if name = "git"
        emit RunTool { tool = "git_diff", args = {} } to this get diff
        return diff
    if name = "file"
        if shown = null, return Text { text = "(no file is open)" }
        emit Length { value = shown.lines } to core get { value as count }
        emit Numbered { lines = shown.lines, first = 1, last = count } to this get whole
        return Text { text = shown.path + ":\n```\n" + whole.text + "\n```" }
    if name = "folder"
        emit RunTool { tool = "list_dir", args = { path = "." } } to this get listed
        return listed
    emit SafePath { path = name } to this get safe
    if not safe.ok, return Text { text = "" }
    emit Exists { path = safe.path } to files get there
    if there ∈ Exception, return Text { text = "" }
    if there.is_dir
        emit RunTool { tool = "list_dir", args = { path = safe.path } } to this get listed
        return listed
    if there.is_file
        emit RunTool { tool = "read_file", args = { path = safe.path, from = 1, "to" = 2000 } } to this get read
        return read
    return Text { text = "" }

| The terminal shown last (else the first open), as its last `lines`.
TerminalText { lines } =>
    id = last_terminal
    if id < 0
        emit Terminals { groups = groups } to this get open_terminals
        if open_terminals.ids[0] = null, return Text { text = "" }
        id = open_terminals.ids[0]
    emit FindTerminal { id = id } to this get where
    if where.group < 0, return Text { text = "" }
    emit Screen { id = id } to shells get screen
    if screen ∈ Exception, return Text { text = "" }
    emit ScreenText { screen = screen, last = lines } to this get shown
    return shown

| A command's output, run in the open folder; "" when it fails.
RunQuiet { command, args } =>
    emit Run { command = command, args = args, cwd = folder } to procs get ran
    if ran ∈ Exception or not ran.success, return Text { text = "" }
    emit Trim { value = ran.stdout } to texts get out
    return Text { text = out.value }

outline_patterns = [
    "^[A-Z][A-Za-z0-9]* *(\\{.*\\})? *=>"
    "^\\s*(pub(\\([a-z]+\\))? )?(export )?(default )?(async )?(fn|struct|enum|trait|impl|mod|class|def|function|interface|type|func) [A-Za-z_]"
]

| Parts 2 and 3: the project's instructions and its map, in the system
| message (context.gene.code).
ProjectKnowledge { shown, budget } =>
    path = null
    if shown ≠ null, path = shown.path
    emit InstructionPaths { path = path } to this get candidates
    found = ""
    loop candidate over candidates.paths
        emit Exists { path = candidate } to files get there
        if there ∉ Exception and there.is_file
            emit ReadFile { path = candidate } to files get read
            if read ∉ Exception, found = found + "## " + candidate + "\n" + read.content + "\n\n"
    emit Clip { text = found, chars = budget.instructions } to this get instructions
    emit RunQuiet { command = "rg", args = ["--files", "--no-ignore-parent", "--sort", "path", "."] } to this get listed
    listing = listed.text
    if listing = ""
        emit RunQuiet { command = "git", args = ["ls-files"] } to this get tracked
        listing = tracked.text
    if listing = ""
        emit RunQuiet { command = "find", args = [".", "-type", "f", "-not", "-path", "*/.git/*", "-not", "-path", "*/node_modules/*", "-not", "-path", "*/target/*"] } to this get walked
        listing = walked.text
    outline_args = ["--no-ignore-parent", "-n", "--no-heading", "--with-filename", "--color", "never", "--sort", "path", "--max-count", "40", "--max-columns", "160", "-g", "!*.lock", "-g", "!*.json", "-g", "!*.min.*"]
    loop pattern over outline_patterns
        outline_args = outline_args + ["-e", pattern]
    | A path is given: with none, rg would search its (empty) input.
    emit RunQuiet { command = "rg", args = outline_args + ["."] } to this get outline
    outlined = outline.text
    | Without ripgrep, grep (it has no .gitignore, so the usual heavy
    | folders are left out by name).
    if outlined = ""
        grep_args = ["-rnIE", "--exclude-dir=.git", "--exclude-dir=node_modules", "--exclude-dir=target", "--exclude-dir=dist", "--exclude-dir=build", "--exclude=*.json", "--exclude=*.lock", "-m", "40"]
        loop pattern over outline_patterns
            grep_args = grep_args + ["-e", pattern]
        emit RunQuiet { command = "grep", args = grep_args + ["."] } to this get grepped
        outlined = grepped.text
    emit RepoMap { files = listing, outline = outlined, chars = budget.map } to this get map
    emit SystemPrompt { folder = folder, instructions = instructions.text, map = map.text } to this get system
    return system

| The conversation sent to the model the settings name — set up first if
| that changed. The reply comes back later, as `ChatResult`.
AskModel =>
    emit ProviderFor { settings = settings } to this get provider
    if provider.problem ≠ ""
        emit ChatFailed { text = provider.problem } to this
        return Failed
    key = ""
    if provider.api_key_env ≠ ""
        emit Get { name = provider.api_key_env, default = "" } to vars get from_env
        key = from_env.value
    emit ProviderConfig { provider = provider, api_key = key } to this get config
    target = models[provider.organelle]
    if config.key ≠ model_key
        emit config.particle to target get configured
        if configured ∈ Exception
            emit ChatFailed { text = "The model could not be set up: " + configured.message } to this
            return Failed
        model_key = config.key
    emit TrimMessages { messages = chat.messages, chars = chat.budget.conversation } to this get kept
    sending = [{ role = "system", content = chat.system }]
    loop m over kept.messages
        sending += { role = m.role, content = m.content }
    emit ProviderChat { provider = provider, messages = sending } to this get call
    emit call.particle to target get sent
    if sent ∈ Exception
        emit ChatFailed { text = "The model could not be asked: " + sent.message } to this
        return Failed
    chat = chat + { busy = true, request = sent.value }
    return Asked

ChatFailed { text } =>
    chat = chat + { busy = false, request = -1, turns = chat.turns + [{ role = "error", text = text }] }
    return Failed

| The AI is done: the next question waiting is asked (and, if that fails
| at once, the one after).
SendQueued =>
    loop
        if chat.busy or chat.queue = [], break
        next_question = chat.queue[0]
        emit Length { value = chat.queue } to core get { value as queued_count }
        chat = chat + { queue = chat.queue[1, queued_count) }
        emit AskAbout { question = next_question } to this
    return Sent

| The conversation `id` made the one in `chat`; the one there waits in
| `chats`. An id never seen starts empty.
SwapChat { id } =>
    if id = chat_id, return Same
    chats = chats + { "$chat_id" = chat }
    swapped_in = chats[id]
    if swapped_in = null, swapped_in = empty_chat
    chat = swapped_in
    chat_id = id
    return Swapped

| Which conversation asked `request` (the model's reply) or runs its
| agent in terminal `pty`: its id, or "".
ChatOwner { request, pty } =>
    if request ≠ null and request ≠ -1 and chat.request = request, return Owner { id = chat_id }
    if pty ≠ null and chat.agent ≠ null and chat.agent.pty = pty, return Owner { id = chat_id }
    loop owner_id, one over chats
        if owner_id ≠ chat_id
            if request ≠ null and request ≠ -1 and one.request = request, return Owner { id = owner_id }
            if pty ≠ null and one.agent ≠ null and one.agent.pty = pty, return Owner { id = owner_id }
    return Owner { id = "" }

| `particle` handled with conversation `id` in `chat` — its next queued
| question sent if it is done — and then the one before put back (or the
| one whose tab is in front now).
InChat { id, particle } =>
    was_chat = chat_id
    emit SwapChat { id = id } to this
    emit particle to this get done
    emit SendQueued to this
    | The keys stay with the conversation of the tab in front, if it is one.
    emit Active { groups = groups, current = current } to this get in_front
    if in_front.buffer ≠ null and in_front.buffer.kind = "chat"
        was_chat = in_front.buffer.chat_id
        if was_chat = null, was_chat = "1"
    emit SwapChat { id = was_chat } to this
    return done

| The tab of conversation `id`.
ChatTab { id } =>
    if id = "1", return chat_view + { _class = "ChatTab" }
    return chat_view + { _class = "ChatTab", path = "AI Chat " + id, chat_id = id }

| Ctrl+T in the chat: another conversation, in a tab of its own beside it.
NewChatTab =>
    chats_opened += 1
    new_id = "" + chats_opened
    emit ChatTab { id = new_id } to this get new_tab
    into = settings["ai.chat.location"]
    if focus = "chat", into = groups[current].slot
    emit Show { buffer = new_tab, slot = into } to this
    return Opened

| Ctrl+T: another of what has the keys — a terminal, an AI chat.
NewHere =>
    if focus = "terminal"
        emit NewTerminal { slot = "" } to this
        return Opened
    if focus = "chat"
        emit NewChatTab to this
        return Opened
    message = "Ctrl+T opens another terminal in a terminal, another AI chat in the chat"
    return Nothing

| Ctrl+Shift+N: another ide, in a window of its own, on the same folder.
NewWindow =>
    script = "if [ -x ./ide ]; then l=\"\$(pwd)/ide\"; else l=\$(command -v ide || echo \"\$HOME/.local/bin/ide\"); fi; c=\$(command -v cdlvsm-console || echo \"\$HOME/.local/bin/cdlvsm-console\"); if [ -x \"\$c\" ]; then setsid -f \"\$c\" -e \"\$l\" \"\$0\"; elif command -v gnome-terminal >/dev/null; then setsid -f gnome-terminal -- \"\$l\" \"\$0\"; else setsid -f x-terminal-emulator -e \"\$l\" \"\$0\"; fi >/dev/null 2>&1"
    emit Run { command = "/bin/sh", args = ["-c", script, folder] } to procs get launched
    if launched ∈ Exception or not launched.success
        message = "Another window could not be opened"
        return Failed
    message = "Another ide is opening on " + folder
    return Opened

| Ctrl+C: the questions waiting go back into the box, after what is in it.
Unqueue =>
    if chat.queue = [], return Nothing
    parts = chat.queue
    if chat.input ≠ "", parts = [chat.input] + parts
    emit Join { value = parts, separator = "\n" } to texts get joined
    chat = chat + { input = joined.value, caret = null, queue = [] }
    return Unqueued

| The model's reply: a tool to run — its result goes back, and the model is
| asked again — or the answer.
ChatResult { content, _request_id } =>
    emit ChatOwner { request = _request_id, pty = null } to this get owner
    if owner.id = "", return Ignored
    emit InChat { id = owner.id, particle = TakeReply { content = content, reply_to = _request_id } } to this get took
    if running, emit Render to this
    return took

| The reply itself (see ChatResult).
TakeReply { content, reply_to } =>
    if reply_to ≠ chat.request, return Ignored
    emit ReadReply { content = content } to this get reply
    chat = chat + { messages = chat.messages + [{ role = "assistant", content = content }] }
    if reply.tool = null
        chat = chat + { busy = false, request = -1, turns = chat.turns + [{ role = "assistant", text = reply.answer }] }
        emit OfferPlan to this
        return Answered
    max_steps = settings["ai.maxSteps"]
    if chat.steps ≥ max_steps
        emit ChatFailed { text = "The model was still looking after " + max_steps + " steps (settings: ai.maxSteps) — ask again, more narrowly" } to this
        return Failed
    chat = chat + { steps = chat.steps + 1 }
    changes = reply.tool = "edit_file" or reply.tool = "create_file" or reply.tool = "run_command"
    looking_only = settings["ai.agent.mode"] = "ask" or settings["ai.agent.mode"] = "plan"
    if changes and looking_only
        refused = "Not in " + settings["ai.agent.mode"] + " mode: nothing is changed or run. Answer instead — in plan mode, with the plan."
        chat = chat + { turns = chat.turns + [{ role = "tool", text = reply.tool + ": not in " + settings["ai.agent.mode"] + " mode" }] }
        emit ToolDone { tool = reply.tool, text = refused } to this
        return Stepped
    if changes
        emit Propose { tool = reply.tool, args = reply.args } to this get proposed
        if proposed ∈ AutoDone
            return Stepped
        if proposed ∈ Waiting
            chat = chat + { request = -1 }
            return Waiting
        chat = chat + { turns = chat.turns + [{ role = "tool", text = reply.tool + ": " + proposed.text }] }
        emit ToolDone { tool = reply.tool, text = proposed.text } to this
        return Stepped
    emit ToolLine { tool = reply.tool, args = reply.args } to this get line
    chat = chat + { turns = chat.turns + [{ role = "tool", text = line.text }] }
    emit RunTool { tool = reply.tool, args = reply.args } to this get result
    emit ToolDone { tool = reply.tool, text = result.text } to this
    return Stepped

| A tool's result back to the model, which is asked again.
ToolDone { tool, text } =>
    emit Clip { text = text, chars = chat.budget.tool } to this get cut
    note = "Result of " + tool + ":\n" + cut.text
    if chat.steps ≥ settings["ai.maxSteps"], note = note + "\n\nThat was the last step: answer now, with what you have."
    chat = chat + { messages = chat.messages + [{ role = "user", content = note }] }
    emit AskModel to this
    return Sent

| The model could not be reached (the organelle's `later` failure).
Exception { source, message as failure, _request_id } =>
    emit ChatOwner { request = _request_id, pty = null } to this get owner
    if _request_id = null or owner.id = "", return Ignored
    emit InChat { id = owner.id, particle = ChatFailed { text = "The model did not answer: " + failure } } to this
    if running, emit Render to this
    return Failed

| A tool the model asked for, run on the open folder. Answers `Text`:
| what it found, or why it could not.
RunTool { tool, args } =>
    if tool = "list_dir"
        emit SafePath { path = args["path"] } to this get safe
        if not safe.ok, return Text { text = "Not allowed: paths stay inside the project folder." }
        emit ListDir { path = safe.path } to files get listing
        if listing ∈ Exception, return Text { text = "Error: " + listing.message }
        names = []
        loop entry over listing.entries
            if entry.is_dir, names += entry.name + "/"
            if not entry.is_dir, names += entry.name
        emit Join { value = names, separator = "\n" } to texts get joined
        return Text { text = joined.value }
    if tool = "read_file"
        emit SafePath { path = args["path"] } to this get safe
        if not safe.ok, return Text { text = "Not allowed: paths stay inside the project folder." }
        emit FileLines { path = safe.path } to this get held
        if held ∈ Text, return held
        lines = held.lines
        emit Length { value = lines } to core get { value as count }
        from = args["from"]
        if from ∉ Number or from < 1, from = 1
        to_line = args["to"]
        if to_line ∉ Number or to_line < from, to_line = from + 299
        if to_line > from + 299, to_line = from + 299
        if to_line > count, to_line = count
        emit Numbered { lines = lines, first = from, last = to_line } to this get numbered
        return Text { text = safe.path + " (" + count + " lines), lines " + from + "–" + to_line + ":\n" + numbered.text }
    if tool = "grep"
        pattern = args["pattern"]
        if pattern ∉ String or pattern = "", return Text { text = "grep needs a \"pattern\"." }
        where = "."
        if args["path"] ≠ null
            emit SafePath { path = args["path"] } to this get safe
            if not safe.ok, return Text { text = "Not allowed: paths stay inside the project folder." }
            where = safe.path
        search = ["--no-ignore-parent", "-n", "--no-heading", "--with-filename", "--color", "never", "-S", "--max-count", "20", "--max-columns", "200"]
        if args["glob"] ∈ String and args["glob"] ≠ "", search = search + ["-g", args["glob"]]
        emit Run { command = "rg", args = search + ["-e", pattern, where], cwd = folder } to procs get searched
        found = searched
        if searched ∈ Exception
            emit Run { command = "grep", args = ["-rnIE", "--exclude-dir=.git", "--exclude-dir=node_modules", "--exclude-dir=target", "-e", pattern, where], cwd = folder } to procs get grepped
            if grepped ∈ Exception, return Text { text = "Error: " + grepped.message }
            found = grepped
        if found.code = 1, return Text { text = "No matches." }
        if not found.success, return Text { text = "Error: " + found.stderr }
        emit FirstLines { text = found.stdout, count = 60 } to this get first
        return first
    if tool = "find_files"
        name = args["name"]
        if name ∉ String or name = "", return Text { text = "find_files needs a \"name\"." }
        emit RunQuiet { command = "rg", args = ["--files", "--no-ignore-parent", "--sort", "path", "--iglob", "*" + name + "*", "."] } to this get found
        listing = found.text
        if listing = ""
            emit RunQuiet { command = "find", args = [".", "-iname", "*" + name + "*", "-not", "-path", "*/.git/*"] } to this get looked
            listing = looked.text
        if listing = "", return Text { text = "No files match." }
        emit FirstLines { text = listing, count = 100 } to this get first
        return first
    if tool = "git_diff"
        diff_args = ["diff"]
        if args["path"] ≠ null
            emit SafePath { path = args["path"] } to this get safe
            if not safe.ok, return Text { text = "Not allowed: paths stay inside the project folder." }
            diff_args = diff_args + ["--", safe.path]
        emit RunQuiet { command = "git", args = diff_args } to this get diff
        if diff.text = "", return Text { text = "No changes (or not a git repository)." }
        return diff
    return Text { text = "There is no tool called \"" + tool + "\". The tools: list_dir, read_file, grep, find_files, git_diff." }


| A file's lines as the user has them: an open file as the editor holds
| it, unsaved changes and all; else from the disk. `Text` when it cannot
| be read.
FileLines { path } =>
    if file ≠ null and file.store = "workspace" and file.path = path, return Lines { lines = file.lines }
    emit FindView { groups = groups, path = path, store = "workspace" } to this get open_at
    if open_at.group ≥ 0, return Lines { lines = groups[open_at.group].tabs[open_at.tab].lines }
    emit ReadFile { path = path } to files get read
    if read ∈ Exception, return Text { text = "Error: " + read.message }
    emit Split { value = read.content, separator = "\n" } to texts get split
    return Lines { lines = split.value }

| ── Changes the AI proposes ────────────────────────────────────────────
|
| An edit or a new file opens as a diff tab (kind `diff`) beside the files;
| a command is asked about in the status bar. The model waits for the
| answer (`chat.pending`), and is told it.

| `Waiting` when the user has been asked, else `Text`: why it could not be
| proposed, for the model to try again.
Propose { tool, args } =>
    if tool = "run_command"
        command = args["command"]
        if command ∉ String or command = "", return Text { text = "run_command needs a \"command\"." }
        chat = chat + { pending = { tool = tool, command = command } }
        if settings["ai.agent.mode"] = "auto"
            emit AnswerRun { yes = true } to this
            return AutoDone
        prompt = { kind = "ai_run", chat_id = chat_id, label = "Run for the AI: " + command + "  — y / n ", text = "" }
        chat = chat + { turns = chat.turns + [{ role = "tool", text = "wants to run: " + command + " (y / n in the status bar)" }] }
        return Waiting
    emit SafePath { path = args["path"] } to this get safe
    if not safe.ok or safe.path = ".", return Text { text = "Not allowed: paths stay inside the project folder." }
    old = []
    created = tool = "create_file"
    new_text = ""
    if created
        emit Exists { path = safe.path } to files get there
        if there ∉ Exception and (there.is_file or there.is_dir), return Text { text = safe.path + " is there already — use edit_file." }
        new_text = args["content"]
        if new_text ∉ String, return Text { text = "create_file needs a \"content\"." }
    if not created
        find = args["find"]
        replace = args["replace"]
        if find ∉ String or find = "" or replace ∉ String, return Text { text = "edit_file needs \"find\" and \"replace\"." }
        emit FileLines { path = safe.path } to this get held
        if held ∈ Text, return held
        old = held.lines
        emit Join { value = old, separator = "\n" } to texts get joined
        emit Occurrences { text = joined.value, part = find } to this get where
        if where.count = 0, return Text { text = "`find` is not in " + safe.path + ". Read the lines again and copy them exactly, without the line numbers." }
        if where.count > 1, return Text { text = "`find` is in " + safe.path + " " + where.count + " times. Take more lines, so it is found once." }
        emit Length { value = find } to core get { value as find_size }
        new_text = joined.value[0, where.at) + replace + joined.value[where.at + find_size, length)
    emit Split { value = new_text, separator = "\n" } to texts get split
    emit DiffLines { old = old, new = split.value, around = 3 } to this get diff
    view = { kind = "diff", path = safe.path + " ±", store = "ai", chat_id = chat_id, target = safe.path, created = created, lines = split.value, diff = diff.lines, removed = diff.removed, added = diff.added, top = 0 }
    | Auto: made at once, and said.
    if settings["ai.agent.mode"] = "auto"
        emit ApplyChange { view = view } to this get applied
        if applied ∈ Text, return applied
        chat = chat + { turns = chat.turns + [{ role = "tool", text = "changed " + safe.path + " (−" + diff.removed + " +" + diff.added + "; View > Undo AI Changes puts it back)" }] }
        return Text { text = safe.path + " is changed and saved." }
    emit EditorSlot to this get into
    emit Show { buffer = view, slot = into.slot } to this
    chat = chat + { pending = { tool = tool, path = safe.path } }
    what = "proposes a change to " + safe.path
    if created, what = "proposes a new file, " + safe.path
    chat = chat + { turns = chat.turns + [{ role = "tool", text = what + " (−" + diff.removed + " +" + diff.added + ") — a to accept, r to reject, in its tab" }] }
    message = "The AI proposes a change: a accepts, r rejects"
    return Waiting

| A key on a proposed change: a / y / Enter accept it, r / n / Escape
| reject it; the arrows and PgUp/PgDn scroll.
DiffKey { name } =>
    emit Active { groups = groups, current = current } to this get looking
    if looking.buffer ≠ null and looking.buffer.reviewed = true and (name = "escape" or name = "q")
        emit Stash to this
        emit CloseTab { groups = groups, current = current } to this get closed_review
        groups = closed_review.groups
        current = closed_review.current
        emit Unstash to this
        return Handled
    if looking.buffer ≠ null and looking.buffer.reviewed = true and name ≠ "down" and name ≠ "up" and name ≠ "pagedown" and name ≠ "pageup", return Handled
    asking = chat_id
    if looking.buffer ≠ null and looking.buffer.chat_id ≠ null, asking = looking.buffer.chat_id
    if name = "a" or name = "y" or name = "enter"
        emit InChat { id = asking, particle = DecideChange { accepted = true } } to this
        return Handled
    if name = "r" or name = "n" or name = "escape"
        emit InChat { id = asking, particle = DecideChange { accepted = false } } to this
        return Handled
    step = 0
    if name = "down", step = 1
    if name = "up", step = -1
    if name = "pagedown", step = editor_page
    if name = "pageup", step = 0 - editor_page
    if step = 0, return Handled
    emit Active { groups = groups, current = current } to this get shown
    top = shown.buffer.top + step
    if top < 0, top = 0
    emit PutActive { groups = groups, current = current, buffer = shown.buffer + { top = top } } to this get scrolled
    groups = scrolled.groups
    return Handled

| The proposed change's tab closed, if it is open.
CloseProposal { path } =>
    emit FindView { groups = groups, path = path + " ±", store = "ai" } to this get at
    if at.group < 0, return Nothing
    emit Stash to this
    emit CloseAt { groups = groups, current = current, group = at.group, tab = at.tab } to this get closed
    groups = closed.groups
    current = closed.current
    emit Unstash to this
    return Closed

| The AI stopped: what it was waiting on goes.
DropProposal =>
    pending = chat.pending
    if pending = null, return Nothing
    chat = chat + { pending = null }
    if pending.tool = "run_command" and prompt ≠ null and prompt.kind = "ai_run", prompt = null
    if pending.path ≠ null, emit CloseProposal { path = pending.path } to this
    return Dropped

| The user's answer to a proposed edit or file.
DecideChange { accepted } =>
    pending = chat.pending
    emit Active { groups = groups, current = current } to this get shown
    view = shown.buffer
    if pending = null or pending.path = null or view = null or view.kind ≠ "diff" or view.target ≠ pending.path
        if view ≠ null and view.kind = "diff", emit CloseProposal { path = view.target } to this
        return Nothing
    chat = chat + { pending = null }
    emit CloseProposal { path = pending.path } to this
    if not accepted
        chat = chat + { turns = chat.turns + [{ role = "tool", text = "you rejected the change to " + pending.path }] }
        message = ""
        emit ToolDone { tool = pending.tool, text = "The user rejected this change. Do not make it; say what you would do instead, or ask." } to this
        return Rejected
    emit ApplyChange { view = view } to this get applied
    if applied ∈ Text
        chat = chat + { turns = chat.turns + [{ role = "error", text = applied.text }] }
        emit ToolDone { tool = pending.tool, text = applied.text } to this
        return Failed
    chat = chat + { turns = chat.turns + [{ role = "tool", text = "changed " + pending.path + " (Ctrl+Z in the file undoes it; View > Undo AI Changes undoes them all)" }] }
    emit ToolDone { tool = pending.tool, text = "The user accepted: " + pending.path + " is changed and saved." } to this
    return Accepted

| An accepted change made: a new file written, or an open (or opened)
| file's lines replaced as one edit — Ctrl+Z undoes it — and saved. What
| the file was first is kept, for Undo AI Changes.
ApplyChange { view } =>
    path = view.target
    kept = false
    loop point over chat.checkpoints
        if point.path = path, kept = true
    if not kept
        before = null
        if not view.created
            emit FileLines { path = path } to this get held
            if held ∈ Text, return held
            emit Join { value = held.lines, separator = "\n" } to texts get before_text
            before = before_text.value
        chat = chat + { checkpoints = chat.checkpoints + [{ path = path, before = before }] }
    emit Join { value = view.lines, separator = "\n" } to texts get after_text
    if view.created
        emit WriteFile { path = path, content = after_text.value } to files get written
        if written ∈ Exception, return Text { text = "Error: " + written.message }
        emit OpenFile { path = path } to this
        return Applied
    emit OpenFile { path = path } to this
    if file = null or file.path ≠ path, return Text { text = "Error: " + path + " could not be opened to change it" }
    undo += { lines = file.lines, row = file.row, col = file.col }
    emit Length { value = view.lines } to core get { value as count }
    row = file.row
    if row ≥ count, row = count - 1
    file = file + { lines = view.lines, row = row, col = 0, want = 0, dirty = true }
    last_edit = ""
    emit SaveFile to this get saved
    if saved ∉ Saved, return Text { text = "Error: " + path + " was changed but could not be saved: " + message }
    return Applied

| The status bar's y / n on a command the AI wants to run.
AnswerRun { yes } =>
    pending = chat.pending
    if pending = null or pending.tool ≠ "run_command", return Nothing
    chat = chat + { pending = null }
    if not yes
        chat = chat + { turns = chat.turns + [{ role = "tool", text = "you said no to: " + pending.command }] }
        emit ToolDone { tool = "run_command", text = "The user said no to running this. Do not run it; say what it was for, or ask." } to this
        return Refused
    emit Run { command = "sh", args = ["-c", pending.command], cwd = folder } to procs get ran
    output = ""
    if ran ∈ Exception, output = "Error: " + ran.message
    if ran ∉ Exception
        output = "exit code " + ran.code + "\n" + ran.stdout
        if ran.stderr ≠ "", output = output + "\n" + ran.stderr
    emit LastLines { text = output, count = 80 } to this get tail_lines
    chat = chat + { turns = chat.turns + [{ role = "tool", text = "ran: " + pending.command + " — exit code " + ran.code }] }
    emit ToolDone { tool = "run_command", text = tail_lines.text } to this
    return Ran

| View > Undo AI Changes: every file the AI changed since the last
| question, put back as it was (a file it made, removed); open tabs too.
UndoAiChanges =>
    if chat.snapshot ≠ null
        emit UndoAgentChanges to this get agent_undone
        return agent_undone
    emit Length { value = chat.checkpoints } to core get { value as count }
    if count = 0
        message = "The AI has changed nothing since the last question"
        return Nothing
    emit Stash to this
    loop point over chat.checkpoints
        if point.before = null, emit DeleteFile { path = point.path } to files
        if point.before ≠ null, emit WriteFile { path = point.path, content = point.before } to files
        emit FindView { groups = groups, path = point.path, store = "workspace" } to this get at
        if at.group ≥ 0
            if point.before = null
                emit CloseAt { groups = groups, current = current, group = at.group, tab = at.tab } to this get closed
                groups = closed.groups
                current = closed.current
            if point.before ≠ null
                emit Split { value = point.before, separator = "\n" } to texts get restored
                tab = groups[at.group].tabs[at.tab] + { lines = restored.value, row = 0, col = 0, want = 0, top = 0, dirty = false }
                emit PutActive { groups = groups[0, at.group) + [groups[at.group] + { active = at.tab }] + groups(at.group, length), current = at.group, buffer = tab } to this get put
                groups = put.groups
    emit Unstash to this
    chat = chat + { checkpoints = [], turns = chat.turns + [{ role = "tool", text = "undid the AI's changes to " + count + " file(s)" }] }
    message = "The AI's changes are undone"
    return Undone


| ── New File ───────────────────────────────────────────────────────────

| Ctrl+N: a name asked for, in the folder picked in the explorer — a
| folder, or the folder of a file — else at the root.
NewFile =>
    dir = ""
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get explorer_at
    node = tree[tree_sel]
    if tree_picked and explorer_at.group ≥ 0 and node ≠ null
        if node.is_dir, dir = node.path
        if not node.is_dir
            emit Split { value = node.path, separator = "/" } to texts get parts
            emit Length { value = parts.value } to core get { value as depth }
            emit Join { value = parts.value[0, depth - 1), separator = "/" } to texts get parent
            dir = parent.value
    label = "New file (a name ending in / makes a folder): "
    if dir ≠ "", label = "New file in " + dir + "/: "
    prompt = { kind = "new_file", label = label, text = "", dir = dir }
    return Asked

| The file (or, with a trailing `/`, the folder) made, shown in the
| explorer, and a file opened.
CreateNewFile { dir, name } =>
    emit Trim { value = name } to texts get trimmed
    given = trimmed.value
    if given = "", return Nothing
    is_folder = given[length - 1] = "/"
    if is_folder, given = given[0, length - 1)
    path = given
    if dir ≠ "", path = dir + "/" + given
    emit SafePath { path = path } to this get safe
    if not safe.ok or safe.path = "."
        message = "Error: " + path + " is not a name inside the folder"
        return Failed
    emit Exists { path = safe.path } to files get there
    if there ∉ Exception and (there.is_file or there.is_dir)
        message = "Error: " + safe.path + " is there already"
        return Failed
    made = null
    if is_folder
        emit CreateDir { path = safe.path } to files get made_dir
        made = made_dir
    if not is_folder
        emit WriteFile { path = safe.path, content = "" } to files get made_file
        made = made_file
    if made ∈ Exception
        message = "Error: " + made.message
        return Failed
    emit RefreshTree { reveal = safe.path } to this
    if not is_folder, emit OpenFile { path = safe.path } to this
    message = "Created " + safe.path
    return Created

| The explorer read again from the disk, its open folders open still, and
| the folders on the way to `reveal` opened and it selected.
RefreshTree { reveal } =>
    opened = {}
    loop node over tree
        if node.is_dir and node.open, opened = opened + { "$node.path" = true }
    emit Split { value = reveal, separator = "/" } to texts get parts
    emit Length { value = parts.value } to core get { value as depth }
    on_the_way = ""
    loop i, part over parts.value
        if i < depth - 1
            if on_the_way ≠ "", on_the_way = on_the_way + "/"
            on_the_way = on_the_way + part
            opened = opened + { "$on_the_way" = true }
    emit ListDir { path = "." } to files get listing
    if listing ∈ Exception, return Failed
    emit Children { entries = listing.entries, parent = "", depth = 0 } to this get kids
    nodes = kids.nodes
    i = 0
    loop
        node = nodes[i]
        if node = null, break
        if node.is_dir and opened[node.path] = true
            emit ListDir { path = node.path } to files get inner
            if inner ∉ Exception
                emit Children { entries = inner.entries, parent = node.path, depth = node.depth + 1 } to this get inner_kids
                emit Expand { nodes = nodes, index = i, children = inner_kids.nodes } to this get grown
                nodes = grown.nodes
        i += 1
    tree = nodes
    loop at, node over tree
        if node.path = reveal, tree_sel = at
    return Refreshed


| ── Claude Code and Codex (agents.gene.code) ───────────────────────────

| The question handed to the agent `provider` names: written to a file,
| and the agent started on it in a hidden terminal, so the ide keeps
| going while it works. In edit mode, the folder is snapshotted first
| (git), so what it changes can be shown and put back.
AskAgent { provider, question, context } =>
    mode = settings["ai.agent.mode"]
    if chat.session_for ≠ provider.name, chat = chat + { session = "", session_for = provider.name }
    text = context + "\n# The question\n" + question
    emit ModeNote { mode = mode } to this get mode_note
    if mode_note.text ≠ "", text = text + "\n\n" + mode_note.text
    emit WriteFile { path = "runs/" + chat_id + "-prompt.txt", content = text } to prefs get wrote
    if wrote ∈ Exception
        emit ChatFailed { text = "The question could not be written for the agent: " + wrote.message } to this
        return Failed
    emit WriteFile { path = "runs/" + chat_id + "-out.jsonl", content = "" } to prefs
    chat = chat + { snapshot = null, changed = null }
    if mode = "edit" or mode = "auto"
        emit TakeSnapshot to this get snap
        if snap ∈ Snapshot, chat = chat + { snapshot = snap }
        if snap ∉ Snapshot, chat = chat + { turns = chat.turns + [{ role = "error", text = "Not a git repository (or no commit yet): what the agent changes cannot be undone from here." }] }
    runs = settings_dir + "/runs"
    emit AgentCommand { provider = provider, mode = mode, session = chat.session, prompt_file = runs + "/" + chat_id + "-prompt.txt", err_file = runs + "/" + chat_id + "-err.txt", allow = settings["ai.agent.allowCommands"] } to this get line
    emit Quoted { text = runs + "/" + chat_id + "-out.jsonl" } to this get out_at
    emit Open { cols = 200, rows = 50, cwd = folder, command = "/bin/sh", args = ["-c", line.text + " | tee " + out_at.text] } to shells get opened
    if opened ∈ Exception
        emit ChatFailed { text = provider.title + " could not be started: " + opened.message } to this
        return Failed
    chat = chat + { busy = true, request = -1, steps = 0, agent = { pty = opened.id, type = provider.type, title = provider.title, seen = 0, done = false, error = "" } }
    return Asked

| What the agent has written since last time, into the chat.
AgentProgress =>
    agent = chat.agent
    if agent = null, return Nothing
    emit ReadFile { path = "runs/" + chat_id + "-out.jsonl" } to prefs get out
    if out ∈ Exception, return Nothing
    emit Split { value = out.content, separator = "\n" } to texts get split
    emit Length { value = split.value } to core get { value as count }
    | The last piece is a line still being written (or "" after the last \n).
    complete = count - 1
    if complete ≤ agent.seen, return Nothing
    emit AgentEvents { lines = split.value[agent.seen, complete), type = agent.type, folder = folder } to this get update
    steps = chat.steps
    loop turn over update.turns
        if turn.role = "tool", steps += 1
    chat = chat + { turns = chat.turns + update.turns, steps = steps }
    if update.session ≠ "", chat = chat + { session = update.session }
    agent = agent + { seen = complete }
    if update.done, agent = agent + { done = true, error = update.error }
    chat = chat + { agent = agent }
    return Progressed

| The agent's program ended (or was stopped): the last of what it wrote,
| why it failed if it did, and what it changed.
AgentFinished =>
    emit AgentProgress to this
    agent = chat.agent
    if agent = null, return Nothing
    chat = chat + { agent = null, busy = false }
    problem = agent.error
    if not agent.done and problem = ""
        emit ReadFile { path = "runs/" + chat_id + "-err.txt" } to prefs get err
        why = ""
        if err ∉ Exception
            emit Trim { value = err.content } to texts get trimmed
            emit LastLines { text = trimmed.value, count = 8 } to this get last
            why = last.text
        problem = agent.title + " stopped without an answer"
        if why ≠ "", problem = problem + ":\n" + why
    if problem ≠ "", chat = chat + { turns = chat.turns + [{ role = "error", text = problem }] }
    if problem = "", emit OfferPlan to this
    emit NoteAgentChanges to this
    return Finished

| A command in the open folder: its output, and whether it worked.
InFolder { command, args } =>
    emit Run { command = command, args = args, cwd = folder } to procs get ran
    if ran ∈ Exception, return Ran { ok = false, text = "" }
    emit Trim { value = ran.stdout } to texts get out
    return Ran { ok = ran.success, text = out.value }

| `text` as its non-empty lines.
NonEmptyLines { text } =>
    emit Split { value = text, separator = "\n" } to texts get split
    out = []
    loop line over split.value
        if line ≠ "", out += line
    return Lines { lines = out }

| The folder as it is now, as a git commit that leaves everything as it
| is (`git stash create`; HEAD when nothing is changed), and the untracked
| files there are.
TakeSnapshot =>
    emit InFolder { command = "git", args = ["rev-parse", "--is-inside-work-tree"] } to this get inside
    if not inside.ok, return NoSnapshot
    emit InFolder { command = "git", args = ["stash", "create"] } to this get stashed
    commit = stashed.text
    if commit = ""
        emit InFolder { command = "git", args = ["rev-parse", "HEAD"] } to this get head
        if not head.ok, return NoSnapshot
        commit = head.text
    emit InFolder { command = "git", args = ["ls-files", "--others", "--exclude-standard"] } to this get untracked
    emit NonEmptyLines { text = untracked.text } to this get untracked_lines
    return Snapshot { commit = commit, untracked = untracked_lines.lines }

| What differs from the snapshot now: files changed, and files new.
AgentChanges =>
    snap = chat.snapshot
    if snap = null, return Changes { modified = [], created = [] }
    emit InFolder { command = "git", args = ["diff", "--name-only", "--relative", snap.commit] } to this get diff
    emit NonEmptyLines { text = diff.text } to this get modified
    emit InFolder { command = "git", args = ["ls-files", "--others", "--exclude-standard"] } to this get untracked
    emit NonEmptyLines { text = untracked.text } to this get now
    created = []
    loop path over now.lines
        was = false
        loop before over snap.untracked
            if before = path, was = true
        if not was, created += path
    return Changes { modified = modified.lines, created = created }

| After an edit-mode turn: what it changed, said in the chat, and the
| open tabs of those files read again.
NoteAgentChanges =>
    if chat.snapshot = null, return Nothing
    emit AgentChanges to this get changes
    chat = chat + { changed = changes }
    all = changes.modified + changes.created
    emit Length { value = all } to core get { value as count }
    if count = 0, return Nothing
    emit Join { value = all, separator = "," } to texts get listed
    chat = chat + { turns = chat.turns + [{ role = "tool", text = "changed " + listed.value + " — View > Show AI Changes (Ctrl+K D) to see, Undo AI Changes to put back" }] }
    emit ReloadFiles { paths = all } to this
    return Noted

| The open tabs of `paths` read again from the disk — all but the ones
| with unsaved edits, which are left and named.
ReloadFiles { paths } =>
    emit Stash to this
    kept_edits = []
    loop path over paths
        emit FindView { groups = groups, path = path, store = "workspace" } to this get at
        if at.group ≥ 0
            tab = groups[at.group].tabs[at.tab]
            if tab.dirty = true, kept_edits += path
            if tab.dirty ≠ true
                emit Exists { path = path } to files get there
                if there ∉ Exception and there.is_file
                    emit ReadFile { path = path } to files get read
                    emit Split { value = read.content, separator = "\n" } to texts get fresh
                    emit Length { value = fresh.value } to core get { value as size }
                    row = tab.row
                    if row ≥ size, row = size - 1
                    if row < 0, row = 0
                    changed_tab = tab + { lines = fresh.value, row = row, col = 0, want = 0 }
                    held = groups[at.group]
                    tabs = held.tabs[0, at.tab) + [changed_tab] + held.tabs(at.tab, length)
                    groups = groups[0, at.group) + [held + { tabs = tabs }] + groups(at.group, length)
    emit Unstash to this
    emit Length { value = kept_edits } to core get { value as unsaved }
    if unsaved > 0
        emit Join { value = kept_edits, separator = "," } to texts get names
        chat = chat + { turns = chat.turns + [{ role = "error", text = "Not reloaded, they have unsaved edits here: " + names.value + " — the agent's version is on the disk" }] }
    return Reloaded

| View > Undo AI Changes after an agent: its changed files as they were
| in the snapshot, its new files gone, and their tabs read again.
UndoAgentChanges =>
    emit AgentChanges to this get changes
    all = changes.modified + changes.created
    emit Length { value = all } to core get { value as count }
    if count = 0
        message = "The AI has changed nothing since the last question"
        return Nothing
    emit Length { value = changes.modified } to core get { value as modified_count }
    if modified_count > 0
        emit InFolder { command = "git", args = ["restore", "--source=" + chat.snapshot.commit, "--worktree", "--"] + changes.modified } to this get restored
        if not restored.ok
            message = "Error: git could not put the files back"
            return Failed
    loop path over changes.created
        emit DeleteFile { path = path } to files
    emit ReloadFiles { paths = changes.modified } to this
    emit Stash to this
    loop path over changes.created
        emit FindView { groups = groups, path = path, store = "workspace" } to this get at
        if at.group ≥ 0
            emit CloseAt { groups = groups, current = current, group = at.group, tab = at.tab } to this get closed
            groups = closed.groups
            current = closed.current
    emit Unstash to this
    chat = chat + { snapshot = null, changed = null, turns = chat.turns + [{ role = "tool", text = "undid the AI's changes to " + count + " file(s)" }] }
    message = "The AI's changes are undone"
    return Undone

| View > Show AI Changes: each file the agent changed, as a diff against
| the snapshot, in a tab of its own (Escape closes it).
ShowAiChanges =>
    if chat.snapshot = null
        message = "No AI changes to show (they are kept for the last question, in edit mode, in a git folder)"
        return Nothing
    emit AgentChanges to this get changes
    emit EditorSlot to this get into
    loop path over changes.modified + changes.created
        old = []
        created = true
        emit InFolder { command = "git", args = ["show", chat.snapshot.commit + ":./" + path] } to this get before
        if before.ok
            emit Split { value = before.text, separator = "\n" } to texts get old_lines
            old = old_lines.value
            created = false
        new = []
        emit Exists { path = path } to files get there
        if there ∉ Exception and there.is_file
            emit ReadFile { path = path } to files get read
            emit Split { value = read.content, separator = "\n" } to texts get new_lines
            new = new_lines.value
            emit Length { value = new } to core get { value as size }
            if size > 0 and new[size - 1] = "", new = new[0, size - 1)
        emit DiffLines { old = old, new = new, around = 3 } to this get diff
        view = { kind = "diff", path = path + " Δ", store = "ai-done", target = path, created = created, lines = new, diff = diff.lines, removed = diff.removed, added = diff.added, top = 0, reviewed = true }
        emit Show { buffer = view, slot = into.slot } to this
    return Shown

| Alt+E: ask → plan → edit → auto, and round, remembered in settings.
ToggleAgentMode =>
    emit NextMode { mode = settings["ai.agent.mode"] } to this get next_mode
    emit SetAgentMode { mode = next_mode.text } to this
    return Toggled

| The AI's mode set (ai.mode.<mode>, or Alt+E), and said.
SetAgentMode { mode } =>
    emit StoreSetting { key = "ai.agent.mode", value = mode } to this
    said = { ask = "Ask — it looks and answers", plan = "Plan — it looks and answers with a plan (Alt+G carries it out)", edit = "Edit — it changes files; commands only from ai.agent.allowCommands", auto = "Auto — it changes files and runs commands without asking" }
    message = "AI mode: " + said[mode]
    emit ChatNotice to this
    return Moded

| A plan-mode answer: the chat says how to carry it out.
OfferPlan =>
    if settings["ai.agent.mode"] ≠ "plan", return Nothing
    followup = settings["ai.agent.planFollowup"]
    chat = chat + { plan_ready = true, turns = chat.turns + [{ role = "tool", text = "Alt+G: go ahead — carry out this plan in " + followup + " mode" }] }
    return Offered

| Alt+G: the plan just made, carried out — the mode switched to
| ai.agent.planFollowup (edit, unless it says auto), and the AI told to
| go ahead, in the same conversation.
GoAhead =>
    if chat.plan_ready ≠ true
        message = "There is no plan to carry out — ask in Plan mode first (Alt+E)"
        return Nothing
    chat = chat + { plan_ready = false }
    emit SetAgentMode { mode = settings["ai.agent.planFollowup"] } to this
    emit AskAbout { question = "Go ahead: carry out the plan above." } to this get asked
    return asked

| The providers to pick from: every `ai.providers` entry (the defaults
| and the user's, see settings.gene.code).
ProviderNames =>
    names = []
    all = settings["ai.providers"]
    if all ∈ Object
        loop key, value over all
            names += key
    return Names { names = names }

| http_client speaks first on every request (`Log`); nothing to do here.
Log { source, level, message as logged } =>
    return Ignored

| Whether the provider `provider` (from ProviderFor) can be used now, the
| models it offers — the ones settings list (`"models"`), else the ones it
| says it has: a server's /v1/models, `codex debug models` — as ids, with
| `names` (id → what to show: "Opus 5.5" for claude-opus-5-5) — and the
| efforts each takes (`levels`: model → { efforts, default }; the model
| "" for any), from Codex's catalogue or the entry's `"efforts"`.
ProviderCheck { provider } =>
    if provider.problem ≠ ""
        return Check { ready = false, note = "not set up", models = [], names = {}, levels = {} }
    found = []
    names = {}
    levels = {}
    ready = true
    note = "ready"
    if provider.type = "claude-code"
        emit Run { command = provider.command, args = ["auth", "status"], cwd = folder } to procs get auth
        if auth ∈ Exception, return Check { ready = false, note = provider.command + " is not installed", models = [], names = {}, levels = {} }
        emit Parse { text = auth.stdout } to jsons get status
        signed_in = status ∉ Exception and status.value ∈ Object and status.value["loggedIn"] = true
        if not signed_in
            ready = false
            note = "not signed in — run " + provider.command + " once"
    if provider.type = "codex"
        emit Run { command = provider.command, args = ["login", "status"], cwd = folder } to procs get login
        if login ∈ Exception, return Check { ready = false, note = provider.command + " is not installed", models = [], names = {}, levels = {} }
        if not login.success
            ready = false
            note = "not signed in — " + provider.command + " login"
        emit Run { command = provider.command, args = ["debug", "models"], cwd = folder } to procs get catalog
        if catalog ∉ Exception and catalog.success
            emit Parse { text = catalog.stdout } to jsons get codex_listed
            if codex_listed ∉ Exception and codex_listed.value ∈ Object and codex_listed.value["models"] ∈ Array
                loop one over codex_listed.value["models"]
                    if one["slug"] ∈ String and one["visibility"] ≠ "hide"
                        found += one["slug"]
                        if one["display_name"] ∈ String
                            slug_name = one["slug"]
                            names = names + { "$slug_name" = one["display_name"] }
                        takes = []
                        if one["supported_reasoning_levels"] ∈ Array
                            loop level over one["supported_reasoning_levels"]
                                if level["effort"] ∈ String, takes += level["effort"]
                        usual = ""
                        if one["default_reasoning_level"] ∈ String, usual = one["default_reasoning_level"]
                        slug = one["slug"]
                        levels = levels + { "$slug" = { efforts = takes, default = usual } }
                        if levels[""] = null, levels = levels + { "" = { efforts = takes, default = usual } }
    if provider.runner = "api"
        root_url = provider.endpoint
        emit Length { value = root_url } to core get { value as size }
        if size > 0 and root_url[size - 1] = "/", root_url = root_url[0, size - 1)
        emit Length { value = root_url } to core get { value as trimmed_size }
        url = root_url + "/v1/models"
        if trimmed_size ≥ 3 and root_url[trimmed_size - 3, trimmed_size) = "/v1", url = root_url + "/models"
        headers = {}
        if provider.api_key_env ≠ ""
            emit Get { name = provider.api_key_env, default = "" } to vars get key
            if key.value ≠ "", headers = { Authorization = "Bearer " + key.value }
        emit Get { url = url, headers = headers, timeout_seconds = 3 } to web get answer
        if answer ∈ Exception or not answer.ok
            ready = false
            note = "not reachable at " + provider.endpoint
        if answer ∉ Exception and answer.ok and answer.status = 401
            ready = false
            note = "the key was refused (" + provider.api_key_env + ")"
        if answer ∉ Exception and answer.ok and answer.status = 200
            emit Parse { text = answer.body } to jsons get api_listed
            if api_listed ∉ Exception and api_listed.value ∈ Object and api_listed.value["data"] ∈ Array
                loop one over api_listed.value["data"]
                    if one["id"] ∈ String, found += one["id"]
    if provider.models ≠ null
        found = []
        names = {}
        loop one over provider.models
            if one ∈ String, found += one
            | { "id": "claude-opus-5-5", "name": "Opus 5.5" }: shown by its name.
            if one ∈ Object and one["id"] ∈ String
                found += one["id"]
                listed_id = one["id"]
                if one["name"] ∈ String, names = names + { "$listed_id" = one["name"] }
    if provider.efforts ≠ null
        takes = []
        loop one over provider.efforts
            if one ∈ String, takes += one
        levels = { "" = { efforts = takes, default = "" } }
    return Check { ready = ready, note = note, models = found, names = names, levels = levels }

| Alt+M (or Settings > AI: Switch Model…): three lists side by side —
| every AI, its models, its efforts — all their choices in sight. ←/→ (or
| Tab) move between the lists, ↑/↓ within one, Enter picks; ● is what is
| in use. Moving in the AI list shows that AI's models and efforts; picking
| one of them makes that AI the one in use too. Every AI is checked as the
| lists open (ProviderCheck).
OpenModelPicker =>
    emit ProviderNames to this get names
    found = []
    at = 0
    loop i, name over names.names
        emit ProviderFor { settings = settings + { "ai.provider" = name } } to this get provider
        emit ProviderCheck { provider = provider } to this get check
        title = name
        if provider.title ≠ null, title = provider.title
        found += { name = name, title = title, ready = check.ready, note = check.note, models = check.models, names = check.names, levels = check.levels, api = provider.runner = "api" }
        if name = settings["ai.provider"], at = i
    picker = { providers = found, col = 1, cursors = [at, 0, 0] }
    emit PickerAim to this
    return Opened

| The model and effort lists' cursors put on what the AI under the first
| list's cursor has chosen.
PickerAim =>
    emit PickerRows to this get aimed
    cursors = picker.cursors
    model_at = 0
    loop i, one over aimed.choices[1]
        if one = aimed.chosen[1], model_at = i
    effort_at = 0
    loop i, one over aimed.choices[2]
        if one = aimed.chosen[2], effort_at = i
    picker = picker + { cursors = [cursors[0], model_at, effort_at] }
    return Aimed

| What the lists hold, for the AI under the first list's cursor:
| `choices` per list (a model or effort "" is the tool's own default),
| what that AI has chosen, and which AI is in use.
PickerRows =>
    held = picker.providers[picker.cursors[0]]
    entry = settings["ai.providers"][held.name]
    model = entry["model"]
    if model ∉ String, model = ""
    effort = entry["effort"]
    if effort ∉ String, effort = ""
    ai_names = []
    loop one over picker.providers
        ai_names += one.name
    level = held.levels[model]
    if level = null, level = held.levels[""]
    efforts = []
    usual = ""
    if level ≠ null
        efforts = level.efforts
        usual = level.default
    known = level ≠ null and not held.api
    effort_choices = [""] + efforts
    if not known, effort_choices = []
    return Rows {
        held = held
        choices = [ai_names, [""] + held.models, effort_choices]
        chosen = [settings["ai.provider"], model, effort]
        usual_effort = usual
        effort_known = known
    }

| A key in the model picker.
PickerKey { name } =>
    if name = "escape" or name = "q"
        picker = null
        return Handled
    col = picker.col
    if (name = "right" or name = "tab") and col < 2, col += 1
    if (name = "left" or name = "shift+tab") and col > 0, col = col - 1
    picker = picker + { col = col }
    emit PickerRows to this get shown_rows
    options = shown_rows.choices[col]
    emit Length { value = options } to core get { value as count }
    cursors = picker.cursors
    at = cursors[col]
    if name = "down" and at < count - 1, at += 1
    if name = "up" and at > 0, at = at - 1
    if name = "home", at = 0
    if name = "end" and count > 0, at = count - 1
    if name = "pagedown"
        at = at + 10
        if at > count - 1, at = count - 1
    if name = "pageup"
        at = at - 10
        if at < 0, at = 0
    if at ≠ cursors[col]
        picker = picker + { cursors = cursors[0, col) + [at] + cursors(col, length) }
        | Another AI under the cursor: its own choices in the other lists.
        if col = 0, emit PickerAim to this
    if (name = "enter" or name = "space") and count > 0
        emit PickerSet { col = col, value = options[picker.cursors[col]] } to this
    return Handled

| A pick: the AI (ai.provider), or a model or effort of the AI under the
| first list's cursor (in its ai.providers entry) — which then is the AI in
| use. An effort the new model does not take goes back to the default.
PickerSet { col, value } =>
    held = picker.providers[picker.cursors[0]]
    if col > 0
        all = settings["ai.providers"]
        entry = all[held.name]
        if col = 1
            entry = entry + { model = value }
            level = held.levels[value]
            if level = null, level = held.levels[""]
            effort = entry["effort"]
            if level ≠ null and effort ∈ String and effort ≠ ""
                takes = false
                loop one over level.efforts
                    if one = effort, takes = true
                if not takes, entry = entry + { effort = "" }
        if col = 2, entry = entry + { effort = value }
        emit StoreSetting { key = "ai.providers", value = all + { "$held.name" = entry } } to this
    emit StoreSetting { key = "ai.provider", value = held.name } to this
    emit PickerAim to this
    emit ChatNotice to this
    message = "AI: " + ai_status
    if not held.ready, message = "Error: AI: " + held.name + " is " + held.note
    return Set


| ── Go Back / Go Forward ───────────────────────────────────────────────

| Where the cursor is now, kept (see `spots`): a new spot when it is in
| another file than the one in use or 10 or more lines from it — anything
| after the one in use is dropped then, as a browser does — else the one
| in use moved to it.
NoteSpot =>
    if navigating or file = null or file.store ≠ "workspace", return Nothing
    here = { path = file.path, row = file.row, col = file.col }
    last = spots[spot_at]
    if last ≠ null and last.path = here.path
        apart = here.row - last.row
        if apart < 0, apart = 0 - apart
        if apart < 10
            spots = spots[0, spot_at) + [here] + spots(spot_at, length)
            return Moved
    kept = spots[0, spot_at + 1) + [here]
    emit Length { value = kept } to core get { value as count }
    if count > max_spots, kept = kept[count - max_spots, count)
    spots = kept
    emit Length { value = spots } to core get { value as now }
    spot_at = now - 1
    return Kept

| Alt+← (`step` -1) / Alt+→ (1): the spot before or after the one in use,
| its file opened and the cursor put back there.
GoSpot { step } =>
    emit NoteSpot to this
    emit Length { value = spots } to core get { value as count }
    target = spot_at + step
    if target < 0 or target ≥ count
        message = "Nowhere further to go"
        return Nothing
    spot = spots[target]
    spot_at = target
    navigating = true
    emit OpenFile { path = spot.path } to this get opened
    if opened ∈ Opened and file ≠ null and file.path = spot.path
        emit Length { value = file.lines } to core get { value as size }
        row = spot.row
        if row ≥ size, row = size - 1
        if row < 0, row = 0
        file = file + { row = row, col = spot.col, want = spot.col }
    navigating = false
    return Went


| ── Pane keys ──────────────────────────────────────────────────────────
|
| Ctrl+B the explorer, Ctrl+J the terminal, Ctrl+L the AI chat, Ctrl+E
| the files: shown and given the keys if they are not; given the keys if
| they are shown; put away if they have the keys.

| The pane of `kind` ("explorer", "terminal", "chat", "file") toggled.
TogglePane { kind } =>
    emit Active { groups = groups, current = current } to this get shown
    if shown.buffer ≠ null and shown.buffer.kind = kind
        emit HidePane { kind = kind } to this
        return Hidden
    | Shown somewhere: the keys to it (the active tab of that kind first).
    where = null
    loop gi, group over groups
        active_view = group.tabs[group.active]
        if where = null and active_view.kind = kind, where = { group = gi, tab = group.active }
    loop gi, group over groups
        loop ti, tab over group.tabs
            if where = null and tab.kind = kind, where = { group = gi, tab = ti }
    if where ≠ null
        emit Reveal { group = where.group, tab = where.tab } to this
        return Focused
    if kind = "terminal" or kind = "file"
        emit Length { value = hidden_panes[kind] } to core get { value as kept }
        if kept > 0
            emit RestorePane { kind = kind } to this
            return Restored
    if kind = "explorer", emit ShowExplorer { focused = true } to this
    if kind = "chat", emit ShowChat to this
    if kind = "terminal", emit NewTerminal { slot = "b" } to this
    if kind = "file", message = "No file is open — Ctrl+N makes one, the Explorer opens one"
    return Shown

| The pane of `kind` put away: the explorer and the chat closed (they come
| back as they were), terminals and files kept in `hidden_panes`.
HidePane { kind } =>
    if kind = "explorer"
        emit HideExplorer to this
        return Hidden
    emit Stash to this
    kept = hidden_panes[kind]
    if kept = null, kept = []
    left = []
    loop gi, group over groups
        tabs = []
        active = 0
        loop ti, tab over group.tabs
            if tab.kind = kind and kind ≠ "chat"
                kept += { slot = group.slot, view = tab, active = gi = current and ti = group.active }
            if tab.kind ≠ kind
                if ti = group.active
                    emit Length { value = tabs } to core get { value as at }
                    active = at
                tabs += tab
        emit Length { value = tabs } to core get { value as count }
        if count > 0, left += group + { tabs = tabs, active = active }
    groups = left
    if kind ≠ "chat", hidden_panes = hidden_panes + { "$kind" = kept }
    emit Refocus { groups = groups } to this get next
    current = next.index
    emit Unstash to this
    return Hidden

| Terminals or files put away brought back, each to where it was, the one
| that had the keys given them again.
RestorePane { kind } =>
    kept = hidden_panes[kind]
    if kept = null, return Nothing
    emit Length { value = kept } to core get { value as count }
    if count = 0, return Nothing
    hidden_panes = hidden_panes + { "$kind" = [] }
    emit Stash to this
    focus_view = kept[0].view
    loop item over kept
        emit OpenIn { groups = groups, slot = item.slot, buffer = item.view } to this get opened_back
        groups = opened_back.groups
        if item.active, focus_view = item.view
    emit FindView { groups = groups, path = focus_view.path, store = focus_view.store } to this get at
    if at.group ≥ 0
        held = groups[at.group] + { active = at.tab }
        groups = groups[0, at.group) + [held] + groups(at.group, length)
        current = at.group
    emit Unstash to this
    return Restored

| `groups` and the panes put away, as one list of groups: what quitting
| must save and close.
WithHidden =>
    away = hidden_panes.terminal + hidden_panes.file
    emit Length { value = away } to core get { value as count }
    if count = 0, return All { groups = groups }
    views = []
    loop item over away
        views += item.view
    return All { groups = groups + [{ slot = "hidden", tabs = views, active = 0 }] }
