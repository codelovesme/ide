| ide — the state, and what each key does to it.
|
| This is the one gene that holds state: a gene's top level is its
| handlers' whole world, so everything that changes lives here and every
| other gene answers particles (layout, editor, tree, tabs, keys, menu,
| settings, render).
|
| A key arrives from `tty` as `Key { name, text }`. It goes, first match:
| to the prompt if one is open, to the menu if one is open, to a command if
| it is bound (keys.gene.code), else to what the focused tab shows — the
| explorer's rows, a file, or a terminal's shell (which gets most keys, see
| `HandleKey`). Then the screen is drawn again. Anything that fails lands
| in the status bar, not silence.

folder = ""
cols = 80
rows = 24
running = false

| The explorer: the visible rows (see tree.gene.code), the selected one,
| and the first one showing.
tree = []
tree_sel = 0
tree_top = 0
tree_page = 20

| Everything open, as tabs in groups, each group in a slot (see
| tabs.gene.code), and the group with the focus.
groups = []
current = 0

| The explorer's tab, and the slot it goes back to when shown again.
explorer_view = { kind = "explorer", path = "Explorer", store = "view" }

| The file the focused group shows, taken out of its tab while it is worked
| on: `{ path, store, lines, row, col, want, top, left, dirty, readonly }`.
| `Stash` puts it back, `Unstash` takes the next one out.
file = null
editor_page = 20
undo = []
redo = []
last_edit = ""

| What has the keys: the focused tab's kind — "tree" (the explorer),
| "editor" (a file), "terminal", or "none" when nothing is open.
focus = "none"
menu = null
prompt = null
message = ""
chord = ""
explorer_slot = "l"

max_undo = 200

| The organelles. They are linked while the program runs, not when it is
| built — a built program would otherwise carry the full path each one had
| on the machine that built it. See `Organelles`.
term = null
files = null
texts = null
vars = null
| A second `fs`, based in the settings folder rather than the open one.
prefs = null

| The user's settings (see settings.gene.code), and where they are kept.
settings = null
settings_dir = ""
| The side tracks' sizes (see layout.gene.code), from settings.
sizes = { left = 30, right = 40, top = 10, bottom = 12 }
| The key table (see keys.gene.code): the defaults and keybindings.json.
keytable = null

| Terminals: the pty organelle, how many have been opened (for their
| names), the size each was last told, and which commands still run while
| one has the keys (settings: terminal.integrated.commandsToSkipShell).
shells = null
terminals_opened = 0
terminal_sizes = {}

| Links the seven organelles from the folder `from`, relative to where the program
| was started: `.` in a release bundle (bin/ide starts it there), and
| `organelles` in a checkout (tools/organelles.sh puts them there).
Organelles { from } =>
    link from + "/env.so" as env_at
    link from + "/fs.so" as fs_at
    link from + "/strings.so" as strings_at
    link from + "/syntax.so" as syntax_at
    link from + "/tty.so" as tty_at
    link from + "/json.so" as json_at
    link from + "/fs.so" as prefs_at
    link from + "/pty.so" as pty_at
    return Linked { env = env_at, fs = fs_at, strings = strings_at, syntax = syntax_at, tty = tty_at, json = json_at, prefs = prefs_at, pty = pty_at }

| Links them, and hands each gene the ones it uses.
UseOrganelles { from } =>
    emit Organelles { from = from } to this get linked
    if linked ∈ Exception, return linked
    vars = linked.env
    files = linked.fs
    texts = linked.strings
    term = linked.tty
    prefs = linked.prefs
    shells = linked.pty
    emit SettingsUses { json = linked.json } to this
    emit KeysUses { json = linked.json, strings = linked.strings } to this
    emit EditorUses { texts = linked.strings } to this
    emit RenderUses { texts = linked.strings, colours = linked.syntax } to this
    return linked

EuglenaHasBeenBorn { cell_name } =>
    emit UseOrganelles { from = "." } to this get bundled
    if bundled ∈ Exception
        emit UseOrganelles { from = "organelles" } to this get checkout
        if checkout ∈ Exception, return Failed { reason = "the organelles could not be linked: " + checkout.message }
    emit Get { name = "IDE_FOLDER", default = "" } to vars get chosen
    start_in = chosen.value
    | Otherwise the folder it was started in — as fs resolves `.`, since
    | `PWD` is only what a shell says.
    if start_in = ""
        emit Config { base_path = "." } to files get here
        start_in = here.base_path
    | Settings live where VS Code's would on this system: the config folder.
    emit Get { name = "XDG_CONFIG_HOME", default = "" } to vars get xdg
    emit Get { name = "HOME", default = "/" } to vars get home
    config = xdg.value
    if config = "", config = home.value + "/.config"
    emit SettingsAt { dir = config + "/codelovesme-ide" } to this
    emit OpenFolder { path = start_in } to this get opened
    if opened ∈ Failed, return opened
    if settings["workbench.sideBar.visible"], emit ShowExplorer { focused = true } to this
    emit Start {} to term get started
    if started ∈ Exception, return Failed { reason = started.message }
    cols = started.cols
    rows = started.rows
    running = true
    emit Render to this
    return Alive { cell_name = cell_name }

Resize { cols as width, rows as height } =>
    cols = width
    rows = height
    emit Render to this
    return Resized

Key { name, text } =>
    if not running, return Ignored
    message = ""
    emit HandleKey { name = name, text = text } to this get handled
    if handled ∈ Exception, message = "Error: " + handled.message
    emit Render to this
    return handled

| A terminal's screen changed (pushed by the pty organelle): draw again.
TerminalOutput { id } =>
    if running, emit Render to this
    return Drawn

| A terminal's shell ended: its tab closes, as in VS Code.
TerminalExited { id, code } =>
    emit FindTerminal { id = id } to this get where
    if where.group ≥ 0
        emit Stash to this
        emit CloseAt { groups = groups, current = current, group = where.group, tab = where.tab } to this get closed
        groups = closed.groups
        current = closed.current
        emit Unstash to this
    if running, emit Render to this
    return Closed

| Where the terminal `id` is: its group and tab, or -1s.
FindTerminal { id } =>
    loop gi, group over groups
        loop ti, tab over group.tabs
            if tab.kind = "terminal" and tab.id = id, return Place { group = gi, tab = ti }
    return Place { group = -1, tab = -1 }

HandleKey { name, text } =>
    if prompt ≠ null
        emit PromptKey { name = name, text = text } to this
        return Handled
    if menu ≠ null
        emit MenuKey { open = menu, name = name } to this get chosen
        menu = chosen.open
        if chosen.command ≠ null, emit Run { command = chosen.command } to this
        return Handled
    | A terminal gets every key but the few commands that skip the shell,
    | so Ctrl+C, Ctrl+E, Ctrl+W… are the shell's, as in VS Code.
    if focus = "terminal"
        emit Keymap { name = name, pending = "", table = keytable } to this get for_shell
        skip = settings["terminal.integrated.commandsToSkipShell"]
        runs = false
        if for_shell.command ≠ null
            loop allowed over skip
                if allowed = for_shell.command, runs = true
        if runs
            emit Run { command = for_shell.command } to this
            return Handled
        emit Active { groups = groups, current = current } to this get shown
        emit Type { id = shown.buffer.id, name = name, text = text } to shells
        return Typed
    emit Keymap { name = name, pending = chord, table = keytable } to this get bound
    chord = bound.pending
    if chord ≠ ""
        emit KeyLabel { key = chord } to this get pressed
        message = "(" + pressed.text + ") was pressed. Waiting for the second key of the chord…"
        return Handled
    if bound.command ≠ null
        emit Run { command = bound.command } to this
        return Handled
    if bound.chord ≠ ""
        message = "The key combination (" + bound.chord + ") is not a command."
        return Handled
    if focus = "tree"
        emit TreeKey { name = name } to this
        return Handled
    if focus = "editor" and file ≠ null
        emit EditorKey { name = name, text = text } to this
    return Handled

slot_names = ["tl", "t", "tr", "l", "c", "r", "bl", "b", "br"]
slot_known = { tl = true, t = true, tr = true, l = true, c = true, r = true, bl = true, b = true, br = true }

| A command, from a key or a menu item.
Run { command } =>
    if command = "file.save", emit SaveFile to this
    if command = "file.close", emit RequestClose to this
    if command = "app.quit", emit RequestQuit to this
    if command = "tab.next" or command = "tab.previous"
        step = 1
        if command = "tab.previous", step = -1
        emit Stash to this
        emit StepTab { groups = groups, current = current, step = step } to this get stepped
        groups = stepped.groups
        emit Unstash to this
    if command = "editor.split" and file ≠ null
        emit Stash to this
        emit SplitGroups { groups = groups, current = current, buffer = file } to this get split_up
        groups = split_up.groups
        current = split_up.current
        emit Unstash to this
    if command = "view.moveTab"
        prompt = { kind = "move", label = "Move the tab to (l r t b c tl tr bl br): ", text = "" }
    if command[0, 13) = "view.moveTab."
        emit MoveCurrent { into = command[13, length) } to this
    if command[0, 10) = "view.edge."
        emit ResizeEdge { direction = command[10, length) } to this
    if command = "file.openFolder"
        prompt = { kind = "open_folder", label = "Open folder: ", text = folder + "/" }
    if command = "view.explorer"
        emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get shown_at
        if shown_at.group ≥ 0
            emit HideExplorer to this
            return Ran
        emit ShowExplorer { focused = true } to this
    if command = "view.explorerLeft", emit PlaceExplorer { slot = "l" } to this
    if command = "view.explorerRight", emit PlaceExplorer { slot = "r" } to this
    if command = "settings.open", emit OpenPrefsFile { name = "settings.json" } to this
    if command = "keybindings.open", emit OpenPrefsFile { name = "keybindings.json" } to this
    if command = "focus.explorer", emit ShowExplorer { focused = true } to this
    if command = "focus.editor", emit FocusSlot { slot = "c" } to this
    if command = "focus.group2", emit FocusSlot { slot = "r" } to this
    if command = "focus.next", emit FocusNext to this
    if command = "terminal.toggle", emit ToggleTerminal to this
    if command = "terminal.new", emit NewTerminal { slot = "" } to this
    if command = "menu.file", menu = { index = 0, item = 0 }
    if command = "menu.view", menu = { index = 1, item = 0 }
    if command = "menu.settings", menu = { index = 2, item = 0 }
    if command = "menu.help", menu = { index = 3, item = 0 }
    if command = "edit.undo" and focus = "editor", emit Undo to this
    if command = "edit.redo" and focus = "editor", emit Redo to this
    if command = "help.keys", emit ShowShortcuts to this
    if command = "help.about", message = "codelovesme ide — a terminal IDE for code, built on euglena"
    return Ran

| The focused tab moved to the group in `into`. The explorer remembers a
| side it is moved to.
MoveCurrent { into } =>
    if slot_known[into] ≠ true
        message = "Error: no place called \"" + into + "\" — l r t b c tl tr bl br"
        return Failed
    emit Active { groups = groups, current = current } to this get moving
    emit Stash to this
    emit MoveTab { groups = groups, current = current, into = into } to this get moved
    groups = moved.groups
    current = moved.current
    emit Unstash to this
    if moving.buffer ≠ null and moving.buffer.kind = "explorer"
        explorer_slot = into
        if into = "l", emit StoreSetting { key = "workbench.sideBar.location", value = "left" } to this
        if into = "r", emit StoreSetting { key = "workbench.sideBar.location", value = "right" } to this
    return Moved

| The explorer shown — its tab again if it is open, else a new one in the
| slot it was last in — and, when `focused`, given the keys.
ShowExplorer { focused } =>
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get where
    if where.group ≥ 0
        if focused, emit Reveal { group = where.group, tab = where.tab } to this
        return Shown
    keep = current
    emit Show { buffer = explorer_view, slot = explorer_slot } to this
    if not focused, emit FocusGroupAt { index = keep } to this
    if settings["workbench.sideBar.visible"] ≠ true, emit StoreSetting { key = "workbench.sideBar.visible", value = true } to this
    return Shown

HideExplorer =>
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get where
    if where.group < 0, return Nothing
    emit Stash to this
    emit CloseAt { groups = groups, current = current, group = where.group, tab = where.tab } to this get closed
    groups = closed.groups
    current = closed.current
    emit Unstash to this
    emit StoreSetting { key = "workbench.sideBar.visible", value = false } to this
    return Hidden

| View > Explorer on the Left / Right: moved there, and remembered.
PlaceExplorer { slot } =>
    explorer_slot = slot
    location = "left"
    if slot = "r", location = "right"
    emit StoreSetting { key = "workbench.sideBar.location", value = location } to this
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get where
    if where.group < 0, return Placed
    emit Reveal { group = where.group, tab = where.tab } to this
    emit MoveCurrent { into = slot } to this
    return Placed

| The tab at (`group`, `tab`) shown and focused.
Reveal { group, tab } =>
    emit Stash to this
    held = groups[group] + { active = tab }
    groups = groups[0, group) + [held] + groups(group, length)
    current = group
    emit Unstash to this
    return Revealed

FocusGroupAt { index } =>
    emit Length { value = groups } to core get { value as open_groups }
    if index < 0 or index ≥ open_groups, return Nothing
    emit Stash to this
    current = index
    emit Unstash to this
    return Focused

| The group in `slot` focused, if there is one.
FocusSlot { slot } =>
    emit GroupAt { groups = groups, slot = slot } to this get at
    if at.index < 0, return Nothing
    emit FocusGroupAt { index = at.index } to this
    return Focused

| F6: every group in slot order — top row, middle row, bottom — round again.
FocusNext =>
    order = []
    loop slot over slot_names
        emit GroupAt { groups = groups, slot = slot } to this get at
        if at.index ≥ 0, order += at.index
    emit Length { value = order } to core get { value as count }
    if count = 0, return Nothing
    next = order[0]
    loop i, index over order
        if index = current and i + 1 < count, next = order[i + 1]
    emit FocusGroupAt { index = next } to this
    return Focused

| Ctrl+K and an arrow: the edge of the focused group's side track moved
| that way — a group on the left grows with →, one at the bottom with ↑.
ResizeEdge { direction } =>
    group = groups[current]
    if group = null, return Nothing
    slot = group.slot
    left_side = slot = "l" or slot = "tl" or slot = "bl"
    right_side = slot = "r" or slot = "tr" or slot = "br"
    top_side = slot = "t" or slot = "tl" or slot = "tr"
    bottom_side = slot = "b" or slot = "bl" or slot = "br"
    | Which side track it is, and whether the arrow widens it (1) or not (-1).
    key = ""
    if left_side, key = "left"
    if right_side, key = "right"
    if (direction = "up" or direction = "down") and top_side, key = "top"
    if (direction = "up" or direction = "down") and bottom_side, key = "bottom"
    if (direction = "left" or direction = "right") and not left_side and not right_side, key = ""
    if (direction = "up" or direction = "down") and not top_side and not bottom_side, key = ""
    grows = { left = "right", right = "left", top = "down", bottom = "up" }
    change = -2
    if key ≠ "" and grows[key] = direction, change = 2
    if key = ""
        message = "The center grows as the sides shrink — resize a side instead"
        return Nothing
    size = sizes[key] + change
    if size < 3, size = 3
    emit StoreSetting { key = "workbench.layout." + key, value = size } to this
    return Resized

| Ctrl+`: a terminal — the first one if there is none (at the bottom); the
| keys back to the files if a terminal has them; else to the terminal.
ToggleTerminal =>
    emit Terminals { groups = groups } to this get open_terminals
    emit Length { value = open_terminals.ids } to core get { value as count }
    if count = 0
        emit NewTerminal { slot = "b" } to this
        return Toggled
    if focus = "terminal"
        emit FocusSlot { slot = "c" } to this get back
        if back ∉ Focused, emit FocusNext to this
        return Toggled
    emit FindTerminal { id = open_terminals.ids[0] } to this get where
    emit Reveal { group = where.group, tab = where.tab } to this
    return Toggled

| A new terminal: the shell in the open folder, as a tab in `slot` — or,
| with `slot` empty, beside the terminal that has the keys, else at the
| bottom.
NewTerminal { slot } =>
    target = slot
    if target = ""
        target = "b"
        if focus = "terminal", target = groups[current].slot
    open_request = Open { cols = 80, rows = 12, cwd = folder }
    shell = settings["terminal.integrated.shell"]
    if shell ≠ "", open_request = open_request + { command = shell }
    emit open_request to shells get opened
    if opened ∈ Exception
        message = "Error: a terminal could not be opened: " + opened.message
        return Failed
    terminals_opened += 1
    view = { kind = "terminal", path = "Terminal " + terminals_opened, store = "terminal", id = opened.id }
    emit Show { buffer = view, slot = target } to this
    return Opened

| A key while the status bar is asking something.
PromptKey { name, text } =>
    asked = prompt
    if name = "escape"
        prompt = null
        return Cancelled
    if asked.kind = "open_folder" or asked.kind = "move"
        if name = "enter"
            prompt = null
            if asked.kind = "open_folder", emit OpenFolder { path = asked.text } to this
            if asked.kind = "move", emit MoveCurrent { into = asked.text } to this
            return Answered
        if name = "backspace"
            prompt = asked + { text = asked.text[0, length - 1) }
            return Typed
        if text ≠ "", prompt = asked + { text = asked.text + text }
        return Typed
    | The rest are "save first?" — y, n, or escape.
    if name ≠ "y" and name ≠ "n", return Typed
    prompt = null
    if name = "y" and asked.kind = "close"
        emit SaveFile to this get saved
        if saved ∉ Saved, return Cancelled
    if name = "y" and asked.kind = "quit"
        emit SaveAll to this get all_saved
        if all_saved ∉ Saved, return Cancelled
    if asked.kind = "close", emit CloseFile to this
    if asked.kind = "quit", emit Quit to this
    return Answered

| `path` absolute, or relative to the folder open now, or under `~`.
OpenFolder { path } =>
    target = path
    emit Get { name = "HOME", default = "/" } to vars get home
    if target = "~" or target[0, 2) = "~/", target = home.value + target[1, length)
    if target[0] ≠ "/", target = folder + "/" + target
    | fs only sees inside its base, so the check is made from the root —
    | Config would create a folder that is not there.
    emit Config { base_path = "/" } to files
    emit Exists { path = target } to files get there
    if not there.is_dir
        if folder ≠ "", emit Config { base_path = folder } to files
        message = "Error: not a folder: " + path
        return Failed { reason = message }
    emit Config { base_path = target } to files get configured
    if configured ∈ Exception
        message = "Error: " + configured.message
        return Failed { reason = message }
    emit ListDir { path = "." } to files get listing
    if listing ∈ Exception
        message = "Error: " + listing.message
        return Failed { reason = message }
    emit Children { entries = listing.entries, parent = "", depth = 0 } to this get kids
    folder = configured.base_path
    tree = kids.nodes
    tree_sel = 0
    tree_top = 0
    | The files go; the explorer and the terminals stay where they are.
    emit Stash to this
    kept = []
    loop group over groups
        tabs = []
        loop tab over group.tabs
            if tab.kind ≠ "file", tabs += tab
        emit Length { value = tabs } to core get { value as left }
        if left > 0, kept += group + { tabs = tabs, active = 0 }
    groups = kept
    current = 0
    emit Unstash to this
    emit FindView { groups = groups, path = explorer_view.path, store = explorer_view.store } to this get explorer_at
    if explorer_at.group ≥ 0, emit Reveal { group = explorer_at.group, tab = explorer_at.tab } to this
    return Opened { folder = folder }

TreeKey { name } =>
    emit Length { value = tree } to core get { value as count }
    if count = 0, return Handled
    if name = "down" and tree_sel < count - 1, tree_sel += 1
    if name = "up" and tree_sel > 0, tree_sel = tree_sel - 1
    if name = "home", tree_sel = 0
    if name = "end", tree_sel = count - 1
    if name = "pagedown"
        tree_sel = tree_sel + tree_page
        if tree_sel > count - 1, tree_sel = count - 1
    if name = "pageup"
        tree_sel = tree_sel - tree_page
        if tree_sel < 0, tree_sel = 0
    node = tree[tree_sel]
    wants_open = name = "enter" or name = "right" or name = "space"
    if node.is_dir and wants_open and not node.open
        emit ListDir { path = node.path } to files get listing
        if listing ∈ Exception
            message = "Error: " + listing.message
            return Handled
        emit Children { entries = listing.entries, parent = node.path, depth = node.depth + 1 } to this get kids
        emit Expand { nodes = tree, index = tree_sel, children = kids.nodes } to this get grown
        tree = grown.nodes
        return Handled
    if node.is_dir and node.open and (name = "enter" or name = "left")
        emit Collapse { nodes = tree, index = tree_sel } to this get shrunk
        tree = shrunk.nodes
        return Handled
    if name = "left"
        emit Parent { nodes = tree, index = tree_sel } to this get up
        tree_sel = up.index
        return Handled
    if not node.is_dir and (name = "enter" or name = "space")
        keep = current
        emit OpenFile { path = node.path } to this get opened
        | Space shows the file and leaves the keys in the explorer.
        if opened ∈ Opened and name = "space", emit FocusGroupAt { index = keep } to this
    return Handled

| Where a file opens: the focused group when it shows a file, else the
| center.
EditorSlot =>
    emit Active { groups = groups, current = current } to this get shown
    if shown.buffer ≠ null and shown.buffer.kind = "file", return Slot { slot = groups[current].slot }
    return Slot { slot = "c" }

| A file from the open folder, in its own tab — or its tab again, wherever
| it is, as it was left.
OpenFile { path } =>
    emit Stash to this
    emit FindView { groups = groups, path = path, store = "workspace" } to this get found
    if found.group ≥ 0
        emit Reveal { group = found.group, tab = found.tab } to this
        return Opened
    emit ReadFile { path = path } to files get read
    if read ∈ Exception
        message = "Error: " + read.message
        return Failed
    emit Split { value = read.content, separator = "\n" } to texts get split
    emit EditorSlot to this get into
    emit Show { buffer = { kind = "file", path = path, store = "workspace", lines = split.value, row = 0, col = 0, want = 0, top = 0, left = 0, dirty = false, readonly = false }, slot = into.slot } to this
    return Opened

| `buffer` shown in the group in `slot`, in its tab, and focused.
Show { buffer, slot } =>
    emit Stash to this
    emit OpenIn { groups = groups, slot = slot, buffer = buffer } to this get opened_tab
    groups = opened_tab.groups
    current = opened_tab.current
    emit Unstash to this
    return Shown

| `file`, with its undo history, put back into its tab.
Stash =>
    if file = null, return Nothing
    emit PutActive { groups = groups, current = current, buffer = file + { undo = undo, redo = redo } } to this get put
    groups = put.groups
    return Stashed

| What the focused group shows decides what has the keys; a file is taken
| out of its tab to be worked on.
Unstash =>
    emit Active { groups = groups, current = current } to this get shown
    view = shown.buffer
    file = null
    undo = []
    redo = []
    last_edit = ""
    focus = "none"
    if view = null, return Unstashed
    if view.kind = "explorer", focus = "tree"
    if view.kind = "terminal", focus = "terminal"
    if view.kind = "file"
        focus = "editor"
        file = view
        if file.undo ≠ null, undo = file.undo
        if file.redo ≠ null, redo = file.redo
    return Unstashed

ShowShortcuts =>
    emit Shortcuts { table = keytable } to this get help
    emit EditorSlot to this get into
    emit Show { buffer = { kind = "file", path = "Keyboard Shortcuts", store = "help", lines = help.lines, row = 0, col = 0, want = 0, top = 0, left = 0, dirty = false, readonly = true }, slot = into.slot } to this
    return Shown

EditorKey { name, text } =>
    emit Edit { buffer = file, name = name, text = text, page = editor_page } to this get edited
    if edited ∈ Exception
        message = "Error: " + edited.message
        return Failed
    if not edited.changed
        last_edit = ""
        file = edited.buffer
        return Moved
    if file.readonly
        message = "This file is read-only."
        return Refused
    | Typing runs together into one undo step; every other edit is its own.
    kind = name
    if text ≠ "" and text ≠ " ", kind = "type"
    if not (kind = "type" and last_edit = "type")
        undo += { lines = file.lines, row = file.row, col = file.col }
        emit Length { value = undo } to core get { value as kept }
        if kept > max_undo, undo = undo[1, length)
    redo = []
    last_edit = kind
    file = edited.buffer + { dirty = true }
    return Changed

| The open file's text replaced whole, as one edit (what a paste of
| everything would be).
SetLines { lines } =>
    if file = null or file.readonly, return Nothing
    undo += { lines = file.lines, row = file.row, col = file.col }
    file = file + { lines = lines, row = 0, col = 0, want = 0, dirty = true }
    last_edit = ""
    return Changed

Undo =>
    emit Length { value = undo } to core get { value as count }
    if file = null or count = 0, return Nothing
    redo += { lines = file.lines, row = file.row, col = file.col }
    file = file + undo[count - 1] + { dirty = true }
    file = file + { want = file.col }
    undo = undo[0, count - 1)
    last_edit = ""
    return Undone

Redo =>
    emit Length { value = redo } to core get { value as count }
    if file = null or count = 0, return Nothing
    undo += { lines = file.lines, row = file.row, col = file.col }
    file = file + redo[count - 1] + { dirty = true }
    file = file + { want = file.col }
    redo = redo[0, count - 1)
    last_edit = ""
    return Redone

| `buffer` written where it came from.
WriteBuffer { buffer } =>
    emit Join { value = buffer.lines, separator = "\n" } to texts get joined
    store = files
    if buffer.store = "prefs", store = prefs
    emit WriteFile { path = buffer.path, content = joined.value } to store get written
    if written ∈ Exception, return Failed { reason = written.message }
    return Written

SaveFile =>
    if file = null, return Nothing
    if file.readonly, return Nothing
    emit WriteBuffer { buffer = file } to this get written
    if written ∈ Failed
        message = "Error: " + written.reason
        return Failed
    file = file + { dirty = false }
    message = "Saved " + file.path
    | Saving settings.json is how an edit to it takes effect.
    if file.store = "prefs" and file.path = "settings.json"
        emit LoadSettings to this get loaded
        if loaded.problem = "", message = "Settings saved and applied"
    if file.store = "prefs" and file.path = "keybindings.json"
        emit LoadKeybindings to this get bindings
        if bindings.problem = "", message = "Keyboard shortcuts saved and applied"
    return Saved

| Every file with unsaved changes written — before exit, when asked.
SaveAll =>
    emit Stash to this
    loop group over groups
        loop tab over group.tabs
            if tab.kind = "file" and tab.dirty
                emit WriteBuffer { buffer = tab } to this get written
                if written ∈ Failed
                    message = "Error: " + tab.path + ": " + written.reason
                    return Failed
    return Saved

RequestClose =>
    emit Active { groups = groups, current = current } to this get shown
    if shown.buffer = null, return Nothing
    if shown.buffer.kind = "terminal", emit Close { id = shown.buffer.id } to shells
    if shown.buffer.kind = "explorer"
        emit HideExplorer to this
        return Closed
    if file ≠ null and file.dirty
        prompt = { kind = "close", label = "Save changes to " + file.path + "? (y / n / Escape) ", text = "" }
        return Asked
    emit CloseFile to this
    return Closed

| The focused tab closed; its group goes when it was the last one there.
CloseFile =>
    emit Stash to this
    emit CloseTab { groups = groups, current = current } to this get closed
    groups = closed.groups
    current = closed.current
    emit Unstash to this
    return Closed

RequestQuit =>
    emit Stash to this
    emit Unsaved { groups = groups } to this get unsaved
    if unsaved.count = 1
        prompt = { kind = "quit", label = "Save changes to " + unsaved.first + " before exit? (y / n / Escape) ", text = "" }
        return Asked
    if unsaved.count > 1
        prompt = { kind = "quit", label = "" + unsaved.count + " files have unsaved changes. Save them all before exit? (y / n / Escape) ", text = "" }
        return Asked
    emit Quit to this
    return Quitting

Quit =>
    running = false
    emit Terminals { groups = groups } to this get open_terminals
    loop id over open_terminals.ids
        emit Close { id = id } to shells
    emit Stop {} to term
    return Quitting

| Where the settings are kept: `dir`/settings.json. Loads them.
SettingsAt { dir } =>
    emit Config { base_path = dir } to prefs get configured
    if configured ∈ Exception
        message = "Error: settings: " + configured.message
        return Failed
    settings_dir = configured.base_path
    emit LoadKeybindings to this
    emit LoadSettings to this get loaded
    return loaded

| keybindings.json read and turned into the key table. A missing file is
| the defaults; a bad entry is left out, and the status bar says why.
LoadKeybindings =>
    emit Exists { path = "keybindings.json" } to prefs get there
    text = null
    if there.is_file
        emit ReadFile { path = "keybindings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadBindings { text = text } to this get table
    keytable = table
    if table.problem ≠ "", message = "Error: " + table.problem
    return table

| settings.json read, checked and applied. A missing file is the defaults.
LoadSettings =>
    emit Exists { path = "settings.json" } to prefs get there
    text = null
    if there.is_file
        emit ReadFile { path = "settings.json" } to prefs get read
        if read ∉ Exception, text = read.content
    emit ReadSettings { text = text } to this get read_back
    settings = read_back.values
    if settings["workbench.sideBar.location"] = "right" and explorer_slot = "l", explorer_slot = "r"
    if settings["workbench.sideBar.location"] = "left" and explorer_slot = "r", explorer_slot = "l"
    sizes = {
        left = settings["workbench.layout.left"]
        right = settings["workbench.layout.right"]
        top = settings["workbench.layout.top"]
        bottom = settings["workbench.layout.bottom"]
    }
    if read_back.problem ≠ "", message = "Error: " + read_back.problem
    return read_back

| One setting changed from inside the ide (Ctrl+B, moving or resizing the
| explorer): applied, and written to settings.json — which, if it is open
| and unedited, shows the change too.
StoreSetting { key, value } =>
    settings = settings + { "$key" = value }
    emit WriteSettings { values = settings } to this get written_text
    emit WriteFile { path = "settings.json", content = written_text.text } to prefs get written
    if written ∈ Exception
        message = "Error: settings could not be saved: " + written.message
    emit LoadSettings to this
    if file ≠ null and file.store = "prefs" and file.path = "settings.json" and not file.dirty
        emit Split { value = written_text.text, separator = "\n" } to texts get fresh
        file = file + { lines = fresh.value }
    return Stored

| settings.json (Ctrl+,) or keybindings.json in the editor, made first if
| there is none yet.
OpenPrefsFile { name } =>
    emit Exists { path = name } to prefs get there
    if not there.is_file
        first_text = "[\n]\n"
        if name = "settings.json"
            emit WriteSettings { values = settings } to this get written_settings
            first_text = written_settings.text
        emit WriteFile { path = name, content = first_text } to prefs
    emit ReadFile { path = name } to prefs get read
    if read ∈ Exception
        message = "Error: " + read.message
        return Failed
    emit Split { value = read.content, separator = "\n" } to texts get split
    emit EditorSlot to this get into
    emit Show { buffer = { kind = "file", path = name, store = "prefs", lines = split.value, row = 0, col = 0, want = 0, top = 0, left = 0, dirty = false, readonly = false }, slot = into.slot } to this
    return Opened

| Everything the screen is drawn from, in one particle.
State =>
    emit Stash to this
    return IdeState {
        groups = groups
        current = current
        cols = cols
        rows = rows
        folder = folder
        tree = tree
        tree_sel = tree_sel
        tree_top = tree_top
        file = file
        focus = focus
        menu = menu
        prompt = prompt
        message = message
        sizes = sizes
        keytable = keytable
    }

| The screen of every terminal a group shows, each told first how big it
| is when that changed.
TerminalScreens { placed } =>
    screens = {}
    loop pane over placed
        group = groups[pane.id]
        view = group.tabs[group.active]
        if view.kind = "terminal"
            wide = pane.width - 1
            if pane.x = 0, wide = pane.width
            high = pane.height - 1
            size = "" + wide + "x" + high
            if terminal_sizes["$view.id"] ≠ size and wide > 0 and high > 0
                emit Resize { id = view.id, cols = wide, rows = high } to shells
                terminal_sizes = terminal_sizes + { "$view.id" = size }
            emit Screen { id = view.id } to shells get screen
            if screen ∉ Exception, screens = screens + { "$view.id" = screen }
    return Screens { screens = screens }

Render =>
    if not running, return Skipped
    emit State to this get state
    emit Placement { state = state } to this get placement
    emit TerminalScreens { placed = placement.placed } to this get terminal_screens
    emit Frame { state = state, placement = placement, screens = terminal_screens.screens } to this get screen
    if screen ∈ Exception
        emit Draw { rows = [[{ text = " Error: the screen could not be drawn: " + screen.message, style = "status_warn" }]] } to term
        return Failed
    tree_top = screen.tree_top
    tree_page = screen.tree_page
    editor_page = screen.page
    | Each group keeps how far its file was scrolled.
    loop scrolled_view over screen.views
        i = scrolled_view.group
        if i = current and file ≠ null, file = file + { top = scrolled_view.top, left = scrolled_view.left }
        if i ≠ current
            shown = groups[i].tabs[groups[i].active]
            emit PutActive { groups = groups, current = i, buffer = shown + { top = scrolled_view.top, left = scrolled_view.left } } to this get scrolled
            groups = scrolled.groups
    emit Draw { overlays = screen.overlays, cursor_row = screen.cursor_row, cursor_col = screen.cursor_col } to term
    return Rendered
