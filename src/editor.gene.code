| Editor — what a key does to a buffer. Pure: a buffer and a key in, the
| buffer after it out, and whether its text changed (so the caller knows
| to mark it dirty and remember it for undo).
|
| A buffer is `{ lines, row, col, want, … }`: the text as a list of lines,
| the cursor, and `want` — the column the cursor would like to be in, kept
| across short lines while moving up and down. Other fields ride along.
|
| Indentation is spaces, four to a level (code refuses tabs). Enter keeps
| the line's indentation and adds a level after a block header: a line
| ending in `=>`, or an `if` / `loop` with no `,` (one with a comma has its
| body on the same line).

| The `strings` organelle, handed over when the ide links it.
texts = null

EditorUses { texts as given } =>
    texts = given
    return Using

indent_unit = 4

| Characters a word stops at, for ctrl+left / ctrl+right.
separators = {
    " " = true
    "." = true
    "," = true
    "(" = true
    ")" = true
    "[" = true
    "]" = true
    "{" = true
    "}" = true
    "=" = true
    "+" = true
    "-" = true
    "*" = true
    "/" = true
    "\"" = true
    "|" = true
    ":" = true
}

| The indentation of `line` (as spaces), and whether it opens a block.
Indent { line } =>
    n = 0
    loop
        if line[n] ≠ " ", break
        n += 1
    emit Trim { value = line } to texts get trimmed
    body = trimmed.value
    emit Length { value = body } to core get { value as size }
    opens = false
    if size ≥ 2 and body[size - 2, size) = "=>", opens = true
    if body[0, 3) = "if " or body = "loop" or body[0, 5) = "loop "
        emit Split { value = body, separator = "," } to texts get parts
        emit Length { value = parts.value } to core get { value as pieces }
        if pieces = 1, opens = true
    return Indented { spaces = line[0, n), width = n, opens = opens }

| The column a word move lands on, going `step` (1 or -1) from `col`.
WordMove { line, col, step } =>
    emit Length { value = line } to core get { value as size }
    at = col
    if step < 0
        loop
            if at = 0 or separators[line[at - 1]] ≠ true, break
            at = at - 1
        loop
            if at = 0 or separators[line[at - 1]] = true, break
            at = at - 1
    if step > 0
        loop
            if at ≥ size or separators[line[at]] ≠ true, break
            at += 1
        loop
            if at ≥ size or separators[line[at]] = true, break
            at += 1
    return Moved { col = at }

| The keys that move the cursor — with Shift, they select.
moves = { left = true, right = true, up = true, down = true, home = true, "end" = true, pageup = true, pagedown = true, "ctrl+left" = true, "ctrl+right" = true, "ctrl+home" = true, "ctrl+end" = true }

| The selection of `buffer` in order: from `start` to `stop` (each
| `{ row, col }`); `empty` when there is none. `buffer.anchor` is where it
| began, the cursor where it ends.
Selection { buffer } =>
    here = { row = buffer.row, col = buffer.col }
    anchor = buffer.anchor
    if anchor = null, return Range { start = here, stop = here, empty = true }
    if anchor.row = here.row and anchor.col = here.col, return Range { start = here, stop = here, empty = true }
    if anchor.row < here.row or (anchor.row = here.row and anchor.col < here.col), return Range { start = anchor, stop = here, empty = false }
    return Range { start = here, stop = anchor, empty = false }

| The selected text (lines joined with "\n"), "" with none.
SelectedText { buffer } =>
    emit Selection { buffer = buffer } to this get picked
    if picked.empty, return Text { text = "" }
    start = picked.start
    stop = picked.stop
    if start.row = stop.row, return Text { text = buffer.lines[start.row][start.col, stop.col) }
    out = buffer.lines[start.row][start.col, length)
    r = start.row + 1
    loop
        if r ≥ stop.row, break
        out = out + "\n" + buffer.lines[r]
        r += 1
    out = out + "\n" + buffer.lines[stop.row][0, stop.col)
    return Text { text = out }

| The selection taken out; the cursor where it began.
DeleteSelection { buffer } =>
    emit Selection { buffer = buffer } to this get picked
    if picked.empty, return Edited { buffer = buffer + { anchor = null }, changed = false }
    start = picked.start
    stop = picked.stop
    lines = buffer.lines
    joined = lines[start.row][0, start.col) + lines[stop.row][stop.col, length)
    lines = lines[0, start.row) + [joined] + lines(stop.row, length)
    return Edited { buffer = buffer + { lines = lines, row = start.row, col = start.col, want = start.col, anchor = null }, changed = true }

| `text` put in at the cursor, over the selection — its line breaks kept
| (a paste).
InsertText { buffer, text } =>
    emit DeleteSelection { buffer = buffer } to this get cleared
    current = cleared.buffer
    emit Split { value = text, separator = "\n" } to texts get parts
    pieces = parts.value
    emit Length { value = pieces } to core get { value as count }
    line = current.lines[current.row]
    head = line[0, current.col)
    tail = line[current.col, length)
    if count = 1
        emit Length { value = text } to core get { value as added }
        lines = current.lines[0, current.row) + [head + text + tail] + current.lines(current.row, length)
        return Edited { buffer = current + { lines = lines, col = current.col + added, want = current.col + added }, changed = true }
    middle = []
    if count > 2, middle = pieces[1, count - 1)
    last_piece = pieces[count - 1]
    emit Length { value = last_piece } to core get { value as last_size }
    lines = current.lines[0, current.row) + [head + pieces[0]] + middle + [last_piece + tail] + current.lines(current.row, length)
    return Edited { buffer = current + { lines = lines, row = current.row + count - 1, col = last_size, want = last_size }, changed = true }

| One key applied to `buffer`. `page` is how many lines pageup/pagedown
| move. Answers `Edited { buffer, changed }`. Shift and a move key select
| (from `anchor`); typing, Enter, Backspace and Delete take the selection
| out first; any other key lets it go. Ctrl+A selects everything.
Edit { buffer, name, text, page } =>
    emit Length { value = buffer.lines } to core get { value as count }
    if name = "ctrl+a"
        emit Length { value = buffer.lines[count - 1] } to core get { value as last }
        return Edited { buffer = buffer + { anchor = { row = 0, col = 0 }, row = count - 1, col = last, want = last }, changed = false }
    base_key = ""
    if name[0, 6) = "shift+", base_key = name[6, length)
    if name[0, 11) = "ctrl+shift+", base_key = "ctrl+" + name[11, length)
    if base_key ≠ "" and moves[base_key] = true
        keep = buffer.anchor
        if keep = null, keep = { row = buffer.row, col = buffer.col }
        emit EditPlain { buffer = buffer, name = base_key, text = "", page = page } to this get moved
        return Edited { buffer = moved.buffer + { anchor = keep }, changed = false }
    emit Selection { buffer = buffer } to this get picked
    takes = text ≠ "" or name = "enter" or name = "backspace" or name = "delete"
    if not picked.empty and takes
        emit DeleteSelection { buffer = buffer } to this get cleared
        if name = "backspace" or name = "delete", return cleared
        emit EditPlain { buffer = cleared.buffer, name = name, text = text, page = page } to this get then
        return Edited { buffer = then.buffer + { anchor = null }, changed = true }
    emit EditPlain { buffer = buffer + { anchor = null }, name = name, text = text, page = page } to this get plain
    return plain

| One key, no selection involved.
EditPlain { buffer, name, text, page } =>
    lines = buffer.lines
    row = buffer.row
    col = buffer.col
    want = buffer.want
    line = lines[row]
    emit Length { value = line } to core get { value as size }
    emit Length { value = lines } to core get { value as count }

    | Typing.
    if text ≠ ""
        emit Length { value = text } to core get { value as typed }
        line = line[0, col) + text + line[col, length)
        lines = lines[0, row) + [line] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = col + typed, want = col + typed }, changed = true }

    if name = "enter"
        emit Indent { line = line[0, col) } to this get indent
        pad = indent.spaces
        if indent.opens, pad = pad + "    "
        emit Length { value = pad } to core get { value as padded }
        emit Trim { value = line[col, length) } to texts get rest_trim
        rest = line[col, length)
        if rest_trim.value = "", rest = ""
        lines = lines[0, row) + [line[0, col), pad + rest] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, row = row + 1, col = padded, want = padded }, changed = true }

    if name = "tab"
        stop = 0
        loop
            stop += indent_unit
            if stop > col, break
        added = stop - col
        spaces = "        "[0, added)
        line = line[0, col) + spaces + line[col, length)
        lines = lines[0, row) + [line] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = col + added, want = col + added }, changed = true }

    if name = "shift+tab"
        emit Indent { line = line } to this get indent
        take = indent.width
        if take > indent_unit, take = indent_unit
        if take = 0, return Edited { buffer = buffer, changed = false }
        at = col - take
        if at < 0, at = 0
        lines = lines[0, row) + [line[take, length)] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = at, want = at }, changed = true }

    if name = "backspace"
        if col > 0
            take = 1
            emit Trim { value = line[0, col) } to texts get before
            if before.value = ""
                stop = 0
                loop
                    if stop + indent_unit ≥ col, break
                    stop += indent_unit
                take = col - stop
            line = line[0, col - take) + line[col, length)
            lines = lines[0, row) + [line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines, col = col - take, want = col - take }, changed = true }
        if row > 0
            above = lines[row - 1]
            emit Length { value = above } to core get { value as joined_at }
            lines = lines[0, row - 1) + [above + line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines, row = row - 1, col = joined_at, want = joined_at }, changed = true }
        return Edited { buffer = buffer, changed = false }

    if name = "delete"
        if col < size
            line = line[0, col) + line(col, length)
            lines = lines[0, row) + [line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines }, changed = true }
        if row < count - 1
            lines = lines[0, row) + [line + lines[row + 1]] + lines(row + 1, length)
            return Edited { buffer = buffer + { lines = lines }, changed = true }
        return Edited { buffer = buffer, changed = false }

    | Moving: the text stays, the cursor goes.
    if name = "left"
        if col > 0, col = col - 1
        if col = buffer.col and row > 0
            row = row - 1
            emit Length { value = lines[row] } to core get { value as above }
            col = above
        return Edited { buffer = buffer + { row = row, col = col, want = col }, changed = false }

    if name = "right"
        if col < size, col += 1
        if col = buffer.col and row < count - 1
            row += 1
            col = 0
        return Edited { buffer = buffer + { row = row, col = col, want = col }, changed = false }

    if name = "home"
        emit Indent { line = line } to this get indent
        col = indent.width
        if buffer.col = indent.width, col = 0
        return Edited { buffer = buffer + { col = col, want = col }, changed = false }

    if name = "end"
        return Edited { buffer = buffer + { col = size, want = size }, changed = false }

    if name = "ctrl+home"
        return Edited { buffer = buffer + { row = 0, col = 0, want = 0 }, changed = false }

    if name = "ctrl+end"
        emit Length { value = lines[count - 1] } to core get { value as last }
        return Edited { buffer = buffer + { row = count - 1, col = last, want = last }, changed = false }

    if name = "ctrl+left" or name = "ctrl+right"
        step = 1
        if name = "ctrl+left", step = -1
        if name = "ctrl+left" and col = 0 and row > 0
            emit Length { value = lines[row - 1] } to core get { value as above }
            return Edited { buffer = buffer + { row = row - 1, col = above, want = above }, changed = false }
        if name = "ctrl+right" and col = size and row < count - 1
            return Edited { buffer = buffer + { row = row + 1, col = 0, want = 0 }, changed = false }
        emit WordMove { line = line, col = col, step = step } to this get moved
        return Edited { buffer = buffer + { col = moved.col, want = moved.col }, changed = false }

    | Ctrl+↑ / Ctrl+↓: the view a line up or down; the cursor only moves to
    | stay in it.
    if name = "ctrl+up" or name = "ctrl+down"
        top = buffer.top
        if top = null, top = 0
        if name = "ctrl+up" and top > 0, top = top - 1
        if name = "ctrl+down" and top < count - 1, top += 1
        if row < top, row = top
        if page > 0 and row > top + page - 1, row = top + page - 1
        if row = buffer.row, return Edited { buffer = buffer + { top = top }, changed = false }
        emit Length { value = lines[row] } to core get { value as there }
        col = want
        if col > there, col = there
        return Edited { buffer = buffer + { top = top, row = row, col = col }, changed = false }

    | Up and down keep `want`, the column the cursor would like to be in.
    target = row
    if name = "up", target = row - 1
    if name = "down", target = row + 1
    if name = "pageup", target = row - page
    if name = "pagedown", target = row + page
    if target ≠ row
        if target < 0
            return Edited { buffer = buffer + { row = 0, col = 0 }, changed = false }
        if target > count - 1
            emit Length { value = lines[count - 1] } to core get { value as last }
            return Edited { buffer = buffer + { row = count - 1, col = last }, changed = false }
        emit Length { value = lines[target] } to core get { value as there }
        col = want
        if col > there, col = there
        return Edited { buffer = buffer + { row = target, col = col }, changed = false }

    return Edited { buffer = buffer, changed = false }
