| Editor — what a key does to a buffer. Pure: a buffer and a key in, the
| buffer after it out, and whether its text changed (so the caller knows
| to mark it dirty and remember it for undo).
|
| A buffer is `{ lines, row, col, want, … }`: the text as a list of lines,
| the cursor, and `want` — the column the cursor would like to be in, kept
| across short lines while moving up and down. Other fields ride along.
|
| Indentation is spaces, four to a level (code refuses tabs). Enter keeps
| the line's indentation and adds a level after a block header: a line
| ending in `=>`, or an `if` / `loop` with no `,` (one with a comma has its
| body on the same line).

| The `strings` organelle, handed over when the ide links it.
texts = null

EditorUses { texts as given } =>
    texts = given
    return Using

indent_unit = 4

| Characters a word stops at, for ctrl+left / ctrl+right.
separators = {
    " " = true
    "." = true
    "," = true
    "(" = true
    ")" = true
    "[" = true
    "]" = true
    "{" = true
    "}" = true
    "=" = true
    "+" = true
    "-" = true
    "*" = true
    "/" = true
    "\"" = true
    "|" = true
    ":" = true
}

| The indentation of `line` (as spaces), and whether it opens a block.
Indent { line } =>
    n = 0
    loop
        if line[n] ≠ " ", break
        n += 1
    emit Trim { value = line } to texts get trimmed
    body = trimmed.value
    emit Length { value = body } to core get { value as size }
    opens = false
    if size ≥ 2 and body[size - 2, size) = "=>", opens = true
    if body[0, 3) = "if " or body = "loop" or body[0, 5) = "loop "
        emit Split { value = body, separator = "," } to texts get parts
        emit Length { value = parts.value } to core get { value as pieces }
        if pieces = 1, opens = true
    return Indented { spaces = line[0, n), width = n, opens = opens }

| The column a word move lands on, going `step` (1 or -1) from `col`.
WordMove { line, col, step } =>
    emit Length { value = line } to core get { value as size }
    at = col
    if step < 0
        loop
            if at = 0 or separators[line[at - 1]] ≠ true, break
            at = at - 1
        loop
            if at = 0 or separators[line[at - 1]] = true, break
            at = at - 1
    if step > 0
        loop
            if at ≥ size or separators[line[at]] ≠ true, break
            at += 1
        loop
            if at ≥ size or separators[line[at]] = true, break
            at += 1
    return Moved { col = at }

| What closes each bracket and quote typed (it closes itself), and which
| are quotes (not closed after a letter: don't).
pairs = { "(" = ")", "[" = "]", "{" = "}", "\"" = "\"", "'" = "'", "`" = "`" }
closers = { ")" = true, "]" = true, "}" = true, "\"" = true, "'" = true, "`" = true }
quotes = { "\"" = true, "'" = true, "`" = true }

| The comment mark of each language, by the file's extension (or its name,
| for those that have none).
comment_marks = {
    code = "|"
    py = "#"
    sh = "#"
    bash = "#"
    zsh = "#"
    yaml = "#"
    yml = "#"
    toml = "#"
    rb = "#"
    pl = "#"
    r = "#"
    conf = "#"
    Makefile = "#"
    Dockerfile = "#"
    js = "//"
    mjs = "//"
    cjs = "//"
    jsx = "//"
    ts = "//"
    tsx = "//"
    rs = "//"
    go = "//"
    c = "//"
    h = "//"
    cc = "//"
    cpp = "//"
    hpp = "//"
    java = "//"
    kt = "//"
    swift = "//"
    cs = "//"
    dart = "//"
    php = "//"
    scss = "//"
    sql = "--"
    lua = "--"
    hs = "--"
}

| The keys that move the cursor — with Shift, they select.
moves = { left = true, right = true, up = true, down = true, home = true, "end" = true, pageup = true, pagedown = true, "ctrl+left" = true, "ctrl+right" = true, "ctrl+home" = true, "ctrl+end" = true }

| The selection of `buffer` in order: from `start` to `stop` (each
| `{ row, col }`); `empty` when there is none. `buffer.anchor` is where it
| began, the cursor where it ends.
Selection { buffer } =>
    here = { row = buffer.row, col = buffer.col }
    anchor = buffer.anchor
    if anchor = null, return Range { start = here, stop = here, empty = true }
    if anchor.row = here.row and anchor.col = here.col, return Range { start = here, stop = here, empty = true }
    if anchor.row < here.row or (anchor.row = here.row and anchor.col < here.col), return Range { start = anchor, stop = here, empty = false }
    return Range { start = here, stop = anchor, empty = false }

| Where `part` first is in `text` at or after character `from`, or -1
| (the strings organelle in use has no IndexOf).
IndexIn { text, part, from } =>
    emit Length { value = text } to core get { value as size }
    emit Length { value = part } to core get { value as want }
    i = from
    loop
        if i + want > size, break
        if text[i, i + want) = part, return At { value = i }
        i += 1
    return At { value = -1 }

| The selected text (lines joined with "\n"), "" with none.
SelectedText { buffer } =>
    emit Selection { buffer = buffer } to this get picked
    if picked.empty, return Text { text = "" }
    start = picked.start
    stop = picked.stop
    if start.row = stop.row, return Text { text = buffer.lines[start.row][start.col, stop.col) }
    out = buffer.lines[start.row][start.col, length)
    r = start.row + 1
    loop
        if r ≥ stop.row, break
        out = out + "\n" + buffer.lines[r]
        r += 1
    out = out + "\n" + buffer.lines[stop.row][0, stop.col)
    return Text { text = out }

| The selection taken out; the cursor where it began.
DeleteSelection { buffer } =>
    emit Selection { buffer = buffer } to this get picked
    if picked.empty, return Edited { buffer = buffer + { anchor = null }, changed = false }
    start = picked.start
    stop = picked.stop
    lines = buffer.lines
    joined = lines[start.row][0, start.col) + lines[stop.row][stop.col, length)
    lines = lines[0, start.row) + [joined] + lines(stop.row, length)
    return Edited { buffer = buffer + { lines = lines, row = start.row, col = start.col, want = start.col, anchor = null }, changed = true }

| `text` put in at the cursor, over the selection — its line breaks kept
| (a paste).
InsertText { buffer, text } =>
    emit DeleteSelection { buffer = buffer } to this get cleared
    current = cleared.buffer
    emit Split { value = text, separator = "\n" } to texts get parts
    pieces = parts.value
    emit Length { value = pieces } to core get { value as count }
    line = current.lines[current.row]
    head = line[0, current.col)
    tail = line[current.col, length)
    if count = 1
        emit Length { value = text } to core get { value as added }
        lines = current.lines[0, current.row) + [head + text + tail] + current.lines(current.row, length)
        return Edited { buffer = current + { lines = lines, col = current.col + added, want = current.col + added }, changed = true }
    middle = []
    if count > 2, middle = pieces[1, count - 1)
    last_piece = pieces[count - 1]
    emit Length { value = last_piece } to core get { value as last_size }
    lines = current.lines[0, current.row) + [head + pieces[0]] + middle + [last_piece + tail] + current.lines(current.row, length)
    return Edited { buffer = current + { lines = lines, row = current.row + count - 1, col = last_size, want = last_size }, changed = true }

| One key applied to `buffer`. `page` is how many lines pageup/pagedown
| move. Answers `Edited { buffer, changed }`. Shift and a move key select
| (from `anchor`); typing, Enter, Backspace and Delete take the selection
| out first; any other key lets it go. Ctrl+A selects everything.
Edit { buffer, name, text, page } =>
    emit Length { value = buffer.lines } to core get { value as count }
    if name = "alt+up" or name = "alt+down"
        step = 1
        if name = "alt+up", step = -1
        emit MoveLines { buffer = buffer, step = step } to this get shifted
        return shifted
    if name = "ctrl+/"
        emit ToggleComment { buffer = buffer } to this get toggled
        return toggled
    if name = "ctrl+shift+alt+up" or name = "ctrl+shift+alt+down"
        emit CopyLines { buffer = buffer, down = name = "ctrl+shift+alt+down" } to this get copied
        return copied
    if name = "ctrl+a"
        emit Length { value = buffer.lines[count - 1] } to core get { value as last }
        return Edited { buffer = buffer + { anchor = { row = 0, col = 0 }, row = count - 1, col = last, want = last }, changed = false }
    base_key = ""
    if name[0, 6) = "shift+", base_key = name[6, length)
    if name[0, 11) = "ctrl+shift+", base_key = "ctrl+" + name[11, length)
    | Ctrl+Shift+↑ / ↓ select as Shift+↑ / ↓ do (Ctrl+↑ / ↓ alone scroll).
    if name = "ctrl+shift+up" or name = "ctrl+shift+down", base_key = name[11, length)
    if base_key ≠ "" and moves[base_key] = true
        keep = buffer.anchor
        if keep = null, keep = { row = buffer.row, col = buffer.col }
        emit EditPlain { buffer = buffer, name = base_key, text = "", page = page } to this get moved
        return Edited { buffer = moved.buffer + { anchor = keep }, changed = false }
    emit Selection { buffer = buffer } to this get picked
    | A bracket or quote typed over a selection wraps it.
    if not picked.empty and pairs[text] ≠ null
        start = picked.start
        stop = picked.stop
        lines = buffer.lines
        closed = lines[stop.row][0, stop.col) + pairs[text] + lines[stop.row][stop.col, length)
        lines = lines[0, stop.row) + [closed] + lines(stop.row, length)
        opened = lines[start.row][0, start.col) + text + lines[start.row][start.col, length)
        lines = lines[0, start.row) + [opened] + lines(start.row, length)
        stop_col = stop.col
        if stop.row = start.row, stop_col += 1
        return Edited { buffer = buffer + { lines = lines, anchor = { row = start.row, col = start.col + 1 }, row = stop.row, col = stop_col, want = stop_col }, changed = true }
    rubs = name = "backspace" or name = "delete" or name = "ctrl+backspace" or name = "ctrl+delete"
    takes = text ≠ "" or name = "enter" or rubs
    if not picked.empty and takes
        emit DeleteSelection { buffer = buffer } to this get cleared
        if rubs, return cleared
        emit EditPlain { buffer = cleared.buffer, name = name, text = text, page = page } to this get then
        return Edited { buffer = then.buffer + { anchor = null }, changed = true }
    emit EditPlain { buffer = buffer + { anchor = null }, name = name, text = text, page = page } to this get plain
    return plain

| One key, no selection involved.
EditPlain { buffer, name, text, page } =>
    lines = buffer.lines
    row = buffer.row
    col = buffer.col
    want = buffer.want
    line = lines[row]
    emit Length { value = line } to core get { value as size }
    emit Length { value = lines } to core get { value as count }

    | Typing. The closer typed where it already is steps over it; a
    | bracket or quote closes itself before a space, a closer or the end
    | (a quote not after a letter).
    if text ≠ ""
        next = line[col]
        if next = null, next = ""
        if closers[text] = true and next = text
            return Edited { buffer = buffer + { col = col + 1, want = col + 1 }, changed = false }
        closer = pairs[text]
        if closer ≠ null
            closes = next = "" or next = " " or closers[next] = true
            if quotes[text] = true and col > 0 and separators[line[col - 1]] ≠ true, closes = false
            if closes
                line = line[0, col) + text + closer + line[col, length)
                lines = lines[0, row) + [line] + lines(row, length)
                return Edited { buffer = buffer + { lines = lines, col = col + 1, want = col + 1 }, changed = true }
        emit Length { value = text } to core get { value as typed }
        line = line[0, col) + text + line[col, length)
        lines = lines[0, row) + [line] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = col + typed, want = col + typed }, changed = true }

    if name = "enter"
        emit Indent { line = line[0, col) } to this get indent
        pad = indent.spaces
        if indent.opens, pad = pad + "    "
        emit Length { value = pad } to core get { value as padded }
        emit Trim { value = line[col, length) } to texts get rest_trim
        rest = line[col, length)
        if rest_trim.value = "", rest = ""
        lines = lines[0, row) + [line[0, col), pad + rest] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, row = row + 1, col = padded, want = padded }, changed = true }

    if name = "tab"
        stop = 0
        loop
            stop += indent_unit
            if stop > col, break
        added = stop - col
        spaces = "        "[0, added)
        line = line[0, col) + spaces + line[col, length)
        lines = lines[0, row) + [line] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = col + added, want = col + added }, changed = true }

    if name = "shift+tab"
        emit Indent { line = line } to this get indent
        take = indent.width
        if take > indent_unit, take = indent_unit
        if take = 0, return Edited { buffer = buffer, changed = false }
        at = col - take
        if at < 0, at = 0
        lines = lines[0, row) + [line[take, length)] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = at, want = at }, changed = true }

    | Ctrl+Backspace / Ctrl+Delete: a word back / forward; at a line's edge,
    | what Backspace / Delete do.
    if name = "ctrl+backspace"
        if col = 0
            if row = 0, return Edited { buffer = buffer, changed = false }
            above = lines[row - 1]
            emit Length { value = above } to core get { value as joined_at }
            lines = lines[0, row - 1) + [above + line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines, row = row - 1, col = joined_at, want = joined_at }, changed = true }
        emit WordMove { line = line, col = col, step = -1 } to this get back_to
        line = line[0, back_to.col) + line[col, length)
        lines = lines[0, row) + [line] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines, col = back_to.col, want = back_to.col }, changed = true }

    if name = "ctrl+delete"
        if col = size
            if row = count - 1, return Edited { buffer = buffer, changed = false }
            lines = lines[0, row) + [line + lines[row + 1]] + lines(row + 1, length)
            return Edited { buffer = buffer + { lines = lines }, changed = true }
        emit WordMove { line = line, col = col, step = 1 } to this get on_to
        line = line[0, col) + line[on_to.col, length)
        lines = lines[0, row) + [line] + lines(row, length)
        return Edited { buffer = buffer + { lines = lines }, changed = true }

    if name = "backspace"
        | Between an empty pair: both go.
        if col > 0 and line[col] ≠ null and pairs[line[col - 1]] = line[col]
            line = line[0, col - 1) + line[col + 1, length)
            lines = lines[0, row) + [line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines, col = col - 1, want = col - 1 }, changed = true }
        if col > 0
            take = 1
            emit Trim { value = line[0, col) } to texts get before
            if before.value = ""
                stop = 0
                loop
                    if stop + indent_unit ≥ col, break
                    stop += indent_unit
                take = col - stop
            line = line[0, col - take) + line[col, length)
            lines = lines[0, row) + [line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines, col = col - take, want = col - take }, changed = true }
        if row > 0
            above = lines[row - 1]
            emit Length { value = above } to core get { value as joined_at }
            lines = lines[0, row - 1) + [above + line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines, row = row - 1, col = joined_at, want = joined_at }, changed = true }
        return Edited { buffer = buffer, changed = false }

    if name = "delete"
        if col < size
            line = line[0, col) + line(col, length)
            lines = lines[0, row) + [line] + lines(row, length)
            return Edited { buffer = buffer + { lines = lines }, changed = true }
        if row < count - 1
            lines = lines[0, row) + [line + lines[row + 1]] + lines(row + 1, length)
            return Edited { buffer = buffer + { lines = lines }, changed = true }
        return Edited { buffer = buffer, changed = false }

    | Moving: the text stays, the cursor goes.
    if name = "left"
        if col > 0, col = col - 1
        if col = buffer.col and row > 0
            row = row - 1
            emit Length { value = lines[row] } to core get { value as above }
            col = above
        return Edited { buffer = buffer + { row = row, col = col, want = col }, changed = false }

    if name = "right"
        if col < size, col += 1
        if col = buffer.col and row < count - 1
            row += 1
            col = 0
        return Edited { buffer = buffer + { row = row, col = col, want = col }, changed = false }

    if name = "home"
        emit Indent { line = line } to this get indent
        col = indent.width
        if buffer.col = indent.width, col = 0
        return Edited { buffer = buffer + { col = col, want = col }, changed = false }

    if name = "end"
        return Edited { buffer = buffer + { col = size, want = size }, changed = false }

    if name = "ctrl+home"
        return Edited { buffer = buffer + { row = 0, col = 0, want = 0 }, changed = false }

    if name = "ctrl+end"
        emit Length { value = lines[count - 1] } to core get { value as last }
        return Edited { buffer = buffer + { row = count - 1, col = last, want = last }, changed = false }

    if name = "ctrl+left" or name = "ctrl+right"
        step = 1
        if name = "ctrl+left", step = -1
        if name = "ctrl+left" and col = 0 and row > 0
            emit Length { value = lines[row - 1] } to core get { value as above }
            return Edited { buffer = buffer + { row = row - 1, col = above, want = above }, changed = false }
        if name = "ctrl+right" and col = size and row < count - 1
            return Edited { buffer = buffer + { row = row + 1, col = 0, want = 0 }, changed = false }
        emit WordMove { line = line, col = col, step = step } to this get moved
        return Edited { buffer = buffer + { col = moved.col, want = moved.col }, changed = false }

    | Ctrl+↑ / Ctrl+↓: the view a line up or down; the cursor only moves to
    | stay in it.
    if name = "ctrl+up" or name = "ctrl+down"
        top = buffer.top
        if top = null, top = 0
        if name = "ctrl+up" and top > 0, top = top - 1
        if name = "ctrl+down" and top < count - 1, top += 1
        if row < top, row = top
        if page > 0 and row > top + page - 1, row = top + page - 1
        if row = buffer.row, return Edited { buffer = buffer + { top = top }, changed = false }
        emit Length { value = lines[row] } to core get { value as there }
        col = want
        if col > there, col = there
        return Edited { buffer = buffer + { top = top, row = row, col = col }, changed = false }

    | Up and down keep `want`, the column the cursor would like to be in.
    target = row
    if name = "up", target = row - 1
    if name = "down", target = row + 1
    if name = "pageup", target = row - page
    if name = "pagedown", target = row + page
    if target ≠ row
        if target < 0
            return Edited { buffer = buffer + { row = 0, col = 0 }, changed = false }
        if target > count - 1
            emit Length { value = lines[count - 1] } to core get { value as last }
            return Edited { buffer = buffer + { row = count - 1, col = last }, changed = false }
        emit Length { value = lines[target] } to core get { value as there }
        col = want
        if col > there, col = there
        return Edited { buffer = buffer + { row = target, col = col }, changed = false }

    return Edited { buffer = buffer, changed = false }

| The rows a line command works on: the selection's (one that ends at the
| start of a line leaves that line out), else the cursor's.
LineSpanOf { buffer } =>
    emit Selection { buffer = buffer } to this get picked
    first = buffer.row
    last = buffer.row
    if not picked.empty
        first = picked.start.row
        last = picked.stop.row
        if picked.stop.col = 0 and last > first, last = last - 1
    return Rows { first = first, last = last }

| Alt+↑ / Alt+↓: the line, or the selected lines, a line up (`step` -1) or
| down (1), the cursor and the selection going with them.
MoveLines { buffer, step } =>
    emit LineSpanOf { buffer = buffer } to this get span
    first = span.first
    last = span.last
    lines = buffer.lines
    emit Length { value = lines } to core get { value as count }
    if step < 0 and first = 0, return Edited { buffer = buffer, changed = false }
    if step > 0 and last = count - 1, return Edited { buffer = buffer, changed = false }
    block = lines[first, last + 1)
    if step < 0, lines = lines[0, first - 1) + block + [lines[first - 1]] + lines(last, length)
    if step > 0, lines = lines[0, first) + [lines[last + 1]] + block + lines(last + 1, length)
    moved = buffer + { lines = lines, row = buffer.row + step }
    if buffer.anchor ≠ null, moved = moved + { anchor = { row = buffer.anchor.row + step, col = buffer.anchor.col } }
    return Edited { buffer = moved, changed = true }

| Ctrl+Shift+Alt+↑ / ↓: the line, or the selected lines, copied above or
| below; the cursor (and selection) go to the copy below, or stay — on the
| copy above.
CopyLines { buffer, down } =>
    emit LineSpanOf { buffer = buffer } to this get span
    lines = buffer.lines
    block = lines[span.first, span.last + 1)
    lines = lines[0, span.last + 1) + block + lines(span.last, length)
    if not down, return Edited { buffer = buffer + { lines = lines }, changed = true }
    size = span.last - span.first + 1
    moved = buffer + { lines = lines, row = buffer.row + size }
    if buffer.anchor ≠ null, moved = moved + { anchor = { row = buffer.anchor.row + size, col = buffer.anchor.col } }
    return Edited { buffer = moved, changed = true }

| The comment mark for `path`'s language, "" when it has none known.
CommentMark { path } =>
    if path = null, return Mark { text = "" }
    emit Split { value = path, separator = "/" } to texts get parts
    name = parts.value[length - 1]
    emit Split { value = name, separator = "." } to texts get dotted
    emit Length { value = dotted.value } to core get { value as pieces }
    kind = name
    if pieces > 1, kind = dotted.value[pieces - 1]
    mark = comment_marks[kind]
    if mark = null, return Mark { text = "" }
    return Mark { text = mark }

| Ctrl+/: the lines (LineSpanOf) commented out with the language's mark at
| the least indentation among them — or, when every one with text is a
| comment already, back in. Blank lines are left as they are.
ToggleComment { buffer } =>
    emit CommentMark { path = buffer.path } to this get mark
    if mark.text = "", return Edited { buffer = buffer, changed = false }
    token = mark.text
    emit Length { value = token } to core get { value as token_size }
    emit LineSpanOf { buffer = buffer } to this get span
    lines = buffer.lines
    least = -1
    all_marked = true
    r = span.first
    loop
        if r > span.last, break
        emit Indent { line = lines[r] } to this get indent
        emit Trim { value = lines[r] } to texts get trimmed
        if trimmed.value ≠ ""
            if least < 0 or indent.width < least, least = indent.width
            if trimmed.value[0, token_size) ≠ token, all_marked = false
        r += 1
    if least < 0, return Edited { buffer = buffer, changed = false }
    row = buffer.row
    col = buffer.col
    anchor = buffer.anchor
    r = span.first
    loop
        if r > span.last, break
        line = lines[r]
        emit Indent { line = line } to this get indent
        emit Trim { value = line } to texts get trimmed
        if trimmed.value ≠ ""
            shift = token_size + 1
            at = least
            if all_marked
                at = indent.width
                body = line[at + token_size, length)
                shift = token_size
                if body[0, 1) = " "
                    body = body[1, length)
                    shift += 1
                line = line[0, at) + body
                shift = 0 - shift
            if not all_marked, line = line[0, least) + token + " " + line[least, length)
            if row = r and col ≥ at
                col = col + shift
                if col < at, col = at
            if anchor ≠ null and anchor.row = r and anchor.col ≥ at
                moved_col = anchor.col + shift
                if moved_col < at, moved_col = at
                anchor = { row = anchor.row, col = moved_col }
            lines = lines[0, r) + [line] + lines(r, length)
        r += 1
    return Edited { buffer = buffer + { lines = lines, col = col, want = col, anchor = anchor }, changed = true }

| ── Several cursors ────────────────────────────────────────────────────
|
| Besides the cursor (`row`, `col`, `want`, `anchor`), a buffer may have
| `extra`: more cursors, each `{ row, col, want, anchor }`. Ctrl+D adds
| them; a key then acts at every one (EditAll); Escape leaves the first.

| Ctrl+D: nothing selected — the word at the cursor; something selected on
| one line — the next place with the same text gets a cursor and is
| selected, the newest the cursor the screen follows; round past the end.
SelectNext { buffer } =>
    emit Selection { buffer = buffer } to this get picked
    lines = buffer.lines
    emit Length { value = lines } to core get { value as count }
    if picked.empty
        line = lines[buffer.row]
        a = buffer.col
        loop
            if a = 0 or separators[line[a - 1]] = true, break
            a = a - 1
        b = buffer.col
        loop
            if line[b] = null or separators[line[b]] = true, break
            b += 1
        if b = a, return Edited { buffer = buffer, changed = false }
        return Edited { buffer = buffer + { anchor = { row = buffer.row, col = a }, col = b, want = b }, changed = false }
    if picked.start.row ≠ picked.stop.row, return Edited { buffer = buffer, changed = false }
    emit SelectedText { buffer = buffer } to this get needle
    emit Length { value = needle.text } to core get { value as size }
    extras = buffer.extra
    if extras = null, extras = []
    taken = { "$picked.start.row:$picked.start.col" = true }
    loop one over extras
        emit Selection { buffer = { row = one.row, col = one.col, anchor = one.anchor } } to this get theirs
        taken = taken + { "$theirs.start.row:$theirs.start.col" = true }
    k = 0
    loop
        if k > count, break
        r = picked.stop.row + k
        if r ≥ count, r = r - count
        from = 0
        if k = 0, from = picked.stop.col
        loop
            emit IndexIn { text = lines[r], part = needle.text, from = from } to this get found
            if found.value < 0, break
            spot = found.value
            if taken["$r:$spot"] ≠ true
                kept = extras + [{ row = buffer.row, col = buffer.col, want = buffer.want, anchor = buffer.anchor }]
                return Edited { buffer = buffer + { anchor = { row = r, col = spot }, row = r, col = spot + size, want = spot + size, extra = kept }, changed = false }
            from = spot + 1
        k += 1
    return Edited { buffer = buffer, changed = false }

| Shift+Alt+↑ / ↓: a cursor on the line above the
| highest one (below the lowest), in the column it would like; it is the
| one the screen follows, the others extra.
CursorBeside { buffer, down } =>
    extras = buffer.extra
    if extras = null, extras = []
    edge = buffer.row
    loop one over extras
        if down and one.row > edge, edge = one.row
        if not down and one.row < edge, edge = one.row
    target = edge - 1
    if down, target = edge + 1
    emit Length { value = buffer.lines } to core get { value as count }
    if target < 0 or target ≥ count, return Edited { buffer = buffer, changed = false }
    emit Length { value = buffer.lines[target] } to core get { value as there }
    col = buffer.want
    if col = null, col = buffer.col
    if col > there, col = there
    kept = extras + [{ row = buffer.row, col = buffer.col, want = buffer.want, anchor = buffer.anchor }]
    return Edited { buffer = buffer + { row = target, col = col, want = buffer.want, anchor = null, extra = kept }, changed = false }

| `cursors` latest first (row, then column).
LatestFirst { cursors } =>
    out = []
    loop c over cursors
        placed = []
        put = false
        loop o over out
            if not put and (c.row > o.row or (c.row = o.row and c.col > o.col))
                placed += c
                put = true
            placed += o
        if not put, placed += c
        out = placed
    return Cursors { cursors = out }

| A key at every cursor. One cursor: Edit. Several: each in turn, the
| latest first, so an edit never moves a cursor not yet seen; the ones
| seen are moved by what each edit did to the text before them. Cursors
| that end in the same place become one. Escape leaves only the first.
EditAll { buffer, name, text, page } =>
    if name = "ctrl+d"
        emit SelectNext { buffer = buffer } to this get added
        return added
    if name = "shift+alt+up" or name = "shift+alt+down"
        emit CursorBeside { buffer = buffer, down = name = "shift+alt+down" } to this get beside
        return beside
    extras = buffer.extra
    if extras = null or extras = []
        emit Edit { buffer = buffer, name = name, text = text, page = page } to this get alone
        return alone
    if name = "escape", return Edited { buffer = buffer + { extra = [] }, changed = false }
    all = [{ row = buffer.row, col = buffer.col, want = buffer.want, anchor = buffer.anchor, first = true }]
    loop one over extras
        all += one + { first = false }
    emit LatestFirst { cursors = all } to this get ordered
    lines = buffer.lines
    changed = false
    done = []
    loop c over ordered.cursors
        emit Length { value = lines } to core get { value as before_count }
        emit Edit { buffer = buffer + { lines = lines, row = c.row, col = c.col, want = c.want, anchor = c.anchor, extra = null }, name = name, text = text, page = page } to this get one
        after = one.buffer
        | Where this edit ends in the old text: the later of cursor and anchor.
        ref = { row = c.row, col = c.col }
        if c.anchor ≠ null and (c.anchor.row > c.row or (c.anchor.row = c.row and c.anchor.col > c.col)), ref = c.anchor
        if one.changed
            changed = true
            emit Length { value = after.lines } to core get { value as after_count }
            delta = after_count - before_count
            moved = []
            loop p over done
                emit ShiftPlace { place = { row = p.row, col = p.col }, ref = ref, landed = { row = after.row, col = after.col }, delta = delta } to this get place
                q = p + { row = place.row, col = place.col, want = place.col }
                if p.anchor ≠ null
                    emit ShiftPlace { place = p.anchor, ref = ref, landed = { row = after.row, col = after.col }, delta = delta } to this get anchored
                    q = q + { anchor = { row = anchored.row, col = anchored.col } }
                moved += q
            done = moved
        lines = after.lines
        dup = false
        loop p over done
            if p.row = after.row and p.col = after.col, dup = true
        if not dup or c.first, done += { row = after.row, col = after.col, want = after.want, anchor = after.anchor, first = c.first }
    primary = null
    kept = []
    loop p over done
        if p.first and primary = null, primary = p
        if not p.first
            clash = primary ≠ null and primary.row = p.row and primary.col = p.col
            if not clash, kept += { row = p.row, col = p.col, want = p.want, anchor = p.anchor }
    if primary = null, primary = done[0]
    return Edited { buffer = buffer + { lines = lines, row = primary.row, col = primary.col, want = primary.want, anchor = primary.anchor, extra = kept }, changed = changed }

| `place` after an edit that ended at `ref` in the old text and left its
| cursor at `landed`, `delta` lines more: on ref's row, it keeps its distance
| from the cursor; below, it moves by delta; above, it stays.
ShiftPlace { place, ref, landed, delta } =>
    if place.row = ref.row, return Place { row = landed.row, col = place.col - ref.col + landed.col }
    if place.row > ref.row, return Place { row = place.row + delta, col = place.col }
    return Place { row = place.row, col = place.col }
