| Render — the whole screen from the state. Pure: the state in, what to
| draw out, as `tty` overlays (`{ row, col, spans }`), plus where the
| cursor goes and how far each pane had to scroll to keep it in sight.
|
| Row 0 is the menu bar, the last row the status bar; between them the
| body: every group of tabs where `Layout` puts its slot — a tab strip,
| then what its active tab shows (the explorer's rows, a file, a
| terminal). A group not at the left edge has a line down its left side.

| The `strings` and `syntax` organelles, handed over when the ide links them.
texts = null
colours = null

RenderUses { texts as given_texts, colours as given_colours } =>
    texts = given_texts
    colours = given_colours
    return Using

gutter = 5

| The last part of a path: `a/b/c.code` → `c.code`.
BaseName { path } =>
    emit Split { value = path, separator = "/" } to texts get parts
    return Name { name = parts.value[length - 1] }

| One line's spans, coloured by `spans` (`{ col, len, kind }` from
| `syntax`), cut to the columns `left` … `left + width`.
LineSpans { line, spans, left, width } =>
    at = left
    stop = left + width
    out = []
    loop s over spans
        from_col = s.col
        to_col = s.col + s.len
        if to_col ≤ at, continue
        if from_col ≥ stop, break
        if from_col > at
            out += { text = line[at, from_col), style = "plain" }
            at = from_col
        upto = to_col
        if upto > stop, upto = stop
        out += { text = line[at, upto), style = s.kind }
        at = upto
    if at < stop, out += { text = line[at, stop), style = "plain" }
    return Spans { spans = out }

| The explorer's rows in `pane` (below its tab strip), scrolled to keep the
| selection in sight. The folder's name is the first row.
ExplorerRows { pane, nodes, sel, top, focused, title } =>
    h = pane.height - 1
    t = top
    if sel < t, t = sel
    if sel ≥ t + h, t = sel - h + 1
    if t < 0, t = 0
    emit Upper { value = title } to texts get upper
    out = [{ row = 1 + pane.y, col = pane.x, spans = [{ text = " " + upper.value, width = pane.width, style = "folder" }] }]
    i = 0
    loop
        if i ≥ h, break
        node = nodes[t + i]
        style = "sidebar"
        text = ""
        if node ≠ null
            emit Label { node = node } to this get label
            text = label.text
            if node.is_dir, style = "folder"
            if t + i = sel and focused, style = "selected_focus"
            if t + i = sel and not focused, style = "selected"
        out += { row = 2 + pane.y + i, col = pane.x, spans = [{ text = text, width = pane.width, style = style }] }
        i += 1
    return PaneView { overlays = out, top = t, page = h }

| A terminal's screen in `pane` (below its tab strip): each row's spans
| with the terminal's own colours, and its cursor when it has the keys.
TerminalRows { pane, screen, focused } =>
    out = []
    if screen = null, return PaneView { overlays = out }
    loop i, line over screen.lines
        if i < pane.height
            spans = []
            loop span over line
                spans += span + { style = "plain" }
            out += { row = 1 + pane.y + i, col = pane.x, spans = spans }
    view = PaneView { overlays = out }
    if focused and screen.cursor_visible
        view = view + { cursor_row = 1 + pane.y + screen.cursor_row, cursor_col = pane.x + screen.cursor_col }
    return view

| The tab strip: every tab's name (● when a file has unsaved changes),
| the active one lit, scrolled so the active one is always in sight.
TabStrip { tabs, active, width, focused } =>
    labels = []
    sizes = []
    loop tab over tabs
        emit BaseName { path = tab.path } to this get tab_name
        label = " " + tab_name.name + " "
        if tab.dirty = true, label = label + "● "
        emit Length { value = label } to core get { value as size }
        labels += label
        sizes += size
    first = active
    used = sizes[active]
    loop
        if first = 0, break
        if used + sizes[first - 1] > width, break
        first = first - 1
        used = used + sizes[first]
    spans = []
    loop i, label over labels
        if i < first, continue
        style = "pane_title"
        if i = active and focused, style = "selected_focus"
        if i = active and not focused, style = "selected"
        spans += { text = label, style = style }
    return TabSpans { spans = spans }

| A file's lines with numbers in `pane` (below its tab strip), scrolled to
| keep the cursor in sight, coloured when the file is code.
EditorView { pane, buffer, focused } =>
    out = []
    h = pane.height - 1
    tw = pane.width - gutter
    t = buffer.top
    if buffer.row < t, t = buffer.row
    if buffer.row ≥ t + h, t = buffer.row - h + 1
    if t < 0, t = 0
    l = buffer.left
    if buffer.col < l, l = buffer.col
    if buffer.col ≥ l + tw, l = buffer.col - tw + 1
    if l < 0, l = 0

    coloured = null
    if buffer.path[length - 5, length) = ".code"
        emit Join { value = buffer.lines, separator = "\n" } to texts get source
        emit Highlight { source = source.value, from = t, until = t + h } to colours get lit
        if lit ∈ Highlighted, coloured = lit.lines

    i = 0
    loop
        if i ≥ h, break
        r = t + i
        line = buffer.lines[r]
        if line = null, break
        number_style = "line_number"
        if r = buffer.row, number_style = "line_number_active"
        segments = [{ text = line[l, l + tw), style = "plain" }]
        if coloured ≠ null
            emit LineSpans { line = line, spans = coloured[i], left = l, width = tw } to this get cut
            segments = cut.spans
        numbers = [{ text = "" + (r + 1), width = gutter - 1, align = "right", style = number_style }, { text = " ", style = "plain" }]
        out += { row = 2 + pane.y + i, col = pane.x, spans = numbers + segments }
        i += 1
    return PaneView {
        overlays = out
        top = t
        left = l
        page = h
        cursor_row = 2 + pane.y + buffer.row - t
        cursor_col = pane.x + gutter + buffer.col - l
    }

welcome = [
    ""
    "  codelovesme ide"
    ""
    "  Ctrl+B          Show the Explorer"
    "  Ctrl+`          A terminal"
    "  Ctrl+K Ctrl+O   Open a Folder"
    "  Alt+F           File menu"
    "  Ctrl+Q          Exit"
]

WelcomeView { pane } =>
    out = []
    loop i, text over welcome
        if i < pane.height, out += { row = 1 + pane.y + i, col = pane.x + 2, spans = [{ text = text, style = "dim" }] }
    return PaneView { overlays = out }

| The status bar: a prompt being answered, or the last message on the
| left; where the cursor is and the language on the right.
StatusBar { width, row, message, prompt, buffer } =>
    if prompt ≠ null
        emit Length { value = prompt.label + prompt.text } to core get { value as typed }
        return Status {
            overlays = [{ row = row, col = 0, spans = [{ text = " " + prompt.label + prompt.text, width = width, style = "prompt" }] }]
            cursor_col = 1 + typed
        }
    right = ""
    if buffer ≠ null
        language = "Plain Text"
        if buffer.path[length - 5, length) = ".code", language = "code"
        if buffer.path[length - 5, length) = ".json", language = "JSON"
        right = "Ln " + (buffer.row + 1) + ", Col " + (buffer.col + 1) + "    " + language + "  "
    style = "status"
    if message[0, 6) = "Error:", style = "status_warn"
    return Status { overlays = [{ row = row, col = 0, spans = [
        { text = " " + message, width = width - 34, style = style }
        { text = right, width = 34, align = "right", style = style }
    ] }] }

| Where every group goes: `Layout` over the groups' slots. Answers the
| placed groups (`id` is the group's index), or none — the welcome pane.
Placement { state } =>
    panes = []
    loop i, group over state.groups
        panes += { id = i, slot = group.slot }
    emit Length { value = panes } to core get { value as count }
    if count = 0, panes = [{ id = -1, slot = "c" }]
    emit Layout { width = state.cols, height = state.rows - 2, panes = panes, sizes = state.sizes } to this get placed
    return Placement { placed = placed.panes }

| One group in its place: the line down its left edge (unless it is at the
| screen's), its tab strip, and what the active tab shows.
GroupView { area, group, index, state, screens } =>
    out = []
    pane = area
    if area.x > 0
        i = 0
        loop
            if i ≥ area.height, break
            out += { row = 1 + area.y + i, col = area.x, spans = [{ text = "│", style = "border" }] }
            i += 1
        pane = area + { x = area.x + 1, width = area.width - 1 }
    focused = index = state.current and state.focus ≠ "none"
    emit TabStrip { tabs = group.tabs, active = group.active, width = pane.width, focused = focused } to this get strip
    out += { row = 1 + pane.y, col = pane.x, spans = [{ text = "", width = pane.width, style = "pane_title" }] }
    out += { row = 1 + pane.y, col = pane.x, spans = strip.spans }
    view = group.tabs[group.active]
    content = pane + { y = pane.y + 1, height = pane.height - 1 }
    result = GroupDrawn { overlays = out, scroll = null, tree = null, page = null, cursor_row = null, cursor_col = null }
    if view.kind = "explorer"
        emit BaseName { path = state.folder } to this get folder_name
        emit ExplorerRows { pane = content, nodes = state.tree, sel = state.tree_sel, top = state.tree_top, focused = focused, title = folder_name.name } to this get rows
        result = result + { overlays = out + rows.overlays, tree = { top = rows.top, page = rows.page } }
    if view.kind = "file"
        buffer = view
        if index = state.current and state.file ≠ null, buffer = state.file
        | EditorView starts its lines a row down: the strip's row is that row.
        emit EditorView { pane = pane, buffer = buffer, focused = focused } to this get rows
        result = result + { overlays = out + rows.overlays, scroll = { group = index, top = rows.top, left = rows.left }, page = rows.page }
        if focused, result = result + { cursor_row = rows.cursor_row, cursor_col = rows.cursor_col }
    if view.kind = "terminal"
        emit TerminalRows { pane = content, screen = screens["$view.id"], focused = focused } to this get rows
        result = result + { overlays = out + rows.overlays }
        if rows.cursor_row ≠ null, result = result + { cursor_row = rows.cursor_row, cursor_col = rows.cursor_col }
    return result

| Everything. `state` is the ide gene's state, whole; `placement` from
| `Placement`, and `screens` the terminals' screens by id.
Frame { state, placement, screens } =>
    emit BaseName { path = state.folder } to this get folder_name
    title = "ide — " + folder_name.name
    if state.file ≠ null
        title = title + " — " + state.file.path
        if state.file.dirty, title = title + " ●"
    emit MenuBar { width = state.cols, open = state.menu, title = title } to this get bar
    overlays = bar.overlays

    tree_top = state.tree_top
    tree_page = 10
    page = 10
    cursor_row = null, cursor_col = null
    views = []
    loop area over placement.placed
        if area.id < 0
            emit WelcomeView { pane = area } to this get welcome_view
            overlays = overlays + welcome_view.overlays
        if area.id ≥ 0
            emit GroupView { area = area, group = state.groups[area.id], index = area.id, state = state, screens = screens } to this get drawn
            overlays = overlays + drawn.overlays
            if drawn.scroll ≠ null, views += drawn.scroll
            if drawn.tree ≠ null
                tree_top = drawn.tree.top
                tree_page = drawn.tree.page
            if area.id = state.current and drawn.page ≠ null, page = drawn.page
            if drawn.cursor_row ≠ null
                cursor_row = drawn.cursor_row
                cursor_col = drawn.cursor_col

    emit StatusBar { width = state.cols, row = state.rows - 1, message = state.message, prompt = state.prompt, buffer = state.file } to this get status
    overlays = overlays + status.overlays
    if state.prompt ≠ null
        cursor_row = state.rows - 1
        cursor_col = status.cursor_col

    if state.menu ≠ null
        emit Dropdown { open = state.menu, labels = state.keytable.labels } to this get dropdown
        overlays = overlays + dropdown.overlays
        cursor_row = null

    return Screen {
        overlays = overlays
        cursor_row = cursor_row
        cursor_col = cursor_col
        tree_top = tree_top
        tree_page = tree_page
        views = views
        page = page
    }
