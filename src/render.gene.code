| Render — the whole screen from the state. Pure: the state in, what to
| draw out, as `tty` overlays (`{ row, col, spans }`), plus where the
| cursor goes and how far each pane had to scroll to keep it in sight.
|
| Row 0 is the menu bar, the last row the status bar; between them the
| body: every group of tabs where `Layout` puts its slot — a tab strip,
| then what its active tab shows (the explorer's rows, a file, a
| terminal, the AI chat). A group not at the left edge has a line down its left side.

| The `strings` and `syntax` organelles, handed over when the ide links them.
texts = null
colours = null

RenderUses { texts as given_texts, colours as given_colours } =>
    texts = given_texts
    colours = given_colours
    return Using

gutter = 5

| The last part of a path: `a/b/c.code` → `c.code`.
BaseName { path } =>
    emit Split { value = path, separator = "/" } to texts get parts
    return Name { name = parts.value[length - 1] }

| One line's spans, coloured by `spans` (`{ col, len, kind }` from
| `syntax`), cut to the columns `left` … `left + width`.
LineSpans { line, spans, left, width } =>
    at = left
    stop = left + width
    out = []
    loop s over spans
        from_col = s.col
        to_col = s.col + s.len
        if to_col ≤ at, continue
        if from_col ≥ stop, break
        if from_col > at
            out += { text = line[at, from_col), style = "plain" }
            at = from_col
        upto = to_col
        if upto > stop, upto = stop
        out += { text = line[at, upto), style = s.kind }
        at = upto
    if at < stop, out += { text = line[at, stop), style = "plain" }
    return Spans { spans = out }

| The explorer's rows in `pane` (below its tab strip), scrolled to keep the
| selection in sight. The folder's name is the first row.
ExplorerRows { pane, nodes, sel, top, focused, title } =>
    h = pane.height - 1
    t = top
    if sel < t, t = sel
    if sel ≥ t + h, t = sel - h + 1
    if t < 0, t = 0
    emit Upper { value = title } to texts get upper
    out = [{ row = 1 + pane.y, col = pane.x, spans = [{ text = " " + upper.value, width = pane.width, style = "folder" }] }]
    i = 0
    loop
        if i ≥ h, break
        node = nodes[t + i]
        style = "sidebar"
        text = ""
        if node ≠ null
            emit Label { node = node } to this get label
            text = label.text
            if node.is_dir, style = "folder"
            if t + i = sel and focused, style = "selected_focus"
            if t + i = sel and not focused, style = "selected"
        out += { row = 2 + pane.y + i, col = pane.x, spans = [{ text = text, width = pane.width, style = style }] }
        i += 1
    return PaneView { overlays = out, top = t, page = h }

| A terminal's screen in `pane` (below its tab strip): each row's spans
| with the terminal's own colours, and its cursor when it has the keys.
TerminalRows { pane, screen, focused } =>
    out = []
    if screen = null, return PaneView { overlays = out }
    loop i, line over screen.lines
        if i < pane.height
            spans = []
            loop span over line
                spans += span + { style = "plain" }
            out += { row = 1 + pane.y + i, col = pane.x, spans = spans }
    if screen.scrolled ≠ null and screen.scrolled > 0
        note = " ↑ " + screen.scrolled + " lines back "
        emit Length { value = note } to core get { value as note_size }
        out += { row = 1 + pane.y, col = pane.x + pane.width - note_size, spans = [{ text = note, style = "status" }] }
    view = PaneView { overlays = out }
    if focused and screen.cursor_visible
        view = view + { cursor_row = 1 + pane.y + screen.cursor_row, cursor_col = pane.x + screen.cursor_col }
    return view

chat_help = [
    "Ask about this project — it looks at what you are looking at."
    "Enter asks (while the AI works, queues) · Alt+Enter a new line · Esc back to the files"
    "PgUp/PgDn scroll · Ctrl+C stops · Ctrl+T another chat · @terminal @git @file @folder @path"
]

| One turn of the chat as lines `{ text, style }`, `width` wide.
TurnLines { turn, width } =>
    out = []
    if turn.role = "tool"
        emit Wrap { text = "· " + turn.text, width = width - 2 } to this get wrapped
        loop line over wrapped.lines
            out += { text = "  " + line, style = "dim" }
        return ChatLines { lines = out }
    if turn.role = "error"
        emit Wrap { text = turn.text, width = width - 4 } to this get wrapped
        loop i, line over wrapped.lines
            lead = "    "
            if i = 0, lead = "  ! "
            out += { text = lead + line, style = "plain", fg = [230, 140, 60] }
        out += { text = "", style = "plain" }
        return ChatLines { lines = out }
    if turn.role = "user", out += { text = "You", style = "plain", fg = [86, 156, 214], bold = true }
    if turn.role = "assistant", out += { text = "AI", style = "plain", fg = [78, 201, 176], bold = true }
    emit Split { value = turn.text, separator = "\n" } to texts get lines
    fenced = false
    loop line over lines.value
        if line[0, 3) = "```"
            fenced = not fenced
            out += { text = "  " + line[0, width - 2), style = "dim" }
            continue
        if fenced
            out += { text = "  " + line[0, width - 2), style = "variable" }
            continue
        style = "plain"
        if line[0] = "#", style = "property"
        emit Wrap { text = line, width = width - 2 } to this get wrapped
        loop part over wrapped.lines
            out += { text = "  " + part, style = style }
    out += { text = "", style = "plain" }
    return ChatLines { lines = out }

| The AI chat in `pane` (below its tab strip): the conversation, the
| newest at the bottom (`scroll` lines up from there), and the input box
| under a rule, growing to six lines — at the right of its first line,
| whether the AI is working and how many questions wait.
ChatRows { pane, chat, notice, label, focused, voice } =>
    width = pane.width - 1
    out = []
    mark = ""
    mark_fg = [78, 201, 176]
    if chat.busy
        mark = "● working "
        if chat.pending ≠ null
            mark = "● waiting for you "
            mark_fg = [230, 190, 90]
    | Voice input under way (voice.gene.code): it comes before the rest.
    if voice = "recording"
        mark = "● rec " + mark
        mark_fg = [230, 80, 80]
    if voice = "hearing"
        mark = "… hearing " + mark
        mark_fg = [230, 190, 90]
    emit Length { value = chat.queue } to core get { value as queued_count }
    if queued_count > 0, mark = mark + "· " + queued_count + " queued "
    emit Length { value = mark } to core get { value as mark_size }
    caret = chat.caret
    if caret = null
        emit Length { value = chat.input } to core get { value as input_size }
        caret = input_size
    emit InputLines { text = chat.input, caret = caret, width = width - 3 - mark_size } to this get typed
    emit Length { value = typed.lines } to core get { value as typed_count }
    | At most six lines, the last ones unless the cursor is further up.
    first_typed = 0
    if typed_count > 6, first_typed = typed_count - 6
    if typed.caret_line < first_typed, first_typed = typed.caret_line
    shown_typed = typed.lines[first_typed, typed_count)
    if typed_count - first_typed > 6, shown_typed = typed.lines[first_typed, first_typed + 6)
    emit Length { value = shown_typed } to core get { value as box }
    room = pane.height - box - 1
    if room < 1, room = 1

    | Lines from the newest turn back, until there are enough to fill the
    | room scrolled up.
    lines = []
    if chat.busy
        lines = [{ text = "  … thinking (step " + (chat.steps + 1) + ")", style = "dim" }]
        if chat.pending ≠ null, lines = [{ text = "  … waiting for your answer", style = "plain", fg = [230, 190, 90] }]
        if chat.agent ≠ null, lines = [{ text = "  … " + chat.agent.title + " is working (" + chat.steps + " steps) — Ctrl+C stops it", style = "dim" }]
    emit Length { value = chat.turns } to core get { value as turn_count }
    i = turn_count - 1
    loop
        if i < 0, break
        emit Length { value = lines } to core get { value as have }
        if have ≥ room + chat.scroll, break
        emit TurnLines { turn = chat.turns[i], width = width } to this get turn_lines
        lines = turn_lines.lines + lines
        i = i - 1
    if turn_count = 0
        lines = []
        loop hint over chat_help
            lines += { text = " " + hint, style = "dim" }
        if notice ≠ ""
            lines += { text = "", style = "plain" }
            emit Wrap { text = notice, width = width - 4 } to this get wrapped
            loop part over wrapped.lines
                lines += { text = "  " + part, style = "plain", fg = [230, 140, 60] }
    emit Length { value = lines } to core get { value as count }
    scroll = chat.scroll
    most = count - room
    if i < 0 and most < 0, most = 0
    if i < 0 and scroll > most, scroll = most
    if scroll < 0, scroll = 0
    last = count - scroll
    first = last - room
    if first < 0, first = 0
    at = 0
    loop line over lines[first, last)
        out += { row = 1 + pane.y + at, col = pane.x + 1, spans = [line + { width = width }] }
        at += 1

    rule_row = 1 + pane.y + room
    rule = ""
    if label ≠ "", rule = "─ " + label + " "
    emit Length { value = rule } to core get { value as k }
    loop
        if k ≥ pane.width, break
        rule = rule + "─"
        k += 1
    out += { row = rule_row, col = pane.x, spans = [{ text = rule, width = pane.width, style = "border" }] }
    cursor_row = null, cursor_col = null
    loop j, line over shown_typed
        lead = "   "
        if j = 0 and first_typed = 0, lead = " › "
        if j = 0 and mark_size > 0
            out += { row = rule_row + 1 + j, col = pane.x, spans = [{ text = lead + line, width = pane.width - mark_size, style = "plain" }, { text = mark, width = mark_size, align = "right", style = "plain", fg = mark_fg }] }
            continue
        out += { row = rule_row + 1 + j, col = pane.x, spans = [{ text = lead + line, width = pane.width, style = "plain" }] }
    if focused
        cursor_row = rule_row + 1 + typed.caret_line - first_typed
        cursor_col = pane.x + 3 + typed.caret_col
    return PaneView { overlays = out, cursor_row = cursor_row, cursor_col = cursor_col, chat = { scroll = scroll, page = room } }

| A change the AI proposes, in `pane` (below its tab strip): what it does
| on the first row, then the lines — removed in red, added in green, a few
| unchanged round them — from `view.top`.
DiffRows { pane, view, focused } =>
    what = " Proposed change to " + view.target
    if view.created, what = " Proposed new file " + view.target
    keys = "a accept · r reject "
    if view.reviewed = true
        what = " Changed by the AI: " + view.target
        if view.created, what = " Made by the AI: " + view.target
        keys = "Esc closes "
    head_style = "selected"
    if focused, head_style = "selected_focus"
    out = [{ row = 1 + pane.y, col = pane.x, spans = [
        { text = what + "  (−" + view.removed + " +" + view.added + ")", width = pane.width - 26, style = head_style }
        { text = keys, width = 26, align = "right", style = head_style }
    ] }]
    h = pane.height - 1
    emit Length { value = view.diff } to core get { value as count }
    top = view.top
    if top > count - h, top = count - h
    if top < 0, top = 0
    i = 0
    loop
        if i ≥ h, break
        line = view.diff[top + i]
        if line = null, break
        number = { text = "" + line.line, width = gutter - 1, align = "right", style = "line_number" }
        body = { text = line.sign + " " + line.text, width = pane.width - gutter, style = "plain" }
        if line.sign = "-", body = body + { fg = [241, 100, 100], bg = [58, 30, 30] }
        if line.sign = "+", body = body + { fg = [130, 210, 150], bg = [30, 52, 36] }
        out += { row = 2 + pane.y + i, col = pane.x, spans = [number, { text = " ", style = "plain" }, body] }
        i += 1
    return PaneView { overlays = out, top = top }

| The model picker: three lists side by side — the AI, its models, its
| efforts — every choice in sight, ● on what is in use, the cursor lit in
| each (brightest in the list being moved in); under them, how the AI under
| the cursor stands.
PickerView { picker, rows, cols, height } =>
    width = cols - 6
    if width > 110, width = 110
    left = (cols - width) / 2
    if left < 0, left = 0
    ai_width = 26
    effort_width = 20
    model_width = width - ai_width - effort_width
    widths = [ai_width, model_width, effort_width]
    starts = [left, left + ai_width, left + ai_width + model_width]
    out = [{ row = 2, col = left, spans = [{ text = " AI — ←/→ list · ↑/↓ move · Enter pick · Esc done", width = width, style = "menu_active" }] }]
    titles = ["AI", "Model", "Effort"]
    loop c, title over titles
        out += { row = 3, col = starts[c], spans = [{ text = " " + title, width = widths[c], style = "folder" }] }
    | How many rows: the longest list, at most what the screen holds.
    longest = 1
    loop c, options over rows.choices
        emit Length { value = options } to core get { value as size }
        if size > longest, longest = size
    room = height - 9
    if room < 1, room = 1
    shown = longest
    if shown > room, shown = room
    loop c, options over rows.choices
        emit Length { value = options } to core get { value as count }
        cursor = picker.cursors[c]
        top = 0
        if cursor ≥ shown, top = cursor - shown + 1
        i = 0
        loop
            if i ≥ shown, break
            item = options[top + i]
            text = ""
            if item ≠ null
                text = item
                if c = 0
                    loop one over picker.providers
                        if one.name = item and one.title ≠ item, text = one.title + " · " + item
                if c = 1 and item = "", text = "(its default)"
                if c = 1 and item ≠ "" and rows.held.names[item] ≠ null, text = rows.held.names[item]
                if c = 2 and item = ""
                    text = "(default)"
                    if rows.usual_effort ≠ "", text = "(default: " + rows.usual_effort + ")"
                mark = "  "
                if item = rows.chosen[c] and (c = 0 or rows.chosen[0] = rows.held.name), mark = "● "
                text = " " + mark + text
            if c = 2 and count = 0 and i = 0, text = "   (not supported)"
            style = "menu_item"
            if item ≠ null and top + i = cursor
                style = "selected"
                if c = picker.col, style = "menu_item_active"
            out += { row = 4 + i, col = starts[c], spans = [{ text = text, width = widths[c] - 1, style = style }, { text = "│", style = "border" }] }
            i += 1
    note = rows.held.title + ": " + rows.held.note
    note_span = { text = " " + note, width = width, style = "menu_item" }
    if not rows.held.ready, note_span = note_span + { fg = [230, 140, 60] }
    out += { row = 4 + shown, col = left, spans = [note_span] }
    return Overlays { overlays = out }

| The tab strip: every tab's name (● when a file has unsaved changes),
| the active one lit, scrolled so the active one is always in sight.
TabStrip { tabs, active, width, focused } =>
    labels = []
    sizes = []
    loop tab over tabs
        emit BaseName { path = tab.path } to this get tab_name
        label = " " + tab_name.name + " "
        if tab.dirty = true, label = label + "● "
        emit Length { value = label } to core get { value as size }
        labels += label
        sizes += size
    first = active
    used = sizes[active]
    loop
        if first = 0, break
        if used + sizes[first - 1] > width, break
        first = first - 1
        used = used + sizes[first]
    spans = []
    loop i, label over labels
        if i < first, continue
        style = "pane_title"
        if i = active and focused, style = "selected_focus"
        if i = active and not focused, style = "selected"
        spans += { text = label, style = style }
    return TabSpans { spans = spans }

| The selection's background (VS Code's).
selection_bg = [38, 79, 120]
| An extra cursor's cell, and the brackets that match.
extra_cursor_bg = [174, 175, 173]
bracket_bg = [70, 70, 70]
opening = { "(" = ")", "[" = "]", "{" = "}" }
closing = { ")" = "(", "]" = "[", "}" = "{" }

| A file's lines with numbers in `pane` (below its tab strip), scrolled to
| keep the cursor in sight, coloured when the file is code. With `wrap`, a
| long line goes on in the rows below (no number on them) instead of off
| the side. The selection, every extra cursor (and its selection), and the
| bracket matching the one at the cursor are lit over the text.
EditorView { pane, buffer, focused, wrap } =>
    out = []
    h = pane.height - 1
    tw = pane.width - gutter
    if tw < 1, tw = 1
    t = buffer.top
    if t = null, t = 0
    if buffer.row < t, t = buffer.row
    if buffer.row ≥ t + h, t = buffer.row - h + 1
    if t < 0, t = 0
    l = buffer.left
    if l = null, l = 0
    if buffer.col < l, l = buffer.col
    if buffer.col ≥ l + tw, l = buffer.col - tw + 1
    if l < 0, l = 0
    if wrap
        l = 0
        | The top moved down until the cursor's own row is in sight.
        loop
            if t ≥ buffer.row, break
            used = 0
            r = t
            loop
                if r ≥ buffer.row, break
                emit Length { value = buffer.lines[r] } to core get { value as n }
                emit Pieces { size = n, width = tw } to this get rows_of
                used += rows_of.count
                r += 1
            emit Pieces { size = buffer.col + 1, width = tw } to this get cursor_rows
            used += cursor_rows.count
            if used ≤ h, break
            t += 1

    emit Selection { buffer = buffer } to this get picked
    extras = buffer.extra
    if extras = null, extras = []
    marks = []
    loop one over extras
        emit Selection { buffer = { row = one.row, col = one.col, anchor = one.anchor } } to this get theirs
        marks += { row = one.row, col = one.col, start = theirs.start, stop = theirs.stop, empty = theirs.empty }
    emit BracketPair { lines = buffer.lines, row = buffer.row, col = buffer.col } to this get pair

    coloured = null
    if buffer.path[length - 5, length) = ".code"
        emit Join { value = buffer.lines, separator = "\n" } to texts get source
        emit Highlight { source = source.value, from = t, until = t + h } to colours get lit
        if lit ∈ Highlighted, coloured = lit.lines

    cursor_row = 2 + pane.y
    cursor_col = pane.x + gutter
    i = 0
    r = t
    loop
        if i ≥ h, break
        line = buffer.lines[r]
        if line = null, break
        emit Length { value = line } to core get { value as line_size }
        pieces = 1
        if wrap
            emit Pieces { size = line_size, width = tw } to this get rows_of
            pieces = rows_of.count
        p = 0
        loop
            if p ≥ pieces or i ≥ h, break
            s = l
            if wrap, s = p * tw
            y = 2 + pane.y + i
            x = pane.x + gutter
            number_style = "line_number"
            if r = buffer.row and p = 0, number_style = "line_number_active"
            number = ""
            if p = 0, number = "" + (r + 1)
            segments = [{ text = line[s, s + tw), style = "plain" }]
            if coloured ≠ null
                emit LineSpans { line = line, spans = coloured[r - t], left = s, width = tw } to this get cut
                segments = cut.spans
            numbers = [{ text = number, width = gutter - 1, align = "right", style = number_style }, { text = " ", style = "plain" }]
            out += { row = y, col = pane.x, spans = numbers + segments }
            if not picked.empty
                emit LitRange { start = picked.start, stop = picked.stop, r = r, size = line_size, s = s, tw = tw } to this get lit_range
                if lit_range.ok, out += { row = y, col = x + lit_range.a - s, spans = [{ text = line[lit_range.a, lit_range.upto), width = lit_range.b - lit_range.a, style = "plain", bg = selection_bg }] }
            loop mark over marks
                if not mark.empty
                    emit LitRange { start = mark.start, stop = mark.stop, r = r, size = line_size, s = s, tw = tw } to this get mark_range
                    if mark_range.ok, out += { row = y, col = x + mark_range.a - s, spans = [{ text = line[mark_range.a, mark_range.upto), width = mark_range.b - mark_range.a, style = "plain", bg = selection_bg }] }
                if mark.row = r and mark.col ≥ s and (mark.col < s + tw or p = pieces - 1)
                    under = line[mark.col]
                    if under = null, under = " "
                    out += { row = y, col = x + mark.col - s, spans = [{ text = under, width = 1, style = "plain", fg = [30, 30, 30], bg = extra_cursor_bg }] }
            if pair.found
                loop end_at over [pair.here, pair.there]
                    if end_at.row = r and end_at.col ≥ s and end_at.col < s + tw
                        out += { row = y, col = x + end_at.col - s, spans = [{ text = line[end_at.col], width = 1, style = "plain", bg = bracket_bg }] }
            if r = buffer.row and buffer.col ≥ s and (buffer.col < s + tw or p = pieces - 1)
                cursor_row = y
                cursor_col = x + buffer.col - s
            i += 1
            p += 1
        r += 1
    return PaneView {
        overlays = out
        top = t
        left = l
        page = h
        cursor_row = cursor_row
        cursor_col = cursor_col
    }

| How many rows of `width` a line of `size` takes (one, even empty).
Pieces { size, width } =>
    n = 1
    k = width
    loop
        if k ≥ size, break
        n += 1
        k += width
    return Count { count = n }

| The part of row `r` (a line of `size`, shown from column `s`, `tw` wide)
| that the range `start` … `stop` lights: columns `a` … `b`, the text up
| to `upto` (a line the range runs past: one cell more, its line break).
LitRange { start, stop, r, size, s, tw } =>
    if r < start.row or r > stop.row, return Lit { ok = false, a = 0, b = 0, upto = 0 }
    a = 0
    if r = start.row, a = start.col
    b = size + 1
    if r = stop.row, b = stop.col
    if a < s, a = s
    if b > s + tw, b = s + tw
    if b ≤ a, return Lit { ok = false, a = 0, b = 0, upto = 0 }
    upto = b
    if upto > size, upto = size
    return Lit { ok = true, a = a, b = b, upto = upto }

| The bracket at the cursor (or just before it) and the one that matches
| it, looked for at most 2000 lines away. `found` false when there is none.
BracketPair { lines, row, col } =>
    none = Pair { found = false, here = null, there = null }
    line = lines[row]
    if line = null, return none
    at = col
    ch = line[at]
    if ch = null or (opening[ch] = null and closing[ch] = null)
        at = col - 1
        if at < 0, return none
        ch = line[at]
        if ch = null or (opening[ch] = null and closing[ch] = null), return none
    step = 1
    other = opening[ch]
    if other = null
        step = -1
        other = closing[ch]
    depth = 0
    r = row
    c = at
    seen = 0
    loop
        if seen > 2000, return none
        text = lines[r]
        if text = null, return none
        emit Length { value = text } to core get { value as size }
        loop
            if c < 0 or c ≥ size, break
            here = text[c]
            if here = ch, depth += 1
            if here = other
                depth = depth - 1
                if depth = 0, return Pair { found = true, here = { row = row, col = at }, there = { row = r, col = c } }
            c += step
        r += step
        seen += 1
        if r < 0, return none
        c = 0
        if step < 0 and lines[r] ≠ null
            emit Length { value = lines[r] } to core get { value as above }
            c = above - 1

| Ctrl+P's list, under the menu bar: the files that match, the one Enter
| opens lit.
QuickOpenView { prompt, cols, height } =>
    width = cols - 6
    if width > 90, width = 90
    left = (cols - width) / 2
    if left < 0, left = 0
    out = [{ row = 2, col = left, spans = [{ text = " Go to File — ↑/↓ pick · Enter open · Esc close", width = width, style = "menu_active" }] }]
    room = height - 6
    if room < 1, room = 1
    top = 0
    if prompt.sel ≥ room, top = prompt.sel - room + 1
    i = 0
    loop
        if i ≥ room, break
        path = prompt.matches[top + i]
        if path = null, break
        style = "menu_item"
        if top + i = prompt.sel, style = "menu_item_active"
        out += { row = 3 + i, col = left, spans = [{ text = "  " + path, width = width, style = style }] }
        i += 1
    if i = 0, out += { row = 3, col = left, spans = [{ text = "  No file matches", width = width, style = "menu_item" }] }
    return Overlays { overlays = out }

welcome = [
    ""
    "  codelovesme ide"
    ""
    "  Ctrl+B          Show the Explorer"
    "  Ctrl+`          A terminal"
    "  Ctrl+K Ctrl+O   Open a Folder"
    "  Alt+F           File menu"
    "  Ctrl+Q          Exit"
]

WelcomeView { pane } =>
    out = []
    loop i, text over welcome
        if i < pane.height, out += { row = 1 + pane.y + i, col = pane.x + 2, spans = [{ text = text, style = "dim" }] }
    return PaneView { overlays = out }

| The status bar: a prompt being answered, or the last message on the
| left; where the cursor is and the language on the right.
StatusBar { width, row, message, prompt, buffer, ai, voice } =>
    if prompt ≠ null
        emit Length { value = prompt.label + prompt.text } to core get { value as typed }
        return Status {
            overlays = [{ row = row, col = 0, spans = [{ text = " " + prompt.label + prompt.text, width = width, style = "prompt" }] }]
            cursor_col = 1 + typed
        }
    right = ""
    if buffer ≠ null
        language = "Plain Text"
        if buffer.path[length - 5, length) = ".code", language = "code"
        if buffer.path[length - 5, length) = ".json", language = "JSON"
        right = "Ln " + (buffer.row + 1) + ", Col " + (buffer.col + 1) + "    " + language + "  "
    if ai ≠ null and ai ≠ "", right = ai + "    " + right
    if voice = "recording", right = "● REC    " + right
    if voice = "hearing", right = "… hearing    " + right
    if voice = "downloading", right = "↓ speech model    " + right
    emit Length { value = right } to core get { value as right_size }
    right_width = 34
    if right_size > right_width, right_width = right_size
    style = "status"
    if message[0, 6) = "Error:", style = "status_warn"
    return Status { overlays = [{ row = row, col = 0, spans = [
        { text = " " + message, width = width - right_width, style = style }
        { text = right, width = right_width, align = "right", style = style }
    ] }] }

| Where every group goes: `Layout` over the groups' slots. Answers the
| placed groups (`id` is the group's index), or none — the welcome pane.
Placement { state } =>
    panes = []
    loop i, group over state.groups
        panes += { id = i, slot = group.slot }
    emit Length { value = panes } to core get { value as count }
    if count = 0, panes = [{ id = -1, slot = "c" }]
    emit Layout { width = state.cols, height = state.rows - 2, panes = panes, sizes = state.sizes } to this get placed
    return Placement { placed = placed.panes }

| One group in its place: the line down its left edge (unless it is at the
| screen's), its tab strip, and what the active tab shows.
GroupView { area, group, index, state, screens } =>
    out = []
    pane = area
    if area.x > 0
        i = 0
        loop
            if i ≥ area.height, break
            out += { row = 1 + area.y + i, col = area.x, spans = [{ text = "│", style = "border" }] }
            i += 1
        pane = area + { x = area.x + 1, width = area.width - 1 }
    focused = index = state.current and state.focus ≠ "none"
    emit TabStrip { tabs = group.tabs, active = group.active, width = pane.width, focused = focused } to this get strip
    out += { row = 1 + pane.y, col = pane.x, spans = [{ text = "", width = pane.width, style = "pane_title" }] }
    out += { row = 1 + pane.y, col = pane.x, spans = strip.spans }
    view = group.tabs[group.active]
    content = pane + { y = pane.y + 1, height = pane.height - 1 }
    result = GroupDrawn { overlays = out, scroll = null, tree = null, page = null, cursor_row = null, cursor_col = null, chat = null }
    if view.kind = "explorer"
        emit BaseName { path = state.folder } to this get folder_name
        emit ExplorerRows { pane = content, nodes = state.tree, sel = state.tree_sel, top = state.tree_top, focused = focused, title = folder_name.name } to this get rows
        result = result + { overlays = out + rows.overlays, tree = { top = rows.top, page = rows.page } }
    if view.kind = "file"
        buffer = view
        if index = state.current and state.file ≠ null, buffer = state.file
        | EditorView starts its lines a row down: the strip's row is that row.
        wrap = false
        if state.settings ≠ null, wrap = state.settings["editor.wordWrap"] = "on"
        emit EditorView { pane = pane, buffer = buffer, focused = focused, wrap = wrap } to this get rows
        result = result + { overlays = out + rows.overlays, scroll = { group = index, top = rows.top, left = rows.left }, page = rows.page }
        if focused, result = result + { cursor_row = rows.cursor_row, cursor_col = rows.cursor_col }
    if view.kind = "diff"
        emit DiffRows { pane = content, view = view, focused = focused } to this get rows
        result = result + { overlays = out + rows.overlays }
    if view.kind = "chat"
        | Each AI tab its own conversation: the one with the keys, or one
        | waiting (see chats in the ide gene).
        shown_chat = state.chat
        view_chat = view.chat_id
        if view_chat = null, view_chat = "1"
        if state.chat_id ≠ null and view_chat ≠ state.chat_id
            shown_chat = state.chats[view_chat]
            if shown_chat = null, shown_chat = { turns = [], messages = [], input = "", caret = null, queue = [], busy = false, request = -1, steps = 0, scroll = 0, pending = null, agent = null }
        emit ChatRows { pane = content, chat = shown_chat, notice = state.chat_notice, label = state.chat_label, focused = focused, voice = state.voice } to this get rows
        result = result + { overlays = out + rows.overlays }
        if state.chat_id = null or view_chat = state.chat_id, result = result + { chat = rows.chat }
        if rows.cursor_row ≠ null, result = result + { cursor_row = rows.cursor_row, cursor_col = rows.cursor_col }
    if view.kind = "terminal"
        emit TerminalRows { pane = content, screen = screens["$view.id"], focused = focused } to this get rows
        result = result + { overlays = out + rows.overlays }
        if rows.cursor_row ≠ null, result = result + { cursor_row = rows.cursor_row, cursor_col = rows.cursor_col }
    return result

| Everything. `state` is the ide gene's state, whole; `placement` from
| `Placement`, and `screens` the terminals' screens by id.
Frame { state, placement, screens } =>
    emit BaseName { path = state.folder } to this get folder_name
    title = "ide — " + folder_name.name
    if state.file ≠ null
        title = title + " — " + state.file.path
        if state.file.dirty, title = title + " ●"
    emit MenuBar { width = state.cols, open = state.menu, title = title } to this get bar
    overlays = bar.overlays

    tree_top = state.tree_top
    tree_page = 10
    page = 10
    cursor_row = null, cursor_col = null
    chat_drawn = null
    views = []
    loop area over placement.placed
        if area.id < 0
            emit WelcomeView { pane = area } to this get welcome_view
            overlays = overlays + welcome_view.overlays
        if area.id ≥ 0
            emit GroupView { area = area, group = state.groups[area.id], index = area.id, state = state, screens = screens } to this get drawn
            overlays = overlays + drawn.overlays
            if drawn.scroll ≠ null, views += drawn.scroll
            if drawn.chat ≠ null, chat_drawn = drawn.chat
            if drawn.tree ≠ null
                tree_top = drawn.tree.top
                tree_page = drawn.tree.page
            if area.id = state.current and drawn.page ≠ null, page = drawn.page
            if drawn.cursor_row ≠ null
                cursor_row = drawn.cursor_row
                cursor_col = drawn.cursor_col

    emit StatusBar { width = state.cols, row = state.rows - 1, message = state.message, prompt = state.prompt, buffer = state.file, ai = state.ai_status, voice = state.voice } to this get status
    overlays = overlays + status.overlays
    if state.prompt ≠ null
        cursor_row = state.rows - 1
        cursor_col = status.cursor_col

    if state.prompt ≠ null and state.prompt.kind = "quick_open"
        emit QuickOpenView { prompt = state.prompt, cols = state.cols, height = state.rows } to this get quick
        overlays = overlays + quick.overlays

    if state.picker ≠ null
        emit PickerView { picker = state.picker, rows = state.picker_rows, cols = state.cols, height = state.rows } to this get picked
        overlays = overlays + picked.overlays
        cursor_row = null

    if state.menu ≠ null
        emit Dropdown { open = state.menu, labels = state.keytable.labels } to this get dropdown
        overlays = overlays + dropdown.overlays
        cursor_row = null

    return Screen {
        overlays = overlays
        cursor_row = cursor_row
        cursor_col = cursor_col
        tree_top = tree_top
        tree_page = tree_page
        views = views
        page = page
        chat = chat_drawn
    }
