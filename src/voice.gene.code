| Voice — speaking to the AI chat. Pure: which engine hears, the lines that
| record and hear, what came back, and the words put in the input box.
|
| Ctrl+Shift+Space (ai.voice) records in a hidden terminal (pw-record, a
| 16 kHz mono WAV); the same key stops it (Ctrl+C to it, so the WAV is
| closed whole). Then an engine turns the WAV into words, in a second
| hidden terminal, so the ide never waits on either:
|
|   offline            whisper.cpp's whisper-cli, beside the ide, on this
|                      computer — nothing leaves it; its model is fetched
|                      once, asked first, and sha256-checked
|   openai-compatible  any /v1/audio/transcriptions (OpenAI, LocalAI, a
|                      whisper server); the key goes to curl on its input,
|                      never on a command line
|   mike               Mike's Hear, through the shared Mike service
|                      (mike_bridge.py --hear); needs the IDE signed in
|
| `auto` picks Mike when the IDE is signed in, else the endpoint when one is
| set, else offline: nobody has to sign up for anything to speak.
|
| The words go into the box, not off to the AI: Enter sends them, to
| whichever AI is chosen. Claude Code's and Codex's own voice features live
| inside their own screens and cannot be used from here (see
| docs/tickets/open/004-voice-input.md).

parser = null
texts = null

VoiceUses { json, strings } =>
    parser = json
    texts = strings
    return Using

| The offline models: whisper.cpp's, multilingual, as published on Hugging
| Face (their sha256 checked after the download). Base hears a short
| sentence in about 2 s on a 2014 desktop CPU; small in about 8.
offline_models = {
    "base" = { file = "ggml-base.bin", size = "142 MB", sha256 = "60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe" }
    "small" = { file = "ggml-small.bin", size = "466 MB", sha256 = "1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b" }
}
model_source = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/"

engine_titles = { offline = "offline", "openai-compatible" = "speech server", mike = "Mike" }

| The engine that hears: the one settings name, or for `auto` Mike when the
| IDE is signed in, else the endpoint when one is set, else offline.
VoiceEngine { settings, signed_in } =>
    chosen = settings["ai.voice.provider"]
    if chosen = "auto"
        chosen = "offline"
        if settings["ai.voice.endpoint"] ≠ "", chosen = "openai-compatible"
        if signed_in, chosen = "mike"
    return Engine { name = chosen, title = engine_titles[chosen] }

| The offline model settings name, in `dir`: one of ours (`base`, `small`),
| or a model file of the user's own (a path ending in .bin).
OfflineModelAt { name, dir } =>
    entry = offline_models[name]
    if entry ≠ null, return Model { path = dir + "/" + entry.file, file = entry.file, size = entry.size, sha256 = entry.sha256, url = model_source + entry.file, ours = true }
    return Model { path = name, file = name, size = "", sha256 = "", url = "", ours = false }

name_letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

| Whether `name` can be an environment variable's name: letters, digits
| and _, not first a digit — so it can go into a shell line as "$name".
VariableName { name } =>
    if name ∉ String or name = "", return Is { yes = false }
    emit Length { value = name } to core get { value as size }
    i = 0
    loop
        if i ≥ size, break
        allowed = name_letters
        if i > 0, allowed = allowed + "0123456789"
        emit Length { value = allowed } to core get { value as allowed_size }
        good = false
        j = 0
        loop
            if j ≥ allowed_size or good, break
            if allowed[j] = name[i], good = true
            j += 1
        if not good, return Is { yes = false }
        i += 1
    return Is { yes = true }

| The recorder, stopped by Ctrl+C or after `ai.voice.maxSeconds`, writing
| `wav`; its complaints into `err`.
RecordLine { settings, wav, err } =>
    line = "exec timeout -s INT " + settings["ai.voice.maxSeconds"]
    loop part over settings["ai.voice.recordCommand"]
        emit Quoted { text = part } to this get word
        line = line + " " + word.text
    emit Quoted { text = wav } to this get wav_at
    emit Quoted { text = err } to this get err_at
    return Line { command = "/bin/sh", args = ["-c", line + " " + wav_at.text + " 2> " + err_at.text] }

| What turns `wav` into words with `engine`, its answer written to `out`
| (JSON) and its complaints to `err`. `model` and `whisper` are the offline
| engine's, `bridge` and `account_file` Mike's. Answers `Line { command,
| args }`, or `Problem { text }` when the settings cannot make one.
TranscribeLine { engine, settings, wav, out, err, model, whisper, bridge, account_file } =>
    emit Quoted { text = wav } to this get wav_at
    emit Quoted { text = out } to this get out_at
    emit Quoted { text = err } to this get err_at
    language = settings["ai.voice.language"]
    if engine = "offline"
        heard_language = language
        if heard_language = "", heard_language = "auto"
        emit Quoted { text = whisper } to this get whisper_at
        emit Quoted { text = model } to this get model_at
        emit Quoted { text = heard_language } to this get language_at
        | -of names the output without its .json.
        emit Quoted { text = out[0, length - 5) } to this get base_at
        line = "exec " + whisper_at.text + " -m " + model_at.text + " -f " + wav_at.text + " -l " + language_at.text + " -nt -np -oj -of " + base_at.text
        return Line { command = "/bin/sh", args = ["-c", line + " > /dev/null 2> " + err_at.text] }
    if engine = "openai-compatible"
        endpoint = settings["ai.voice.endpoint"]
        if endpoint = "", return Problem { text = "set ai.voice.endpoint to a speech server (or pick another ai.voice.provider)" }
        loop
            if endpoint[length - 1, length) ≠ "/", break
            endpoint = endpoint[0, length - 1)
        url = endpoint + "/v1/audio/transcriptions"
        if endpoint[length - 3, length) = "/v1", url = endpoint + "/audio/transcriptions"
        key = settings["ai.voice.apiKeyEnv"]
        emit VariableName { name = key } to this get good_key
        if key ≠ "" and not good_key.yes, return Problem { text = "ai.voice.apiKeyEnv must be the name of an environment variable" }
        emit Quoted { text = "file=@" + wav + ";type=audio/wav" } to this get file_at
        emit Quoted { text = "model=" + settings["ai.voice.model"] } to this get model_at
        emit Quoted { text = url } to this get url_at
        line = "exec curl -sS -m 60 -F " + file_at.text + " -F " + model_at.text
        if language ≠ ""
            emit Quoted { text = "language=" + language } to this get language_at
            line = line + " -F " + language_at.text
        | The key on curl's input, never on its command line.
        if key ≠ "", line = "printf 'Authorization: Bearer %s' \"\$" + key + "\" | " + line + " -H @-"
        return Line { command = "/bin/sh", args = ["-c", line + " " + url_at.text + " -o " + out_at.text + " 2> " + err_at.text] }
    if engine = "mike"
        return Line { command = "/usr/bin/python3", args = ["-I", bridge, "--hear", wav, "--result", out, "--account-file", account_file] }
    return Problem { text = "ai.voice.provider is \"auto\", \"offline\", \"openai-compatible\" or \"mike\"" }

| What fetches `model` into its folder: to a .part file first, kept only
| when its sha256 is the published one.
DownloadLine { model, err } =>
    emit Quoted { text = model.path } to this get final_at
    emit Quoted { text = model.path + ".part" } to this get part_at
    emit Quoted { text = model.url } to this get url_at
    emit Quoted { text = model.sha256 + "  " + model.path + ".part" } to this get sum_at
    emit Quoted { text = err } to this get err_at
    emit Split { value = model.path, separator = "/" } to texts get parts
    emit Length { value = parts.value } to core get { value as count }
    emit Join { value = parts.value[0, count - 1), separator = "/" } to texts get dir
    emit Quoted { text = dir.value } to this get dir_at
    fetch = "mkdir -p " + dir_at.text + " && curl -fL --retry 2 -sS -o " + part_at.text + " " + url_at.text + " && echo " + sum_at.text + " | sha256sum -c --quiet - && mv " + part_at.text + " " + final_at.text
    return Line { command = "/bin/sh", args = ["-c", "{ " + fetch + "; } 2> " + err_at.text + "; status=\$?; rm -f " + part_at.text + "; exit \$status"] }

| What `engine` answered (`content`, the text of its JSON): `Heard { text }`
| or `NotHeard { reason }`.
VoiceReply { engine, content } =>
    emit Parse { text = content } to parser get parsed
    if parsed ∈ Exception or parsed.value ∉ Object, return NotHeard { reason = "the answer could not be read" }
    value = parsed.value
    text = ""
    if engine = "offline"
        if value["transcription"] ∉ Array, return NotHeard { reason = "whisper-cli gave no transcription" }
        loop piece over value["transcription"]
            if piece ∈ Object and piece["text"] ∈ String, text = text + piece["text"]
    if engine ≠ "offline"
        if value["error"] ∈ Object and value["error"]["message"] ∈ String, return NotHeard { reason = value["error"]["message"] }
        if value["error"] ∈ String and value["note"] ∈ String, return NotHeard { reason = value["note"] }
        if value["error"] ∈ String, return NotHeard { reason = value["error"] }
        if value["text"] ∉ String, return NotHeard { reason = "the answer had no text" }
        text = value["text"]
    emit Trim { value = text } to texts get trimmed
    if trimmed.value = "", return NotHeard { reason = "no words were heard" }
    return Heard { text = trimmed.value }

| `text` put into the input box at `caret` (null: the end), a space either
| side when it would otherwise run into a word.
InsertSpoken { input, caret, text } =>
    emit Length { value = input } to core get { value as size }
    at = caret
    if at = null or at > size, at = size
    before = input[0, at)
    after = input[at, size)
    words = text
    if before ≠ "" and before[length - 1, length) ≠ " " and before[length - 1, length) ≠ "\n", words = " " + words
    if after ≠ "" and after[0, 1) ≠ " " and after[0, 1) ≠ "\n", words = words + " "
    emit Length { value = words } to core get { value as added }
    return Inserted { input = before + words + after, caret = at + added }
