| Menu — the menu bar and its dropdowns: File, View, Settings, Help. Pure.
|
| An open menu is `{ index, item }`: which menu, which item in it.

menus = [
    {
        title = "File"
        col = 0
        items = [
            { label = "New File…", command = "file.new" }
            { label = "Open Folder…", command = "file.openFolder" }
            { label = "Save", command = "file.save" }
            { label = "Close Editor", command = "file.close" }
            { label = "Exit", command = "app.quit" }
        ]
    }
    {
        title = "View"
        col = 6
        items = [
            { label = "Explorer", command = "view.explorer" }
            { label = "Explorer on the Left", command = "view.explorerLeft" }
            { label = "Explorer on the Right", command = "view.explorerRight" }
            { label = "Terminal", command = "terminal.toggle" }
            { label = "New Terminal", command = "terminal.new" }
            { label = "AI Chat", command = "ai.toggle" }
            { label = "New AI Chat", command = "ai.newChat" }
            { label = "Show AI Changes", command = "ai.showChanges" }
            { label = "Undo AI Changes", command = "ai.undoTurn" }
            { label = "Move Tab…", command = "view.moveTab" }
            { label = "Split Editor", command = "editor.split" }
            { label = "Go Back", command = "nav.back" }
            { label = "Go Forward", command = "nav.forward" }
            { label = "Next Tab", command = "tab.next" }
            { label = "Previous Tab", command = "tab.previous" }
            { label = "Focus Explorer", command = "focus.explorer" }
            { label = "Focus Next", command = "focus.next" }
        ]
    }
    {
        title = "Settings"
        col = 12
        items = [
            { label = "Settings (JSON)", command = "settings.open" }
            { label = "Keyboard Shortcuts (JSON)", command = "keybindings.open" }
            { label = "Keyboard Shortcuts", command = "help.keys" }
            { label = "AI Model…", command = "ai.configure" }
            { label = "AI: Switch Model…", command = "ai.switchModel" }
            { label = "AI: Ask ↔ Edit", command = "ai.toggleMode" }
        ]
    }
    {
        title = "Help"
        col = 22
        items = [
            { label = "Keyboard Shortcuts", command = "help.keys" }
            { label = "About", command = "help.about" }
        ]
    }
]

dropdown_label = 28
dropdown_keys = 16

| A key while a menu is open. Answers the menu after it (null: closed)
| and the command it chose (null: none).
MenuKey { open, name } =>
    index = open.index
    item = open.item
    emit Length { value = menus[index].items } to core get { value as count }
    emit Length { value = menus } to core get { value as menu_count }
    if name = "escape" or name = "f10", return MenuResult { open = null, command = null }
    if name = "alt+f", return MenuResult { open = { index = 0, item = 0 }, command = null }
    if name = "alt+v", return MenuResult { open = { index = 1, item = 0 }, command = null }
    if name = "alt+s", return MenuResult { open = { index = 2, item = 0 }, command = null }
    if name = "alt+h", return MenuResult { open = { index = 3, item = 0 }, command = null }
    if name = "left"
        index = index - 1
        if index < 0, index = menu_count - 1
        return MenuResult { open = { index = index, item = 0 }, command = null }
    if name = "right"
        index += 1
        if index ≥ menu_count, index = 0
        return MenuResult { open = { index = index, item = 0 }, command = null }
    if name = "up"
        item = item - 1
        if item < 0, item = count - 1
        return MenuResult { open = { index = index, item = item }, command = null }
    if name = "down"
        item += 1
        if item ≥ count, item = 0
        return MenuResult { open = { index = index, item = item }, command = null }
    if name = "enter" or name = "space"
        return MenuResult { open = null, command = menus[index].items[item].command }
    return MenuResult { open = open, command = null }

| Row 0: the menus on the left, `title` on the right of the same bar.
MenuBar { width, open, title } =>
    spans = [{ text = " ", style = "menu" }]
    used = 1
    loop i, m over menus
        style = "menu"
        if open ≠ null and open.index = i, style = "menu_active"
        label = " " + m.title + " "
        emit Length { value = label } to core get { value as label_width }
        used += label_width
        spans += { text = label, style = style }
    spans += { text = title + " ", width = width - used, align = "right", style = "title" }
    return Overlays { overlays = [
        { row = 0, col = 0, spans = [{ text = "", width = width, style = "menu" }] }
        { row = 0, col = 0, spans = spans }
    ] }

| The open menu's items, dropped down under its title, each with the key
| that runs it (`labels`, from the key table — so keybindings.json shows).
Dropdown { open, labels } =>
    m = menus[open.index]
    out = []
    loop i, entry over m.items
        style = "menu_item"
        key_style = "menu_key"
        if i = open.item
            style = "menu_item_active"
            key_style = "menu_key_active"
        keys = labels[entry.command]
        if keys = null, keys = ""
        out += { row = 1 + i, col = m.col, spans = [
            { text = "  " + entry.label, width = dropdown_label, style = style }
            { text = keys + "  ", width = dropdown_keys, align = "right", style = key_style }
        ] }
    return Overlays { overlays = out }
