| Provider — which model the AI chat talks to, and how. Pure.
|
| Nothing about a model is built in: settings.json names them —
|
|     "ai.provider": "local",
|     "ai.providers": {
|         "local": { "type": "openai-compatible", "endpoint": "http://localhost:8080",
|                    "model": "", "apiKeyEnv": "", "contextTokens": 32768 }
|     }
|
| `ai.provider` picks one of `ai.providers`. Its `type` says how to talk to
| it:
|
|   openai-compatible  a model over `/v1/chat/completions` (the `localai`
|                      organelle): LocalAI, Ollama, llama.cpp's server,
|                      vLLM, LM Studio, OpenAI's own API. The ide is the
|                      agent: its context, its tools, its approvals.
|   claude-code, codex a coding agent the ide runs — `claude` or `codex`,
|                      headless, on the user's own subscription
|                      (agents.gene.code).
|
| The entries themselves — which exist, their commands, their model lists
| — are settings (settings.gene.code's defaults, merged under the user's),
| never code. What a type can find out for itself (a server's
| `/v1/models`, `codex debug models`, whether it is signed in) the ide
| asks when the model picker opens (ide.gene.code, ProviderCheck).
|
| Another kind of provider is another entry in `types`; nothing else
| changes.
|
| A key is never written in settings.json: `apiKeyEnv` names the
| environment variable that holds it.

types = {
    "openai-compatible" = { runner = "api", organelle = "localai" }
    "claude-code" = { runner = "cli", title = "Claude Code" }
    "codex" = { runner = "cli", title = "Codex" }
}

default_context = 32768
default_reply = 2048

| The provider settings pick, checked. `problem` is "" when it can be
| used, else what to do about it.
ProviderFor { settings } =>
    name = settings["ai.provider"]
    all = settings["ai.providers"]
    given = null
    if all ∈ Object and name ∈ String, given = all[name]
    if given = null or given ∉ Object
        return Provider { name = name, problem = "No AI model is set up: Settings > AI Model… and give \"ai.providers\" an endpoint" }
    kind = given["type"]
    if kind = null, kind = "openai-compatible"
    if types[kind] = null
        return Provider { name = name, problem = "ai.providers." + name + ": no provider type \"" + kind + "\" — use \"openai-compatible\", \"claude-code\" or \"codex\"" }
    model = given["model"]
    if model ∉ String, model = ""
    models = given["models"]
    if models ∉ Array, models = null
    if types[kind].runner = "cli"
        command = given["command"]
        if command ∉ String or command = ""
            command = "claude"
            if kind = "codex", command = "codex"
        return Provider { name = name, type = kind, runner = "cli", title = types[kind].title, command = command, model = model, models = models, context_tokens = 200000, max_tokens = 8000, problem = "" }
    endpoint = given["endpoint"]
    if endpoint = null or endpoint ∉ String or endpoint = ""
        return Provider { name = name, problem = "No AI model is set up: Settings > AI Model… and set ai.providers." + name + ".endpoint (e.g. http://localhost:8080)" }
    key_env = given["apiKeyEnv"]
    if key_env ∉ String, key_env = ""
    context = given["contextTokens"]
    if context ∉ Number or context < 2048, context = default_context
    reply = given["maxTokens"]
    if reply ∉ Number or reply < 256, reply = default_reply
    return Provider {
        name = name
        type = kind
        runner = "api"
        title = name
        models = models
        organelle = types[kind].organelle
        endpoint = endpoint
        model = model
        api_key_env = key_env
        context_tokens = context
        max_tokens = reply
        problem = ""
    }

| The setup particle for `provider`'s organelle, with its key.
ProviderConfig { provider, api_key } =>
    config = Config { endpoint = provider.endpoint, max_tokens = provider.max_tokens, temperature = 0.2, timeout_seconds = 900 }
    if provider.model ≠ "", config = config + { model = provider.model }
    if api_key ≠ "", config = config + { api_key = api_key }
    return Particle { particle = config, key = provider.type + " " + provider.endpoint + " " + provider.model + " " + api_key }

| One turn of the conversation, asked of `provider`'s organelle: answered
| at once with `Sent { value }`, the reply arriving later as a
| `ChatResult { content, _request_id }` (or an `Exception`).
ProviderChat { provider, messages } =>
    return Particle { particle = Chat { messages = messages, later = true } }
