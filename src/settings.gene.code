| Settings — the user's preferences, as VS Code keeps them: a JSON file,
| `settings.json`, that the ide reads at start, writes when a preference
| changes (Ctrl+B, moving the explorer, resizing a side), and opens for
| editing (Ctrl+, or File > Settings). Pure: text in, checked values out.
|
| A value that is missing or not what it should be falls back to its
| default, and says so — a typo in the file never stops the ide.

defaults = {
    "workbench.sideBar.visible" = true
    "workbench.sideBar.location" = "left"
    "workbench.layout.left" = 30
    "workbench.layout.right" = 40
    "workbench.layout.top" = 10
    "workbench.layout.bottom" = 12
    "terminal.integrated.shell" = ""
    "ai.provider" = "local"
    "ai.providers" = {
        local = { type = "openai-compatible", endpoint = "", model = "", apiKeyEnv = "", contextTokens = 32768 }
        | Claude Code cannot list its models or efforts: these are the names
        | its --model and --effort take, a model by its full, versioned id
        | (so two versions of one can sit side by side) and shown by `name`.
        | Edit them here; "" is its own default. Codex reports both itself.
        claude = {
            type = "claude-code"
            command = "claude"
            model = ""
            models = [
                { id = "claude-opus-5-5", name = "Opus 5.5" }
                { id = "claude-opus-5", name = "Opus 5" }
                { id = "claude-sonnet-5", name = "Sonnet 5" }
                { id = "claude-haiku-4-5-20251001", name = "Haiku 4.5" }
                { id = "claude-fable-5-1", name = "Fable 5.1" }
                { id = "claude-fable-5", name = "Fable 5" }
            ]
            effort = ""
            efforts = ["low", "medium", "high", "xhigh", "max"]
        }
        codex = { type = "codex", command = "codex", model = "", effort = "" }
    }
    "ai.chat.location" = "r"
    "ai.maxSteps" = 12
    "ai.agent.mode" = "ask"
    | What Alt+G carries a plan out in: "edit" or "auto".
    "ai.agent.planFollowup" = "edit"
    "ai.agent.allowCommands" = []
    "terminal.integrated.commandsToSkipShell" = [
        "terminal.toggle"
        "focus.next"
        "tab.next"
        "menu.file"
        "menu.view"
        "menu.settings"
        "menu.help"
        "app.quit"
        "focus.editor"
        "focus.group2"
    ]
}

slots = { tl = true, t = true, tr = true, l = true, c = true, r = true, bl = true, b = true, br = true }

| The side track sizes, each at least `least`.
sizes = [
    { key = "workbench.layout.left", least = 10, old = "workbench.sideBar.width" }
    { key = "workbench.layout.right", least = 10, old = "" }
    { key = "workbench.layout.top", least = 3, old = "" }
    { key = "workbench.layout.bottom", least = 3, old = "workbench.panel.height" }
]

| The `json` organelle, handed over when the ide links it.
parser = null

SettingsUses { json } =>
    parser = json
    return Using

| `text` (the file, or null when there is none) as settings. Answers
| `Prefs { values, problem }`: every setting with a good value, and what
| was wrong, if anything (`""` when nothing was).
ReadSettings { text } =>
    if text = null, return Prefs { values = defaults, problem = "" }
    emit Parse { text = text } to parser get parsed
    if parsed ∈ Exception
        return Prefs { values = defaults, problem = "settings.json is not valid JSON — using the defaults" }
    given = parsed.value
    if given ∉ Object
        return Prefs { values = defaults, problem = "settings.json should be an object — using the defaults" }
    values = defaults
    wrong = []
    visible = given["workbench.sideBar.visible"]
    if visible ∈ Boolean, values = values + { "workbench.sideBar.visible" = visible }
    if visible ≠ null and visible ∉ Boolean, wrong += "workbench.sideBar.visible (true or false)"
    location = given["workbench.sideBar.location"]
    if location = "left" or location = "right", values = values + { "workbench.sideBar.location" = location }
    if location ≠ null and location ≠ "left" and location ≠ "right", wrong += "workbench.sideBar.location (\"left\" or \"right\")"
    | Sizes; the names before 0.6 are still read when the new one is absent.
    loop track over sizes
        size = given[track.key]
        if size = null and track.old ≠ "", size = given[track.old]
        good = size ∈ Number
        if good, good = size ≥ track.least
        if good, values = values + { "$track.key" = size }
        if size ≠ null and not good, wrong += track.key + " (" + track.least + " or more)"
    shell = given["terminal.integrated.shell"]
    if shell ∈ String, values = values + { "terminal.integrated.shell" = shell }
    if shell ≠ null and shell ∉ String, wrong += "terminal.integrated.shell (a program's path)"
    skips = given["terminal.integrated.commandsToSkipShell"]
    good_skips = skips ∈ Array
    if good_skips
        loop one over skips
            if one ∉ String, good_skips = false
    if good_skips, values = values + { "terminal.integrated.commandsToSkipShell" = skips }
    if skips ≠ null and not good_skips, wrong += "terminal.integrated.commandsToSkipShell (a list of command ids)"
    | The AI chat (see llm.gene.code).
    provider = given["ai.provider"]
    if provider ∈ String and provider ≠ "", values = values + { "ai.provider" = provider }
    if provider ≠ null and (provider ∉ String or provider = ""), wrong += "ai.provider (a name from ai.providers)"
    providers = given["ai.providers"]
    good_providers = providers ∈ Object
    if good_providers
        loop key, one over providers
            if one ∉ Object, good_providers = false
    | The user's entries over the defaults, field by field: an entry they
    | name keeps the default's fields they leave out (claude's lists of
    | models and efforts), and the entries they do not name stay to pick.
    | A claude entry still carrying the first default list (bare aliases,
    | written out by 0.10) takes the versioned one.
    if good_providers and providers["claude"] ∈ Object and providers["claude"]["models"] = ["fable", "opus", "sonnet"]
        providers = providers + { claude = providers["claude"] + { models = defaults["ai.providers"]["claude"]["models"] } }
    if good_providers
        merged = defaults["ai.providers"]
        loop key, entry over providers
            if merged[key] ≠ null, merged = merged + { "$key" = merged[key] + entry }
            if merged[key] = null, merged = merged + { "$key" = entry }
        values = values + { "ai.providers" = merged }
    if providers ≠ null and not good_providers, wrong += "ai.providers (an object of { \"type\", \"endpoint\", \"model\" … })"
    chat_at = given["ai.chat.location"]
    if chat_at ∈ String and slots[chat_at] = true, values = values + { "ai.chat.location" = chat_at }
    if chat_at ≠ null and not (chat_at ∈ String and slots[chat_at] = true), wrong += "ai.chat.location (l r t b c tl tr bl br)"
    steps = given["ai.maxSteps"]
    good_steps = steps ∈ Number
    if good_steps, good_steps = steps ≥ 1 and steps ≤ 50
    if good_steps, values = values + { "ai.maxSteps" = steps }
    if steps ≠ null and not good_steps, wrong += "ai.maxSteps (1 to 50)"
    agent_mode = given["ai.agent.mode"]
    known_modes = { ask = true, plan = true, edit = true, auto = true }
    good_mode = agent_mode ∈ String
    if good_mode, good_mode = known_modes[agent_mode] = true
    if good_mode, values = values + { "ai.agent.mode" = agent_mode }
    if agent_mode ≠ null and not good_mode, wrong += "ai.agent.mode (\"ask\", \"plan\", \"edit\" or \"auto\")"
    followup = given["ai.agent.planFollowup"]
    if followup = "edit" or followup = "auto", values = values + { "ai.agent.planFollowup" = followup }
    if followup ≠ null and followup ≠ "edit" and followup ≠ "auto", wrong += "ai.agent.planFollowup (\"edit\" or \"auto\")"
    allow = given["ai.agent.allowCommands"]
    good_allow = allow ∈ Array
    if good_allow
        loop one over allow
            if one ∉ String, good_allow = false
    if good_allow, values = values + { "ai.agent.allowCommands" = allow }
    if allow ≠ null and not good_allow, wrong += "ai.agent.allowCommands (a list, e.g. [\"Bash(cargo test:*)\"])"
    problem = ""
    loop i, what over wrong
        if i = 0, problem = "settings.json: using the default for " + what
        if i > 0, problem = problem + ", " + what
    return Prefs { values = values, problem = problem }

| `values` as the text of settings.json.
WriteSettings { values } =>
    emit Stringify { value = values, pretty = true } to parser get text
    return SettingsText { text = text.value + "\n" }
